Items:{
	ShimmerBucket:{
		DisplayName: シマー入りバケツ
		Tooltip:
			'''
			シマーが少し入っている
			注ぐことができる
			'''
	}

	ShimmerBomb:{
		DisplayName: シマー爆弾
		Tooltip: シマーをまき散らす小さな爆発を起こす
	}

	ShimmerRocket:{
		DisplayName: ロケット弾(シマー)
		Tooltip: 当たるとシマーが飛び散る
	}

	BottledShimmer:{
		DisplayName: 瓶詰めのシマー
		Tooltip: ランダムなデバフを一つ解除する
	}

	ShimmerSwimmingPotion:{
		DisplayName: シマー遊泳ポーション
		Tooltip: シマーに入ってもシマー中を受けない
	}

	ShimmerAbsorbantSponge:{
		DisplayName: シマー吸収スポンジ
		Tooltip: 無限にシマーを吸収できる
	}
}

Projectiles:{
	ShimmerBomb:{
		DisplayName: シマー爆弾
	}

	ShimmerGrenade:{
		DisplayName: シマーのグレネード
	}

	ShimmerMine:{
		DisplayName: シマーの地雷
	}

	ShimmerRocket:{
		DisplayName: シマーのロケット
	}

	ShimmerSnowmanRocket:{
		DisplayName: シマーのスノーマンロケット
	}
}

Buffs:{
	ShimmerShock:{
		DisplayName: シマーショック
		Description: 瓶詰めのシマーを使えない
	}

	ShimmerSwimming:{
		DisplayName: シマー遊泳
		Description: シマーに入ってもシマー中を受けない
	}
}

Configs:{
	ShimmerItemsServerConfig:{
		DisplayName:Shimmer アイテム設定
	}

	ServerConfig:{
		ShimmerTransformation_Bucket_Tooltip:
			'''
			オンにすると、ムーンロードを倒した後、
			蜂蜜入りバケツをシマーに投げ入れるとシマー入りバケツに変化するようになります
			デフォルトはオン
			'''
		ShimmerTransformation_Bucket_Label: シマーのバケツ変化サイクルを変更

		ContentToggle_ShimmerAbsorbantSponge_Tooltip:
			'''
			オンにすると
			- シマー吸収スポンジが入手できるようになります
			- 超吸収スポンジがシマーを吸収できなくなります
			- 万能吸収スポンジの素材と効果にシマー吸収スポンジが追加されます
			デフォルトでオン
			'''
		ContentToggle_ShimmerAbsorbantSponge_Label: シマー吸収スポンジを有効にする
	}
}
