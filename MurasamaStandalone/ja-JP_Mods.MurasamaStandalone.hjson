UI: {
	TrialQuestHUD: {
		HeaderTitle: 試練の進行状況
		ButtonTooltip:
			'''
			[c/e12834:ムラサマ試練クエストHUD]
			クリックで試練の進行状況HUDを切り替え
			'''
		ButtonTooltipDrag: (左クリック長押しでドラッグ)
		TrialProgress: 試練の進行状況：
		AllTrialsCompleted: ✓ すべての試練を完了
		NextTrial: 次の試練：
		ActiveStatus: " [進行中]"
		TargetStatus: ▶ 目標
		LockedStatus: 未解放
		Progression: 進行状況
		AllTrialsComplete: 100%（すべての試練を完了）
		MilestoneKuuenzan: "[ 空円斬 ]"
		MilestoneRisingDragon: "[ バットウジュツ ]"
		MilestoneGroundSmash: "[ 下降斬り ]"
		MilestoneDimensionalExecution: "[ 次元斬 ]"
		ProgressionModeBtnOn: 進行モード：ON（今後のボスを非表示）
		ProgressionModeBtnOff: 進行モード：OFF（すべてのボスを表示）
		ProgressionModeToggleHint: クリックで切り替え
		PromptTitle: 試練の表示モード
		PromptSubtitle: 試練の進行状況の表示方法を選択
		PromptProgModeTitle: 進行モード（ネタバレ防止）
		PromptProgModeDesc:
			'''
			今後登場するボスの名前とアイコンを非表示にする。完了した試練と現在の目標のみ表示される。
			ネタバレを避けて進めたい場合におすすめ。
			'''
		PromptFullViewTitle: 全表示（すべて表示）
		PromptFullViewDesc:
			'''
			最初から最後まで、すべてのボスと試練を表示する。
			ボス戦や進行ルートを事前に計画したい場合におすすめ。
			'''
		PromptNote: HUD上部の切り替えボタンからいつでも変更可能
		PromptSelectBtn: 選択
		NextUnlockKuuenzan: 空円斬（レベル1で解放）
		NextUnlockRisingDragon: バットウジュツ（レベル{0}で解放）
		NextUnlockGroundSmash: 下降斬り（レベル{0}で解放）
		NextUnlockDimensionalExecution: 次元斬（レベル{0}で解放）
		NextUnlockAll: すべてのスキルを解放済み！
	}

	ModernTooltip: {
		Desc1: 右クリックを長押しするか、左クリックの攻撃が命中すると、刀のエネルギーがチャージされる
		Desc2: 近くに強大な敵がいる場合、刀のエネルギーが自然にゆっくりとチャージされる
		Desc3: 試練を乗り越えると強化される
		Quote: "[c/ff4500:「これがチェーンソーだったらもっとよかったんだが」]"
		RisingDragonTitle: "[ バットウジュツ ]"
		RisingDragonDesc:
			'''
			エネルギーが最大蓄積状態で[c/ffaf50:'{0}']を押すと刀身を放つ
			射出中[c/ffaf50:{1}]で[c/cd2432:刀の元へ飛び]
			その後に右クリックを押すと[c/cd2432:斬撃]を繰り出す
			この[c/cd2432:斬撃]を敵に当てると、必殺技ゲージが蓄積する
			'''
		KuuenzanTitle: "[ 空円斬 ]"
		KuuenzanDesc:
			'''
			空中で[c/ffaf50:'{0}']を押すとエネルギーを1/2消費し、
			[c/ffaf50:投射物]を[c/ffaf50:弾き返しながら]空円斬を放つ
			弾き返しに成功すると追加でエネルギーを消費する
			'''
		KuuenzanUpgrade1: + 空円斬の突進と斬撃の速度が上昇
		KuuenzanUpgrade2:
			'''
			+ 空円斬の突進と斬撃の速度が上昇し、
			下降斬りへ繋ぐと衝撃が25%増加する
			'''
		GroundSmashTitle: "[ 下降斬り ]"
		GroundSmashDesc:
			'''
			[c/ffaf50:'{0}']を押すと必殺技ゲージを1消費し、
			下方向へ斬り下ろす
			'''
		DimensionalExecutionTitle: "[ 次元斬 ]"
		DimensionalExecutionDesc:
			'''
			必殺技ゲージが10に達した状態で、
			[c/cd2432:バットウジュツ]の[c/cd2432:斬撃]を当てると次元斬が発動する
			'''
		StatusLocked: "[ 未解放 ]"
		StatusAirborne: 空中時のみ
		KeyPrefixKey: キー
		KeyPrefixButton: ボタン
		AttackBtnClick: 左クリック
	}
}

Items: {
	MurasamaItem: {
		DisplayName: ムラサマ
		Tooltip:
			'''
			右クリックを長押しするか、左クリックの攻撃が命中すると、刀のエネルギーがチャージされる
			近くに強大な敵がいる場合、刀のエネルギーが自然にゆっくりとチャージされる
			空中で[KEY3]を押すと刀のチャージを1/2消費し、投射物を弾く空円斬を発動する [LangKuuenzan]
			刀のエネルギーが満タンの時に[KEY1]を押すと刃が射出され、
			刃の射出中に左クリックをすると刀の元へ飛び、斬撃を繰り出すことができる [Lang1]
			この斬撃が敵に命中すると必殺技ゲージがチャージされる
			[KEY2]で必殺技ゲージを1消費し、下降斬りを発動する [Lang2]
			必殺技ゲージが最大値の10の時に、バットウジュツの斬撃が敵に命中すると必殺技が発動する [Lang3]
			[c/ff4500:「これがチェーンソーだったらもっとよかったんだが」]
			[Lang4]
			'''
	}
}

Legend: {
	World_Text0: 以前強化されたワールド：<{0}> | レベル：<{1}>
	Text0: 解放済み
	Text1: ロック中（試練レベル{0}が必要）
	TextKingSlime: ロック中（試練レベル1が必要）
	Text_Lang_0: 試練：
	KuuenzanUpgrade1: + 空円斬の斬撃速度が上昇する
	KuuenzanUpgrade2: + 空円斬の突進と斬撃速度が上昇し、下降斬りへ繋げると衝撃が25%強化される
	NotifyUnlockKuuenzan: 空円斬が解放される
	NotifyUnlockSkill1: バットウジュツが解放され、空円斬が強化される
	NotifyUnlockSkill2: 下降斬りが解放され、空円斬が強化される
	NotifyUnlockSkill3: 次元斬が解放される
	CombatTextUnlocked: Unlocked {0}!
}

