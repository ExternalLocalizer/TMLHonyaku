Common.Notbound: "[未割り当てキー]"

Configs: {
	MuraSkinConfig: {
		DisplayName: Murasama：カラーカスタマイズ
		Headers.SkinSettings: カラー＆エフェクト設定

		SkinTheme: {
			Label: カラー
			Tooltip: ""
		}

		SkinPreview: {
			Label: カラープレビュー
			Tooltip: 現在選択中のカラーによる刀身の発光、斬撃エフェクト、カラースウォッチをリアルタイムで確認できます
		}

		SkinSubtitle: {
			Default: ジェットストリーム・サム：赤色の高周波ブレード
			Vergil: バージル：蒼い閻魔刀＆バージルボイス
			Audrey: コーラルピンク＆ピーチゴールド
			AstralViolet: ダークバイオレット＆エレクトリックパープル
			Angel: アイボリー＆ワインレッド
			Amber: アンバーオレンジ＆ルビーレッド
			Aqua: アクアマリン＆クリスタルシアン
			Pinky: ネオンピンク＆桜ピンク
			Rainbow: RGBレインボー
			ExoPrism: フォトンプリズム＆ゴールド
			LavenderGold: パステルラベンダー＆ゴールド
			CyberNeon: ネオンマゼンタ＆エレクトリックシアン
			Symphony: サファイアブルー＆スカイブルー
			MagmaCoral: コーラルレッド＆ホワイト
			SolarCorona: サンイエロー＆オレンジ
			VoidObsidian: ブラック＆ダークグレー
			Platinum: プラチナホワイト＆シルバー
			EmeraldJade: エメラルドグリーン＆ミントグリーン
			FrozenSnow: アイスブルー＆ホワイト
		}
	}

	MuraConfig: {
		DisplayName: ムラサマ設定

		Headers: {
			UI: UIカスタマイズ
			HUDWidget: インベントリ画面表示
			Graphic: グラフィック
			Progression: 進捗状況
		}

		TooltipStyle: {
			Label: ツールチップ表示形式
			Tooltip:
				'''
				Modern: Split Mod風の横に独立表示されるスキルカード形式
				Classic: 元の1列表示による詳細説明形式
				'''
		}

		MuraUIStyleType: {
			Label: チャージUI表示形式
			Tooltip:
				'''
				刀の構えとチャージゲージの表示デザインを設定：
				1: Delicacy Overhead（プレイヤー頭上）
				2: Delicacy Compact（HUD端）
				3: Classical Overhead（レトロなドット絵UIをプレイヤー頭上に表示）
				4: Classical Compact（レトロなドット絵UIをHUD隅に表示）
				5: 非表示（UIを完全に隠す）
				'''
		}

		MuraPosStyleType: {
			Label: チャージUI HUD位置
			Tooltip:
				'''
				コンパクト表示時のチャージUI位置を調整：
				1: 右下（デフォルト）
				2: 左下
				3: 上部中央
				'''
		}

		ShowMaxLevelMuraBadge: {
			Label: 最大レベル時にジェットストリーム・サムのバッジを表示
			Tooltip: 武器が最大試練レベルに到達した時、構えゲージ上部にジェットストリーム・サムの紋章バッジを表示する
		}

		ShowUnlockNotifications: {
			Label: スキル解放通知
			Tooltip: Murasamaのレベル上昇や新しいスキル解放時に、ゲーム内チャットと戦闘テキストで通知を表示する
		}

		MurasamaSpaceFragmentationBool: {
			Label: 空間断裂エフェクト
			Tooltip: 強力な斬撃や次元斬発動時に、画面破砕型の空間断裂シェーダー効果を有効化する
		}

		LensEasing: {
			Label: 動的カメラレンズ補間
			Tooltip: トリガーダッシュや次元斬発動時に、滑らかなカメラ追従と映画的な焦点移動を有効化する
		}

		LockWidgetPosition: {
			Label: 試練ウィジェットの位置を固定
			Tooltip: ムラサマ試練クエストのウィジェットボタンの位置を固定する。無効にするとマウスでウィジェットを移動できる
		}

		WidgetPositionX: {
			Label: ウィジェット位置 X
			Tooltip: ウィジェットボタンのX座標を指定する。ロック解除時に適用される
		}

		WidgetPositionY: {
			Label: ウィジェット位置 Y
			Tooltip: ウィジェットボタンのY座標を指定する。ロック解除時に適用される
		}

		ProgressionMode: {
			Label: 進行モード
			Tooltip: 試練に到達するまで今後登場するボスの名前とアイコンを非表示にする
		}

		ReducedVFX: {
			Label: 軽量VFXモード
			Tooltip: 武器アニメーションは維持したまま、パーティクルの光や衝撃粉塵、視覚エフェクトの密度を適度に減らし、フレームレートを安定させる
		}
	}

