Config: {
	DisplayName: 設定

	Headers: {
		ImprovedAccessories: アクセサリーの改良
		ImprovedMounts: マウントの改良
		ImprovedMinecarts: トロッコの改良
		ImprovedPets: ペットの改良
		ImprovedGrapplingHooks: フックの改良
		AccessorySlots: アクセサリスロット
		StatTooltips: ツールチップに性能を表示
		Obtainability: 入手性の変更
	}

	// Improved Accessories
	ImprovedTerrasparkBoots: {
		Label: "[i:TerrasparkBoots] テラスパークブーツを改良する"
		Tooltip:
			'''
			オンにするとテラスパークブーツの効果とレシピに、
			[i:AmphibianBoots] 両生類のブーツを追加します
			'''
	}

	ImprovedAnkhShield: {
		Label: "[i:AnkhShield] 聖十字の盾を改良する"
		Tooltip:
			'''
			オンにすると聖十字の盾の効果とレシピに、
			[i:HeroShield] 英雄の盾と[i:FrozenShield] 氷結の盾を、
			聖十字のお守りに[i:HandWarmer] あったか手袋を追加し、
			聖十字の盾の防御力が12に増加します
			'''
	}

	ImprovedHorseshoeBundle: {
		Label: "[i:HorseshoeBundle] 風船の束を改良する"
		Tooltip:
			'''
			オンにすると風船の束の効果とレシピに、
			[i:SharkronBalloon] シャークロンの風船と[i:FartInABalloon] おなら入り風船を追加します
			'''
	}

	ImprovedHandOfCreation: {
		Label: "[i:HandOfCreation] 創造の手を改良する"
		Tooltip:
			'''
			オンにすると創造の手の効果とレシピに、
			[i:Toolbox] ツールベルトと[i:Toolbelt] ツールボックスを追加します
			'''
	}

	ImprovedPDA: {
		Label: "[i:PDA] PDAの改良"
		Tooltip: ""
	}

	// Improved Mounts
	
	// Improved Minecarts
	
	// Improved Pets
	
	// Improved Grappling Hooks
	
	// Accessory Slots
	SlotMoonlord: {
		Label: "[i:BossMaskMoonlord] MLを撃破後、アクセサリスロットを追加する"
		Tooltip: ムーンロードを倒すと、アクセサリスロットが追加されるか変更します
	}

	SlotWings: {
		Label: "[i:WingsSolar] 翼のスロットを追加する"
		Tooltip: オンにすると翼のみ装備できるスロットを追加します
	}

	SlotShield: {
		Label: "[i:AnkhShield] 盾のスロットを追加する"
		Tooltip: オンにすると盾のみ装備できるスロットを追加します
	}

	SlotBoots: {
		Label: "[i:TerrasparkBoots] ブーツのスロットを追加する"
		Tooltip: オンにするとブーツのみ装備できるスロットを追加します
	}

	SlotForceWings: {
		Label: "[i:CreativeWings] 翼は専用スロットにのみ装備できる"
		Tooltip: オンにすると翼は専用のスロットにのみ装備できます
	}

	SlotForceShields: {
		Label: "[i:ObsidianShield] 盾は専用スロットにのみ装備できる"
		Tooltip: オンにすると盾は専用のスロットにのみ装備できます
	}

	SlotForceBoots: {
		Label: "[i:HermesBoots] ブーツは専用スロットにのみ装備できる"
		Tooltip: オンにするとブーツは専用のスロットにのみ装備できます
	}

	// Stat Tooltips
	StatsWings: {
		Label: "[i:WingsSolar] 翼の性能を表示する"
		Tooltip: オンにすると翼の性能を表示します
	}

	StatsHooks: {
		Label: "[i:LunarHook] フックの性能を表示する"
		Tooltip: オンにするとフックの性能を表示します
	}

	StatsLightPets: {
		Label: "[i:SuspiciousLookingTentacle] 光源ペットの性能を表示する"
		Tooltip: オンにすると光源ペットの性能を表示します
	}

	StatsMinecarts: {
		Label: "[i:MeowmereMinecart] トロッコの性能を表示する"
		Tooltip: オンにするとトロッコの性能を表示します
	}

	StatsMounts: {
		Label: "[i:DrillContainmentUnit] マウントの性能を表示する"
		Tooltip: オンにするとマウントの性能を表示します
	}

	// Obtainability
	ObtainabilityRecipes: {
		Label: "[i:HermesBoots] アクセサリのレシピを追加する"
		Tooltip:
			'''
			オンにするとアクセサリのレシピを色々追加します
			説明するのは面倒なのでRecipe Browser Modを使って探してみてください
			'''
	}

	ObtainabilityShimmer: {
		Label: "[i:BottomlessShimmerBucket] シマーで変化させれるアクセサリを増やす"
		Tooltip:
			'''
			オンにすると、以下のアクセサリをシマーで変化させることができるようになります
			[i:BrickLayer] レンガ設置機・[i:ExtendoGrip] 拡張グリップ・[i:PaintSprayer] ペイントスプレー・[i:PortableCementMixer] 携帯コンクリートミキサー
			[i:Stopwatch] ストップウォッチ・[i:LifeformAnalyzer] 生命体分析器・[i:DPSMeter] DPS測定器
			[i:ShinyRedBalloon] 輝く赤い風船と[i:BalloonPufferfish] フグの風船
			[i:PutridScent] 腐臭の袋と[i:FleshKnuckles] 肉のナックル
			[i:BandofStarpower] 星の腕輪と[i:PanicNecklace] パニックネックレス 
			[i:WormScarf] ワームのスカーフと[i:BrainOfConfusion] 混乱の脳みそ
			'''
	}

	ObtainabilityNPCDrops: {
		Label: "[i:ArmorPolish] 聖十字のお守りの素材を入手しやすくする"
		Tooltip: オンにすると、敵が[i:AnkhCharm] 聖十字のお守りの素材のアクセサリをドロップする確率が3倍になります
	}

	ObtainabilityTravellingMerchant: {
		Label: "[i:PeddlersHat] 旅商人がアクセサリを必ず販売する"
		Tooltip: オンにすると、旅商人にアクセサリの販売枠が追加されます
	}

	ObtainabilityPresents: {
		Label: "[i:Present] プレゼントからアクセサリを取り除く"
		Tooltip:
			'''
			オンにすると、プレゼントから[i:HandWarmer] あったか手袋と、
			[i:Toolbox] ツールボックスを入手できなくなる代わりに、
			あったか手袋のレシピが追加され、
			メカニックからツールボックスを買えるようになります
			'''
	}
}

PDAConfig: {
	Tooltip: ""

	Headers: {
		MetalDetector: "[i:MetalDetector] 金属探知機"
		Radar: "[i:Radar] レーダー"
		LifeformAnalyzer: "[i:LifeformAnalyzer] 生命体分析器"
	}

	// Radar
	RadarHighlightEnemies: {
		Label: 敵のハイライト表示
		Tooltip:
			'''
			オンにすると、[i:Radar] レーダーが敵を、
			[i:HunterPotion] 狩人のポーションのようにハイライト表示するようになります
			'''
	}

	RadarHighlightDanger: {
		Label: 罠のハイライト表示
		Tooltip:
			'''
			オンにすると、[i:Radar] レーダーが罠を、
			[i:TrapsightPotion] 危険察知ポーションのようにハイライト表示するようになります
			'''
	}

	// Metal detector
	MetalDetectorDistanceInfo: {
		Label: 距離の表示
		Tooltip: オンにすると、[i:MetalDetector] 金属探知機が距離を表示するようになります
	}

	MetalDetectorArrows: {
		Label: 宝物の方向を矢印で表示
		Tooltip: オンにすると、[i:MetalDetector] 金属探知機が近くの宝物の方向を矢印で表示するようになります
	}

	MetalDetectorHighlight: {
		Label: 宝物のハイライト表示
		Tooltip: オンにすると、[i:MetalDetector] 金属探知機が宝物をハイライト表示するようになります
	}

	TrackGems: {
		Label: 宝石の探知
		Tooltip: オンにすると、[i:MetalDetector] 金属探知機が宝石を探知するようになります
	}

	TrackHellstone: {
		Label: ヘルストーンの探知
		Tooltip: オンにすると、[i:MetalDetector] 金属探知機がヘルストーンを探知するようになります
	}

	// Lifeform analyzer
	LifeformAnalyzerDistanceInfo: {
		Label: 距離の表示
		Tooltip: オンにすると、[i:LifeformAnalyzer] 生命体分析器が距離を表示するようになります
	}

	LifeformAnalyzerArrows: {
		Label: 珍しい生き物の方向を矢印で表示
		Tooltip: オンにすると、[i:LifeformAnalyzer] 生命体分析器が珍しい生き物の方向を矢印で表示するようになります
	}

	LifeformAnalyzerHighlight: {
		Label: 珍しい生き物のハイライト表示
		Tooltip: オンにすると、[i:LifeformAnalyzer] 生命体分析器が珍しい生き物をハイライト表示するようになります
	}

	UseNPCWhitelist: {
		Label: NPCのホワイトリストを使用する
		Tooltip: "[i:LifeformAnalyzer] 生命体分析器のホワイトリストを使用するかどうか変更します"
	}

	UseNPCBlacklist: {
		Label: NPCのブラックリストを使用する
		Tooltip: "[i:LifeformAnalyzer] 生命体分析器のブラックリストを使用するかどうか変更します"
	}

	NPCWhitelist: {
		Label:NPCのホワイトリスト
		Tooltip: このリストに入っている生き物は[i:LifeformAnalyzer] 生命体分析器が探知するようになります
	}

	NPCBlacklist: {
		Label: NPCのブラックリスト
		Tooltip: このリストに入っている生き物は[i:LifeformAnalyzer] 生命体分析器が探知しなくなります
	}
}
