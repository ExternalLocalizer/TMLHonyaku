Configs: {
	ReworkConfig: {
		DisplayName: リワーク設定

		twins: {
			Label: "[i/s1:544] ツインズリワーク"
			Tooltip:
				'''
				ツインズのリワークを有効にします。他のModと競合する場合はオフにしてください
				Eternity ModeおよびRevengeance Modeと互換性があり、これらがオンの場合はオフにする必要はありません
				（注：攻撃パターンは上書きではなく、組み合わせられます！）
				'''
		}

		destroyer: {
			Label: "[i/s1:556] デストロイヤーリワーク"
			Tooltip:
				'''
				デストロイヤーのリワークを有効にします。他のModと競合する場合はオフにしてください
				Eternity ModeおよびRevengeance Modeと互換性があり、これらがオンの場合はオフにする必要はありません
				（注：攻撃パターンは上書きではなく、組み合わせられます！）
				'''
		}

		prime: {
			Label: "[i/s1:557] スケルトロンプライムリワーク"
			Tooltip:
				'''
				スケルトロンプライムのリワークを有効にします。他のModと競合する場合はオフにしてください
				Eternity ModeおよびRevengeance Modeと互換性があり、これらがオンの場合はオフにする必要はありません
				（注：攻撃パターンは上書きではなく、組み合わせられます！）
				'''
		}

		oldAI: {
			Label: 旧AIリワーク
			Tooltip:
				'''
				ボスのリワークの旧バージョンを使用します
				デストロイヤーのみ旧AIがあります
				'''
		}

		Death: {
			Label: 撃破アニメーション
			Tooltip: 撃破アニメーションを有効にします
		}

		masterDropsAreNonExclusive: {
			Label: マスターモード限定武器をエキスパートでもドロップ
			Tooltip:
				'''
				マスターモード専用の武器がエキスパートモードでもドロップします
				マスターモードをプレイしたくない場合や、他のModでマスターモードのドロップに問題が生じる場合に推奨します
				（例：Eternity Modeがmasochist modeになる、infernumがマスターモードで使用できない）
				'''
		}

		dayMechs: {
			Label: "[i/s1:3064] メカボスが昼間に戦える"
			Tooltip: メカボスが昼間にも戦えるようになります！
		}

		unlimitedMechs: {
			Label: 無制限メカ召喚
			Tooltip: すべてのメカボス召喚アイテムが無制限に使用できます！
		}

		MechSpawnRework: {
			Label: メカニカルボスの自然出現リワーク
			Tooltip: メカニカルボスの自然出現のリワークを有効にします
		}

		MechSpawnDelay: {
			Label: メカニカルボスの自然出現遅延
			Tooltip: 襲来を知らせるメッセージが表示されてから、メカニカルボスの自然出現が試みられるまでの待機時間を設定します（ティック単位）
