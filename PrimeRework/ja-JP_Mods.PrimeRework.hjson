	DoubleTrouble: {
		DisplayName: ダブルトラブル
		Tooltip:
			'''
			プレイヤーの周りで振り回せるスパズマティズムまたはレティネイザーを召喚する
			レティネイザーはレーザーを撃ち、スパズマティズムは呪われた炎を撃つ
			鞭としてカウントされますが、鞭の射程ボーナスの影響を受けない
			'''
	}

	EnergyHilt: {
		DisplayName: エナジーヒルト
		Tooltip:
			'''
			近接攻撃は敵の防御を10無視
			フェーズセーバーは短距離の光の波を撃ち出す
			'''
	}

	Exitium: {
		DisplayName: エクスィティウム
		Tooltip:
			'''
			雷とミサイルを撃つ槍を振る
			ミサイルはカーソルに最も近い敵をターゲットする
			右クリックでミサイルを早めに爆発させる
			メインの槍はタイルを通り抜けて敵を攻撃可能
			「索敵と破壊」
			'''
	}

	EyeRemote: {
		DisplayName: リモートめだま
		Tooltip:
			'''
			ツインズを召喚する
			「これはひどい夜になりそうだ...」
			'''
	}

	Finis: {
		DisplayName: フィニス
		Tooltip:
			'''
			2回振るごとに1回投擲
			ユーザーの周りを回転するボルトを生成する
			攻撃中に<right>を押し続けると、鎌が最も近い敵に自動でホーミングする
			投擲中の鎌で何かに命中すると、蓄積されたボルトが命中した敵にホーミングする
			'''
	}

	FlinxForceWalkieTalkie: {
		DisplayName: フリンクスフォースウォーキートーキー
		Tooltip: 敵に爆弾を投下するフリンクスコプターを召喚する
	}

	HandPrime: {
		DisplayName: ハンドプライム
		Tooltip:
			'''
			<right>で4つのモードを切り替え
			レーザーモード：赤いレーザーのバーストを発射
			キャノンモード：敵にホーミングする赤いロケットを発射
			ソーモード：ノコギリに変形し、敵を真っ二つに
			ソーモード中にモードやアイテムを切り替えるとノコギリを発射
			発射したノコギリが消えるまでソーモードは使用不可
			フックモード：敵に吸着するフックを撃つ
			<left>でフックに向かって自分を引き寄せる
			'''
	}

	HarmonicWeaponCatalyst: {
		DisplayName: ハーモニックウェポンカタリスト
		Tooltip:
			'''
			現在持っている武器の攻撃ダメージ、速度、クリティカル率を10%増加、防御貫通を10増加
			特定の武器タイプを持つ場合、そのダメージクラスに基づくボーナスを得る
			近接：攻撃時に受けるダメージを10%軽減するが、敵に狙われやすくなる
			遠距離：弾薬消費を10%軽減、矢の射程が増加
			魔法：マナ最大値+60、マナ使用量を10%軽減、低ライフ時にマナ再生が一定
			召喚：ミニオンとセントリーの最大数を+2、敵に狙われにくくなる
			投擲：投擲射程を10%増加
			ローグ（Calamity）：最大ステルスと投射物の速度を10%増加
			バード（Thorium）：最大インスピレーション+4、強化持続時間+5秒、強化範囲を15ブロック増加
			ヒーラー（Thorium）：マナ使用量を10%軽減、仲間をさらに2ライフ回復
			ボイド（Secret of the Shadows）：ボイドショックとボイド回復によるダメージを軽減
			'''
	}

	Jumboshark: {
		DisplayName: ジャンボシャーク
		Tooltip:
			'''
			「ミニシャークの別の世界からの従兄弟」
			3発ずつ撃つ
