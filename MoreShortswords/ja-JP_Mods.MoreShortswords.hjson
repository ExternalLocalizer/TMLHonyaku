Items: {
    StrangeStarSword: {
        DisplayName: 奇妙な星の剣
        Tooltip:
            '''
            『とても奇妙だ…』
            短剣のダメージが増加し、短剣の攻撃速度が上昇
            ダメージを受けると星が降ってくる
            '''
    }

    StrangeSword: {
        DisplayName: 奇妙な剣
        Tooltip:
            '''
            『とても奇妙だ…』
            短剣のダメージが増加し、短剣の攻撃速度が上昇
            '''
    }

    Betelguese: {
        DisplayName: ベテルギウス
        Tooltip: ""
    }

    CactusShort: {
        DisplayName: サボテンの短剣
        Tooltip: 敵にまれに毒を与える
    }

    ChaosControl: {
        DisplayName: カオスコントロール
        Tooltip: ""
    }

    CosmicBlade: {
        DisplayName: コズミックブレード
        Tooltip: ""
    }

