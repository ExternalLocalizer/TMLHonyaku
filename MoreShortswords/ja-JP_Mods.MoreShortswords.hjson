        Tooltip: ""
    }

    FinalSword: {
        DisplayName: アポジー
        Tooltip: 「死に別れを告げなさい」
    }

    Magma: {
        DisplayName: マグマ
        Tooltip:
            '''
            「注意、熱いよ！」
            敵に当たると爆発が起きる
            '''
    }

    FrozenShort: {
        DisplayName: 雪原の短剣
        Tooltip:
            '''
            「注意、冷たいよ！」
            まれに敵に霜焼けを与える
            '''
    }

    GoblinShort: {
        DisplayName: 戦士のナイフ
        Tooltip: ""
    }

    HeartRod: {
        DisplayName: ハートロッド
        Tooltip: クリティカル時、まれにライフが回復する
    }

    Ladnerud: {
        DisplayName: ハロウドシヴ
        Tooltip: 聖域内だとダメージが増加
    }

    LifeSplitter: {
        DisplayName: ライフスプリッター
        Tooltip:
            '''
            25%の確率で敵に衰弱を与える
            攻撃が当たると、敵を追尾する緑色のボルトを降らせる
            '''
    }

    MagicBlade: {
        DisplayName: マジックブレード
        Tooltip: 3回目の振りでブーメランのように発射
    }

    Moonlight: {
        DisplayName: ムーンライト
        Tooltip: ""
    }

    NaturesBless: {
        DisplayName: ネイチャーズブレス
        Tooltip: ""
    }

    SawBlade: {
        DisplayName: ソーブレード
        Tooltip: ""
    }

    ShortswordOfGrass: {
        DisplayName: グラッシーシヴ
        Tooltip: 20%の確率で敵に毒を与える
    }

    SkyBlade: {
        DisplayName: スカイブレード
        Tooltip: ""
    }

    StarFragment: {
        DisplayName: スターフラグメント
        Tooltip: 敵に当たると星を降らせる
    }

    TriangleSword: {
        DisplayName: キラーズクナイ
        Tooltip: 33%の確率で敵に衰弱と流血を与える
    }

    TrueStarFragment: {
        DisplayName: スカイズレイジ
        Tooltip: 敵に当たると多くの星を降らせる
    }

    Destroyer: {
        DisplayName: デストロイヤー
        Tooltip: ""
    }

    SuperFrost: {
        DisplayName: スーパーフロスト
        Tooltip: ""
    }
}

