Items: {
	JungleMask: {
		DisplayName: ジャングルの仮面
		Tooltip:
			'''
			召喚ダメージが8%増加
			ミニオンが敵に毒を与えることがある
			'''
	}

	PreciousBelt: {
		DisplayName: 尊いベルト
		Tooltip:
			'''
			ミニオンスロットを1つ追加し、
			召喚中のミニオン1体ごとに防御力が1増加
			'''
	}

	PredatorOfTheJungle: {
		DisplayName: ジャングルの捕食者
		Tooltip:
			'''
			ミニオンスロットを1つ追加
			召喚中のミニオン1体ごとに召喚ダメージが3%増加
			ミニオンが敵に毒を与える
			ダメージを受けると蜂を放って、蜂蜜を得る
			'''
	}

	HeavenlyShield: {
		DisplayName: 神聖な砦
		Tooltip:
			'''
			8 防御力
			250以上のダメージを250ダメージにする
			ダメージ・全ての攻撃速度・クリティカル率・ライフ自然回復量・採掘速度を強化する
			夜間はウェアウルフに、水中では半魚人に変身する
			ノックバックとほとんどのデバフを無効化
			身につけると光を放つ
			'''
	}

	ObsidianFireBowl: {
		DisplayName: 黒曜石のボウル
		Tooltip:
			'''
			鞭の攻撃速度が10%上昇し、鞭の射程が10%伸び、
			鞭で攻撃した敵を炎上させることがある
			燃えている！を無効化
			'''
	}

	SpiderSwarmNecklace: {
		DisplayName: クモの群れのアミュレット
		Tooltip:
			'''
			ミニオンスロットを1追加
			召喚ダメージが12%増加
			ミニオンが敵に毒を与えることがある
			'''
	}

	RegularClover: {
		DisplayName: 普通のクローバー
		Tooltip: ゴルフでは運は当てにならない...
	}

	RoyalAmulet: {
		DisplayName: 高貴なアミュレット
		Tooltip:
			'''
			50%の確率で採掘した鉱石を2倍入手できる
			移動速度が15%上昇
			アイテムの取得範囲が大幅に広がる
			敵に狙われにくくなる
			スライム系から攻撃されない
			身につけると光を放つ
			エキスパート
			'''
	}

	GripOfTheCursedFlame: {
		DisplayName: 呪いの炎の手袋
		Tooltip:
			'''
			鞭のダメージが12%増加し、鞭のノックバックが20%増加
			鞭の射程が20%伸びる
			鞭で攻撃した敵に呪炎を与えることがある
			鞭で敵を攻撃するたびに鞭の攻撃速度が8%上昇し、最大で40%上昇する
			2秒間鞭で攻撃しないとボーナスがリセットされる
			'''
	}

	TalismanOfResonance: {
		DisplayName: 共鳴のタリスマン
		Tooltip:
			'''
			近接攻撃速度が4%上昇
			近接武器で3回攻撃するごとに魔法弾を放つ
			'''
	}

	TowerShieldOfTerror: {
		DisplayName: 恐怖のタワーシールド
		Tooltip:
			'''
			5 防御力
			50 近接ダメージ
			ノックバック: とても強い
			被ダメージを10%軽減
			22.5%の確率で攻撃を回避する
			回避のクールダウンは10秒
			敵に向かってダッシュ攻撃でき、敵を貫通する
			エキスパート
			'''
	}

	ObsidianBracer: {
		DisplayName: 黒曜石の腕当て
		Tooltip:
			'''
			2 防御力
			近接攻撃のノックバックが増加
			近接武器で攻撃すると黒曜石の鎧を3秒間得て、防御力が5増加する
			'''
	}

	AmuletOfMalice: {
		DisplayName: 地獄のタリスマン
		Tooltip:
			'''
			近接ダメージが6%増加し、近接攻撃速度が6%上昇
			近接武器で攻撃すると幽霊を放つ
			'''
	}

	EmptyRing: {
		DisplayName: 空の指輪
		Tooltip: 1 防御力
	}

	InfinityRing: {
		DisplayName: インフィニティリング
		Tooltip:
			'''
			最大ライフとマナが40増加し、ライフとマナの自然回復を増進
			ダメージが10%増加し、クリティカル率と攻撃速度が10%上昇
			敵の防御力を6無視し、被ダメージを6%軽減
			移動速度・ジャンプ速度・最大落下速度・採掘速度が上昇
			飛行時間を延長し、身につけると虹色の光を放つ
			ライフが20%以下になるとライフが120回復し、4秒間無敵になる
			クールダウンは5分
			「1つの指輪に無限の力が宿っている」
			'''
	}

	StellarMarble: {
		DisplayName: 星の大理石
		Tooltip:
			'''
			近接クリティカル率が6%上昇
			近接攻撃でクリティカル時に星が落ちてくる
			'''
	}

	LivingGranite: {
		DisplayName: 御影石のハート
		Tooltip:
			'''
			4 防御力
			近接ダメージが8%増加し、近接攻撃速度が8%上昇
			近接武器で敵を攻撃すると火花を放つことがある
			'''
	}

	Mirror: {
		DisplayName: 鏡
		Tooltip: ""
	}

	DistortedMirror: {
		DisplayName: 歪んだ鏡
		Tooltip:
			'''
			魔法クリティカル率が8%上昇
			魔法武器で攻撃時に25%の確率で弾を追加で発射する
			'''
	}

	BlindEye: {
		DisplayName: 盲目の目
		Tooltip:
			'''	
			2秒経過ごとに次の魔法攻撃のダメージが50%増加
			魔法攻撃速度が10%上昇するが
			魔法武器の弾が12%拡散しやすくなる
			'''
	}

	AllSeeingEye: {
		DisplayName: 全知の目
		Tooltip:
			'''
			マナ消費量が10%減少
			2秒経過ごとに次の魔法攻撃のダメージが125%増加
			魔法攻撃速度が15%上昇するが、
			魔法武器の弾が10%拡散しやすくなる
			マナスターの取得範囲が広がる
			マナがなくなるとマナポーションを自動的に使用する
			'''
	}

	SignOfSpace: {
		DisplayName: 天空の印
		Tooltip:
			'''
			魔法クリティカル率が6%上昇
			魔法武器でクリティカル時にたくさんのハーピーの羽で追撃する
			'''
	}

	FossilizedBone: {
		DisplayName: 化石の骨
		Tooltip:
			'''
			魔法ダメージが20%減少するが、
			魔法攻撃速度が12%上昇し、
			魔法武器の弾の敵の貫通数が1体増える
			'''
	}

	ManaShield: {
		DisplayName: マナアブソーバー
		Tooltip:
			'''
			最大マナが40増加
			50%の確率で受けたダメージの50%をマナで吸収する
			1ダメージごとにマナを2消費する
			マナ酔いを受けているとダメージを吸収しない
			触れた敵に霜焼けを与える
			ノックバックを無効化
			'''
	}

	SilverFeather: {
		DisplayName: 銀の羽根
		Tooltip:
			'''
			遠距離クリティカル率が8%上昇
			遠距離武器でクリティカル時に喀血を与える
			'''
	}

	HunterSign: {
		DisplayName: 狩人の印
		Tooltip:
			'''
			遠距離攻撃速度が8%上昇
			遠距離クリティカル率が6%上昇
			遠距離武器で敵を攻撃すると毒を与えることがある
			'''
	}

	RangerBadge: {
		DisplayName: レンジャーのバッジ
		Tooltip:
			'''
			遠距離攻撃速度が6%上昇
			クリティカル率が4%上昇
			'''
	}

	BlastingBandolier: {
		DisplayName: 爆発弾帯
		Tooltip:
			'''
			遠距離ダメージが8%増加
			弾丸が当たると爆発することがある
			12%の確率で弾薬を消費しない
			'''
	}

	SurvivalKit: {
		DisplayName: 弓兵の道具
		Tooltip:
			'''
			矢の速度が上昇
			矢の敵の貫通数が2体増える
			15%の確率で矢を消費しない
			'''
	}

	SkyCrown: {
		DisplayName: 空の王冠
		Tooltip:
			'''
			召喚ダメージが5%増加
			1秒ごとにハーピーの羽根を1枚生成する（最大で4枚まで）
			羽根は近くの敵を攻撃する
			'''
	}

	SeedOfLife: {
		DisplayName: 生命の種
		Tooltip:
			'''
			動かずにいると、ライフ自然回復を増進
			ライフが50%以下の際、ドライアドの祝福を得る
			「ドライアドはこれを大切にしている」
			'''
	}

	FrozenScale: {
		DisplayName: 氷の鱗
		Tooltip:
			'''
			4 防御力
			移動速度が10%低下
			被ダメージ時に敵の動きを遅くする鱗の破片を放つ
			'''
	}

	NecklaceOfBones: {
		DisplayName: 骨のネックレス
		Tooltip:
			'''
			お気に入りに登録し、インベントリに所持していると効果を発揮
			敵の出現率と出現上限が上昇
			'''
	}

	TideShell: {
		DisplayName: 潮の甲羅
		Tooltip:
			'''
			水中にとても長く居られる
			液体内で被ダメージを15%軽減し、光を放つ
			'''
	}

	AntFangs: {
		DisplayName: 蟻の牙
		Tooltip:
			'''
			近接攻撃速度が33%上昇するが、
			近接ダメージが15%減少し、
			近接武器のサイズが25%小さくなる
			'''
	}

	SwarmComb: {
		DisplayName: 群れのハニカム
		Tooltip:
			'''
			敵を倒すと蜂をいくつか召喚することがある
			ジャングルにいると蜂蜜を得る
			'''
	}

	MinerLantern: {
		DisplayName: 故障したランタン
		Tooltip:
			'''
			2 防御力
			光を発するが、時折ちらつく
			光を発しているときは宝物や鉱石の位置がわかる
			'''
	}

	NectarOfLife: {
		DisplayName: 生命の蜜
		Tooltip:
			'''
			ライフ自然回復を増進し、ライフ回復アイテムの再使用間隔が25%短縮される
			ダメージを受けると蜂を放ち、蜂蜜を得て、移動速度が上昇する
			ライフ回復アイテムを使用するとライフを5回復する蜂を4-8匹召喚する
			'''
	}

	AuroraVeil: {
		DisplayName: オーロラベール
		Tooltip:
			'''
			6 防御力
			ノックバックを無効化し、被ダメージ時の無敵時間を延長する
			ライフが50%以下の際、被ダメージを25%軽減する
			ダメージを受けると敵を追尾する流れ星が降ってくる
			'''
	}

	DollOfSilence: {
		DisplayName: 沈黙の人形
		Tooltip:
			'''
			お気に入りに登録し、インベントリに所持していると効果を発揮
			敵の出現率と出現上限が低下
			'''
	}

	CursedFlameQuiver: {
		DisplayName: 呪いの炎の矢筒
		Tooltip:
			'''
			矢のダメージが12%増加し、矢の速度が大幅に上昇
			矢が敵を2体貫通するようになり、当たった敵に呪炎を与える
			33%の確率で矢を消費しない
			'''
	}

	VeteranArcherSign: {
		DisplayName: 熟練弓兵のバックパック
		Tooltip:
			'''
			遠距離ダメージが10%増加
			遠距離クリティカル率が12%上昇
			敵の防御力を5無視する
			遠距離武器でクリティカル時に喀血を与える
			'''
	}

	TopazAmberRing: {
		DisplayName: 探検家の指輪
		Tooltip:
			'''
			2 防御力
			移動速度が10%上昇し、採掘速度が15%上昇
			ジャンプの高度と速度が上昇
			身につけると光を放つ
			'''
	}

	RubySapphireRing: {
		DisplayName: モンクの指輪
		Tooltip:
			'''
			2 防御力
			最大ライフとマナが25増加
			ライフとマナの自然回復を増進
			'''
	}

	EmeraldAmethystRing: {
		DisplayName: 破壊の指輪
		Tooltip:
			'''
			2 防御力
			ダメージが4%増加し、クリティカル率が4%上昇
			攻撃速度が5%上昇
			敵の防御力を2無視する
			'''
	}

	GhostlySkull: {
		DisplayName: 幽霊のドクロ
		Tooltip:
			'''
			魔法ダメージが15%減少するが、
			魔法攻撃速度が15%上昇
			魔法武器の弾の敵の貫通数が3体増える
			魔法武器で倒した敵から霊魂がいくつか放たれることがある
			霊魂は敵を追尾し、敵を貫通し、何回かヒットする
			'''
	}

	TacticalScope: {
		DisplayName: タクティカルスコープ
		Tooltip:
			'''
			遠距離ダメージが10%増加し、遠距離クリティカル率が10%上昇
			銃を装備時、右クリックで視界を広げることができる
			視界を広げているとさらに遠距離ダメージが6%増加し、遠距離クリティカル率が6%上昇し、
			攻撃した敵に破壊を与える
			敵に狙われにくくなる
			20%の確率で弾薬を消費しない
			'''
	}

	EyeOfCorruption: {
		DisplayName: 腐敗の眼
		Tooltip:
			'''
			腐敗のオーラが発生し、その中だと
			自身は被ダメージが5%増加
			敵は被ダメージが15%増加
			悪臭を受けるが、非表示にすると受けない
			「体を洗うのは自分自身への冒涜だ」
			'''
	}

	CactusGuard: {
		DisplayName: サボテンの盾
		Tooltip:
			'''
			2 防御力
			被ダメージ時、トゲを放つ
			砂漠にいると防御力が4増加し、移動速度が10%上昇
			'''
	}

	CrimsonHeart: {
		Tooltip:
			'''
			3秒ごとに最大ライフの1%を回復する
			ライフが少ないほど回復量が増加する
			「この心臓の鼓動はいつか止まるのか？」
			'''
		DisplayName: 真紅の心臓
	}

	CelestialBracers: {
		DisplayName: 宇宙の小手
		Tooltip:
			'''
			4 防御力
			近接クリティカル率が10%上昇し、近接武器でクリティカル時、
			味方の星を4個まで召喚することがある
			星は4秒間持続し、防御力が2増加
			'''
	}

	TotemOfBlightedLight: {
		DisplayName: 蝕光のトーテム
		Tooltip:
			'''
			2秒ごとに最大ライフの1%を回復する
			輝きのオーラが発生し、その中だと
			自身は被ダメージが10%増加
			敵は被ダメージが20%増加し、蝕光を受ける
			動かずにいると回復量が2.5%になる
			エキスパート
			'''
	}

	ThornheartBloom: {
		Tooltip:
			'''
			静止時、ライフ自然回復量が2倍になる
			移動速度が15%上昇
			周囲に攻撃性能がある胞子を呼び出す
			被ダメージ時、追加で胞子を呼び出す
			ドライアドの祝福を得る
			エキスパート
			'''
		DisplayName: トゲのハートのブルーム
	}

	SkeletronJaw: {
		Tooltip:
			'''
			攻撃した敵にシャドウフレイムを与えることがある
			15%の確率で敵の防御力を無視する
			'''
		DisplayName: 呪われた顎
	}

	PendantOfLife: {
		Tooltip:
			'''
			触れた敵を炎上させる
			ダメージを受けると25%の確率でライフを15回復する
			'''
		DisplayName: 生命のペンダント
	}

	AzureEarring: {
		Tooltip:
			'''
			触れた敵に霜焼けを与える
			敵にダメージを与えると10%の確率でマナを15回復する
			'''
		DisplayName: 紺碧のイヤリング
	}

	WaxDoll: {
		DisplayName: 蝋のドクロ
		Tooltip:
			'''
			お気に入りに登録し、インベントリに所持していると効果を発揮
			[c/e8d13a:珍しい]敵の出現率が大幅に上昇
			2つの状態を切り替えることができる:
			[c/A02819:収穫の炎] - 敵の出現率が大幅に上昇し、出現上限が上昇
			[c/235AC8:平穏の炎] - 敵の出現率が大幅に低下し、出現上限が低下
			使用すると状態を切り替える
			'''
	}

	FragmentoftheWing: {
		Tooltip: ""
		DisplayName: ちぎれた翼
	}

	BatAmulet: {
		DisplayName: コウモリのお守り
		Tooltip:
			'''
			攻撃を当てるとライフが8回復する
			クールダウンは6秒
			翼の横移動速度が上昇
			噛み傷を無効化
			'''
	}

	MantleoftheLord: {
		DisplayName: 主のマント
		Tooltip:
			'''
			6 防御力
			攻撃した敵にシャドウフレイムを与え、20%の確率で敵の防御力を無視する
			敵に攻撃を当てると敵を追尾するコウモリを4-8匹放つ
			クールダウンは6秒
			コウモリが当たるとライフを2回復する
			翼の横移動速度が上昇
			噛み傷を無効化
			'''
	}

	RelicoftheSwarm: {
		DisplayName: 群れの遺物
		Tooltip:
			'''
			ミニオンスロットを2つ追加
			召喚ダメージと召喚武器のノックバックが20%増加
			ミニオンが毒針を発射することがある
			'''
	}

	TatteredLeather: {
		Tooltip: ""
		DisplayName: ぼろぼろの革
	}

	HermitSeal: {
		DisplayName: 隠者の印章
		Tooltip:
			'''
			鞭系の武器しか使用できなくなり、
			ミニオンスロットとセントリースロットが0になるが、
			鞭のクリティカル率が20%上昇し、
			失ったスロット1つにつき、防御力が3、召喚ダメージが6%増加し、
			鞭の射程が12%伸び、移動速度が3%上昇
			[c/919191:提案者] [c/3abfeb://Frosty//]
			'''
	}

	Fanglikeshell: {
		DisplayName: 牙の甲殻
		Tooltip:
			'''
			8 防御力
			近接ダメージが10%増加し、近接攻撃速度が10%上昇
			近接武器のサイズが25%大きくなる
			防御力が10増加するごとにクリティカル率が4%上昇し、武器のサイズが8%大きくなる
			近接攻撃で敵から胞子の雲が発生することがある
			'''
	}

	InfernalCore: {
		Tooltip:
			'''
			ダメージが5%増加し、移動速度が8%上昇
			歩いた後に炎の軌跡が残る
			'''
		DisplayName: 灼熱の核
	}

	GoldenTooth: {
		Tooltip:
			'''
			お気に入りに登録し、インベントリに所持していると効果を発揮
			倒した敵が18%の確率でアイテムを2倍ドロップする
			運がわずかに増加
			'''
		DisplayName: 黄金の牙
	}

	FlinxScarf: {
		DisplayName: フリンクスのスカーフ
		Tooltip:
			'''
			ミニオンがタグが付いた敵に与えるダメージが3増加する
			鞭で敵を攻撃するとミニオンが氷の弾を発射する
			'''
	}

	LunarOrb: {
		DisplayName: 月のオーブ
		Tooltip:
			'''
			最大マナが40増加
			魔法ダメージが12%増加
			魔法クリティカル率が10%上昇
			魔法攻撃でクリティカル時にパルスを放つ
			'''
	}

	FairyCircle: {
		DisplayName: 妖精の輪
		Tooltip:
			'''
			召喚ダメージが10%増加
			ミニオンがタグが付いた敵に与えるダメージが6増加する
			3匹の妖精が周囲を飛び、タグが付いた敵を攻撃する
			妖精はミニオンとして扱われ、召喚武器強化の恩恵を受ける
			'''
	}

	ThunderGauntlet: {
		Tooltip:
			'''
			近接ダメージが12%増加
			近接攻撃速度が15%上昇
			近接武器のサイズが大きくなり、近接攻撃のノックバックが増加
			近接攻撃で攻撃した敵を感電させることがある、
			クリティカル時、連鎖する電撃を放ち、5秒間防御力が3増加し、最大で12増加する
			'''
		DisplayName: 電撃の籠手
	}

	ChimeraHeart: {
		DisplayName: キメラのハート
		Tooltip:
			'''
			永久にアクセサリスロットを追加
			追加されるスロットはこのModのアクセサリのも装備できる
			'''
	}

	BonePart: {
		Tooltip:
			'''
			骨に覆われた、凍りついたハートの半分
			「もう片方の半分を探し求めている」
			'''
		DisplayName: 骨ののハートの欠片
	}

	JelPart: {
		DisplayName: ジェルのハートの欠片
		Tooltip:
			'''
			クイーンスライムから取り出された、ぬるぬるした欠片
			「クイーンスライムは自ら差し出したのか……それとも？」
			'''
	}
}

