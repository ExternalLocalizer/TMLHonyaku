Items:{
    AntiCollisionPotion:{
        DisplayName: 不可触のポーション
        Tooltip:
            '''
            切り替え可能
            攻撃を受けなくなる
            '''
    }

    AntiDeathPotion:{
        DisplayName: 不可殺のポーション
        Tooltip:
            '''
            切り替え可能
            不死身になる
            '''
    }

    AntiDebuffPotion:{
        DisplayName: 不可侵のポーション
        Tooltip:
            '''
            切り替え可能
            全てのデバフを無効化
            '''
    }

    AntiImmunityPotion:{
        DisplayName: 無敵時間支配のポーション
        Tooltip:
            '''
            切り替え可能
            敵の無敵時間を無視
            発射物のみに有効
            '''
    }

    AntiLifePotion:{
        DisplayName: アンチライフポーション
        Tooltip: 飲めば即座に死亡する
        DeathMessage: "{0}の生命は消滅しました。"
    }

    AntiRainPotion:{
        DisplayName: てるてるポーション
