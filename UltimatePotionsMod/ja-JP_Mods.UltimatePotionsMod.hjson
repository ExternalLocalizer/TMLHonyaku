Configs:{
    Config:{
        DisplayName: 設定
        UltimatePotion:{
            Label: 究極のポーションを有効にする
            Tooltip: これを無効にすると、究極のポーションが使用できなくなります
        }

        OriginalPotion:{
            Label: オリジナルのポーションを有効にする
            Tooltip: これをオフにすると、オリジナルのポーション（焚き火・鋭利・アイテム速度・蜂蜜...）が使用不可になります	
        }

        EnhancedPotion:{
            Label: 強化ポーションを有効にする
            Tooltip:
					'''
					これをオフにすると、邪悪なポーション・神聖なポーション・
					精霊のポーション・月影のポーションが使用不可になります
					'''
        }

        CheatPotion:{
            Label: チートポーションを有効にする
            Tooltip: 
            		'''
            		これをオフにすると、アンチポーション（不可侵・不可触...）と、
            		無限ポーションが使用できなくなります
					'''   
        }
    }
}