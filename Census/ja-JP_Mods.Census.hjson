Configs: {
	CensusConfigClient: {
		DisplayName: Census 設定

		ShowLocatingArrow: {
			Label: NPCの位置を示す矢印を表示
			Tooltip:
				'''
				ハウジングでNPCにカーソルを合わせると、そのNPCのいる方向が表示されます
				行方がわからなくなった町のNPCを探すのに便利です
				'''
		}

		ArrowColor: {
			Label: 位置を示す矢印の色
			Tooltip: ""
		}

		DisableConditionsText: {
			Label: 出現条件を表示しない
			Tooltip:
				'''
				これをオンにすると、出現条件のテキストが表示されなくなります
				NPCが出現するかどうかを知りたいが、出現条件を知らずに楽しみたい場合に使用してください
				'''
		}

		Headers.DeveloperOptions: "[c/ff0000:開発者向けオプション]"

		DisableAutoLocalization: {
			Label: 自動翻訳を無効化
			Tooltip:
				'''
				デフォルトでは、Censusは構築中のModに含まれるNPCの出現条件テキストを翻訳します
				この動作を無効にするにはオンに設定してください
				'''
		}
	}
}

Next: 次へ

SpawnConditions: {
	Unknown: 条件不明
	Guide: 通常のワールド生成時に出現
	Merchant: インベントリに[i:72] を50枚所持
	Nurse: 最大ライフが100より上で、商人がいる
	Demolitionist: インベントリに爆発物を所持
	DyeTrader:
		'''
		インベントリに染料の素材か奇妙な植物を所持し、
		タウンNPCが4人以上いる
		'''
	Angler: 海に出現し、寝ているところを話しかける
	BestiaryGirl: 図鑑を10%以上埋める
	Dryad: いずれかのボスを一度でも倒す
	Painter: タウンNPCが8人以上いる
	Golfer: 地下砂漠に出現し、話しかける
	ArmsDealer: インベントリに弾丸か銃を所持
	DD2Bartender:
		'''
		イーターオブワールドかクトゥルフの脳を倒した後、
		地上と地下に出現し、倒れているところを話しかける
		'''
	Stylist: 蜘蛛の洞窟に出現し、縛られているところを話しかける
	GoblinTinkerer:
		'''
		ゴブリン軍団を撃退後、洞窟に出現し、
		縛られているところを話しかける
		'''
	WitchDoctor: 女王蜂を倒した後
	Clothier: スケルトロンを倒した後
	Mechanic:
		'''
		ダンジョンに出現し、
		縛られているところを話しかける
		'''
	PartyGirl: タウンNPCが14人以上いる
	Wizard:
		'''
		ハードモードの洞窟かダンジョンに出現し、
		縛られているところを話しかける
		'''
	TaxCollector: 
		'''
		ハードモードの地底世界に出現する、
		苛まれた霊に[i:PurificationPowder] {$ItemName.PurificationPowder}を使う
		'''
	Truffle: ハードモードで、地上のキノコバイオームに家を建てる
	Pirate: 海賊を撃退した後
	Steampunker: いずれかのメカニカルボスを一度でも倒す
	Cyborg: プランテラを倒した後
	SantaClaus:
		'''
		フロストレギオンを撃退した後、12月15日から31日までの間か、
		フロストムーンでウェーブ15に到達するとゲーム内で1日間のみ出現
		'''
	Princess: サンタクロースとタウンペット以外のバニラのタウンNPCが全員いる
	TownCat: 動物学者から購入できる[i:LicenseCat] {$ItemName.LicenseCat}を使う
	TownDog: 動物学者から購入できる[i:LicenseDog] {$ItemName.LicenseDog}を使う
	TownBunny: 動物学者から購入できる[i:LicenseBunny] {$ItemName.LicenseBunny}を使う
	TownSlimeBlue: キングスライムを倒すと出現
	TownSlimeGreen: 自然に発生したパーティー中に出現
	TownSlimeOld:
		'''
		スケルトロンを倒した後、洞窟に出現する、
		揺れている古い宝箱に[i:GoldenKey] {$ItemName.GoldenKey}を使う
		'''
	TownSlimePurple:
		'''
		ワールドの中心から少し離れた宇宙に出現する、
		不器用な風船スライムの風船を攻撃して割る
		'''
	TownSlimeRainbow: "[i:GelBalloon] {$ItemName.GelBalloon}をシマーに投げるかドロップする"
	TownSlimeRed: ブラッドムーン中に釣り上げる
	TownSlimeYellow:
		'''
		ジャングルに出現する、
		魔法使いカエルに[i:PurificationPowder] {$ItemName.PurificationPowder}を使う
		'''
	TownSlimeCopper:
		'''
		通常のスライムが[i:CopperHelmet] {$ItemName.CopperHelmet}か、
		[i:CopperShortsword] {$ItemName.CopperShortsword}に触れる
		'''
}
