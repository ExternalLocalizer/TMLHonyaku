Items: {
	LeatherSatchel: {
		DisplayName: 革のサッチェル
		Tooltip:
			'''
			マナ消費量が8%減少 
			アーケインスロットを2つ追加
			'''
	}

	ArcaneBag: {
		DisplayName: 神秘的なカバン
		Tooltip:
			'''
			マナ消費量が10%減少
			マナ自然回復の遅延が短縮され、自然回復を増進
			最大マナが60増加
			アーケインスロットを3つ追加
			'''
	}

	PortableBookshelf: {
		DisplayName: 携帯本棚
		Tooltip:
			'''
			魔法ダメージが10%増加
			アーケインスロットを1つ追加
			ノックバックを無効化
			'''
		CalamityDash: 水晶の暗殺者のダッシュが可能
	}

	BandofArcaneReserve: {
		DisplayName: アーケイン再生の腕輪
		Tooltip:
			'''
			アーケインゲージが出現する
			最大マナと最大アーケインが40増加
			マナ自然回復ポーションの効果を得る
			魔法武器でマナを消費するとアーケインを得る
			アーケインが最大時に[c/8d0ae6:{0}]でアーケインを消費してライフを回復する
			マナがなくなるとマナポーションを自動的に使用する
			このアクセサリーを非表示にすると、自動でマナポーションを使用する機能を無効化できる
			'''
	}

	ArcaneInfusionBook: {
		DisplayName: 神秘注入の本
		Tooltip:
			'''
			アーケインゲージが出現する
			最大マナと最大アーケインが40増加
			魔法武器でマナを消費するとアーケインを得る
			アーケインが最大時に[c/8d0ae6:{0}]でアーケインを消費して神秘注入を得て、
			現在のアーケインの66%分、魔法ダメージを増加させる
			マナがなくなるとマナポーションを自動的に使用する
			このアクセサリーを非表示にすると、自動でマナポーションを使用する機能を無効化できる
			'''
	}

	FourDimensionalPocket: {
		DisplayName: 四次元ポケット
		Tooltip:
			'''
			アーケインスロットを4つ追加
			最大マナが80増加
			15秒ごとにポケットダメージ、ポケットマナ、ポケットライフのバフを2つランダムに15秒間得る
			エキスパート
			'''
	}

	ArcaneConversionDevice: {
		DisplayName: アーケイン変換デバイス
		Tooltip:
			'''
			アーケインゲージが出現する
			最大マナが80増加し、最大アーケインが{0}増加
			アーケイン再生の腕輪と神秘注入の本の効果を得る
			魔法武器でマナを消費するとアーケインを得る
			アーケインが最大時に[c/8d0ae6:{1}]でアーケインを消費してライフを回復し、神秘注入を得る
			下位のアクセサリとは重複しない
			マナがなくなるとマナポーションを自動的に使用する
			このアクセサリーを非表示にすると、自動でマナポーションを使用する機能を無効化できる
			'''
	}

	KoishiHat: {
		DisplayName: こいしの帽子
		Tooltip:
			'''
			ダメージが20%増加
			クリティカル率が12%上昇
			'''
		SetBonus:
			'''
			5秒間攻撃しなかった場合、無意識状態になる
			無意識状態中は敵に狙われにくくなる
			被ダメージを80%軽減
			次の攻撃のダメージが5倍になる
			ダメージを受けるか、敵に接触すると解除される
			'''
	}

	VineWhip: {
		DisplayName: 蔓の鞭
		Tooltip:
			'''
			敵を貫通するたびにダメージが30%減少する
			召喚タグダメージ 6
			攻撃を当てた敵にミニオンが集中攻撃する
			'''
	}

	OctopusTentacle: {
		DisplayName: タコの触手
		Tooltip:
			'''
			同時に3-5本の触手を振る
			敵を貫通するたびにダメージが10%減少する
			召喚タグダメージ {0}
			召喚タグクリティカル率 {1}%
			タグの効果:
			タグ付けされた敵を攻撃するミニオンが{2}%の追加ダメージを与える
			また、爆発を引き起こし、{2}%のダメージを与える
			攻撃を当てた敵にミニオンが集中攻撃する
			'''
	}

	ScabbardOfGram: {
		DisplayName: グラムの鞘
		Tooltip:
			'''
			最大で3つの呪われた武器を召喚し、それぞれミニオンスロットを1つ消費する
			魔法のエクスカリバー：敵の周囲にテレポートし、敵を貫通する攻撃を行う
			カースドハンマー：激しい振り回し攻撃で敵を粉砕する
			クリムゾンアックス：このミニオンの攻撃が当たった際に爆発を引き起こし、{0}%のダメージを与える
			爆発には5秒のクールダウンがある
			'''
	}

	BrokenExcalibur: {
		DisplayName: 折れたエクスカリバー
		Tooltip: ""
	}

	CrimsonAxeBlade: {
		DisplayName: クリムゾンアックスの斧頭
		Tooltip: ""
	}

	CursedHammerHead: {
		DisplayName: カースドハンマーの頭
		Tooltip: ""
	}

	SnowballLauncherSentry: {
		DisplayName: 雪玉ランチャー(セントリー)
		Tooltip: 
			'''
			「これはセントリーだ！」
			敵に雪玉を発射する
			'''
	}

	CannonSentry: {
		DisplayName: エンチャントキャノン
		Tooltip:
			'''
			「俯角はありません」
			このセントリーの上にいる敵に砲丸を発射する
			敵を貫通し、3ヒットすると爆発し周囲の敵にダメージを与える
			'''
	}

	BunnyCannonSentry: {
		DisplayName: エンチャントラビットキャノン
		Tooltip:
			'''
			「昔はウサギだったんだよ！」
			このセントリーの上にいる敵に爆裂ウサギを発射する
			敵を4体貫通するが、貫通するたびにダメージが15%減少する
			また、5ヒット目は爆発し周囲の敵にダメージを与える
			爆発しなかった爆裂ウサギは動きが止まった後、歩き始め、近くの敵に体当たりを行い、2ヒットする
			2ヒット目は爆発し周囲の敵にダメージを与える
			'''
	}

	LandMineSentry: {
		DisplayName: 再利用できる地雷
		Tooltip: 
			'''
			「足もとに注意！」
			敵が上を通ると爆発し周囲の敵にダメージを与える
			'''
	}

	RocketFireworkBoxSentry: {
		DisplayName: ロケット花火箱
		Tooltip:
			'''
			「可愛くて実用的！」
			敵を追尾するロケット花火を発射し、当たると爆発する
			'''
	}

	StaffoftheFrostHydraSentry: {
		DisplayName: フロストヒドラの杖・改
		Tooltip: 
			'''
			フロストヒドラを召喚するのは同じだが、いくつかの点で違う
			ダメージが減少した
			敵を追尾するフロストビームを発射する
			フロストビームは敵を貫通し、4ヒットするが当たるたびにダメージが25%減少する
			また、霜焼けを与える
			'''
	}

	LifeBadge: {
		DisplayName: ライフバッジ
		Tooltip: 
			'''
			召喚ダメージが12%増加
			ミニオンスロットを1つ追加
			頭上にローズクリスタルが出現し、敵を自動で攻撃する
			ローズクリスタルはミニオンスロットを消費せず、100ダメージを与える
			召喚ダメージ増加の影響を受ける
			'''
	}

	FairyCritterStaff: {
		DisplayName: 妖精の杖
		Tooltip: 共に戦う妖精を召喚する
	}

	PixieStaff: {
		DisplayName: ピクシースタッフ
		Tooltip: 共に戦うピクシーを召喚する
	}

	DayBreakItem: {
		DisplayName: デイブレイカー
		Tooltip:
			'''
			攻撃速度上昇の影響を受けないが、その分が防御無視に変換される 
			槍の先端で攻撃するとダメージが1.15倍になり、敵の防御力を{0}%無視する
			右クリックで槍を回転させながら突進し、左クリック攻撃を15秒間強化し、カーソルの位置に斬撃を放つように
			斬撃はカーソルから一定距離内の敵を自動でロックオンする
			突進中、短時間無敵になる
			3回目と7回目の攻撃時に斬撃を放つ
			15秒のクールダウンがあるが、槍の先端で攻撃するとクールダウンが短縮される
			'''
	}

	FairyCritterStumpSentry: {
		DisplayName: 妖精の切り株
		Tooltip:
			'''
			セントリーを召喚する
			3体の妖精を召喚し、近くの敵を攻撃する
			「ラッキー！」
			'''
	}

	TombstoneImitatorSentry: {
		DisplayName: 墓石のミミック
		Tooltip:
			'''
			セントリーを召喚する
			味方のゾンビを召喚し、近くの敵を攻撃する
			「あなたもネクロマンサーか？」
			'''
	}

	FireBallSentry: {
		DisplayName: ファイアスティック
		Tooltip:
			'''
			セントリーを召喚する
			回転するファイアバーを召喚する
			「ズルはしてないよ」
			'''
	}

	TeslaElectricTowerSentry: {
		DisplayName: テスラタワースタッフ
		Tooltip:
			'''
			セントリーを召喚する
			電撃で攻撃するテスラタワーを召喚する
			「ザップ！ザップ！ザップ！」
			'''
	}

	DandelionSentry: {
		DisplayName: タンポポの杖
		Tooltip: 
			'''
			セントリーを召喚する
			浮遊する種で攻撃するアングリーダンデライオンの鉢を召喚する
			'''
	}

	StardustFountainSentry: {
		DisplayName: スターダストファウンテンスタッフ
		Tooltip:
			'''
			セントリーを召喚する
			敵を攻撃するきらめく泉を召喚する
			泉1つにつき、戦闘を支援するスパークルミニオン3体を召喚する
			「ついに飛べる！」
			'''
	}

	SentryTelePortDevice1: {
		DisplayName: 奇妙な魔法の鏡
		Tooltip:
			'''
			セントリースロットを1つ追加
			[c/FFA500:{0}]で奇妙なポータルを出現させる
			少し時間が経つと最も遠いセントリーを自身の近くにテレポートさせる
			自身のセントリーのみテレポートでき、オールドワンズ・アーミーの進行中は効果が無効化される
			一度に4体のセントリーをテレポートできる
			'''
	}

	SentryTelePortDevice2: {
		DisplayName: メカニカルレンズ
		Tooltip:
			'''
			セントリースロットを2つ追加するが、
			ミニオンスロットが1つ減る
			鞭の射程が20%伸びる
			鞭の攻撃速度が10%上昇
			[c/FFA500:{0}]で奇妙なポータルを出現させる
			少し時間が経つと最も遠いセントリーを自身の近くにテレポートさせる
			自身のセントリーのみテレポートでき、オールドワンズ・アーミーの進行中は効果が無効化される
			一度に8体のセントリーをテレポートできる
			下位のアクセサリとは重複しない
			'''
	}

	SentryTelePortDevice3: {
		DisplayName: 天体の魔法の鏡
		Tooltip:
			'''
			セントリースロットを3つ追加するが、
			ミニオンスロットが2つ減る
			鞭の射程が30%伸びる
			鞭の攻撃速度が15%上昇
			ダメージが15%増加
			[c/FFA500:{0}]で奇妙なポータルを出現させる
			少し時間が経つと最も遠いセントリーを自身の近くにテレポートさせる
			自身のセントリーのみテレポートでき、オールドワンズ・アーミーの進行中は効果が無効化される
			一度に16体のセントリーをテレポートできる
			下位のアクセサリとは重複しない
			'''
	}

	VileMushroomSentry: {
		DisplayName: 邪悪なキノコの杖
		Tooltip: 
			'''
			セントリーを召喚する
			敵を攻撃する小さな毒キノコを召喚する
			'''
	}

	LunarPolarizer: {
		DisplayName: 月の偏光子
		Tooltip:
			'''
			アーケインゲージが出現する
			最大マナが120増加し、最大アーケインが{0}増加
			アーケイン再生の腕輪と神秘注入の本の効果を得る
			アーケインの獲得効率が上昇する
			魔法武器でマナを消費するとアーケインを得る
			アーケインが最大時に[c/8d0ae6:{1}]でアーケインを消費してライフを回復し、神秘注入を得る
			下位のアクセサリとは重複しない
			マナがなくなるとマナポーションを自動的に使用する
			このアクセサリーを非表示にすると、自動でマナポーションを使用する機能を無効化できる
			'''
	}

	ExampleAdvancedFlail: {
		DisplayName: サンプル用の高度なフレイル
		Tooltip: ""
	}

	RainbowBoulderMace: {
		DisplayName: 虹の大岩のメイス
		Tooltip:
			'''
			振り回している間、最大で6つまで虹の大岩を生成し、投げると放つ
			虹の大岩は振り回している最中も近くの敵に向かって飛んでいき、
			当たると他の敵に飛んでいく
			'''
	}
	
	ArcaneAndSentryClearBook: {
		DisplayName: 解雇の本
		Tooltip: 左クリックで自分が召喚したアーケインを全て消し、右クリックで自分のセントリーを全て消す
	}
	
	Flare: {
		DisplayName: ソーラーフレア
		Tooltip: ""
	}

	PoisonBullet: {
		DisplayName: 毒の弾丸
		Tooltip: 毒を与えることがある
	}

	PoisonArrow: {
		DisplayName: 毒矢
		Tooltip: 毒を与えることがある
	}

	HellfireBullet: {
		DisplayName: ヘルファイアの弾丸
		Tooltip: 敵を炎上させ、敵か地形に当たると小さな爆発が起きることがある
	}

	SpectreArrow: {
		DisplayName: スペクターアロー
		Tooltip: 敵を追尾するスペクターを召喚することがある
	}

	ShroomiteArrow: {
		DisplayName: シュルーマイトの矢
		Tooltip: キノコの胞子雲を発生させる
	}

	FrostBullet: {
		DisplayName: 氷の弾丸
		Tooltip: 霜焼けを与え、敵か地形に当たると氷の欠片に分裂する
	}

	FrostShard: {
		DisplayName: 氷の欠片
		Tooltip: 氷の弾丸の作成に使用する
	}

	NebulaRift: {
		DisplayName: ネビュラリフト
		Tooltip: ""
	}

	GemStaff: {
		DisplayName: 宝石の杖
		Tooltip: ""
	}

	WoodlandStalker: {
		DisplayName: ウッドランドストーカー
		Tooltip:
			'''
			左クリックを押し続けてチャージし、チャージは2段階ある
			1段階でイバラの矢を3本発射し、チャージ時間に応じてダメージが増加する
			最大までチャージするとイバラの矢が刺さっている数に応じてダメージが増加する、
			ウッドランドアローを発射する
			右クリックで通常の攻撃を行い、イバラの矢を発射する
			イバラの矢は敵に当たると10秒間突き刺さり、本数に応じて効果が強くなる、
			森の毒素を与える
			森の毒素は1スタックごとにライフを20減少させ、最大で15スタックする
			'''
	}

	UmbraOfFrigidEventide: {
		DisplayName: 凍てつく黄昏の影
		Tooltip:
			'''
			インベントリに所持しているとエネルギーゲージが出現する
			右クリックで最大6連撃の通常攻撃を行う。最初の5回は敵を追尾する矢を、
			最後は敵を貫通する矢を発射する
			追尾矢が当たるとエネルギーを1、貫通矢が当たるとエネルギーを10獲得する
			エネルギーが最大でないときに左クリックで追尾矢を2本発射し、
			最大なら、狩猟の構えを発動し攻撃が変化する
			エネルギーを消費してハンターアローを発射する
			ハンターアローはカーソルから75マス内の敵を最大2体ロックオンし、追尾する
			当たるとその敵に強力な矢の雨で追撃する
			5回攻撃でき、その後は通常状態に戻る
			周囲に敵がおらず、ボス戦中でないなら、エネルギーがゆっくりと回復する
			
			'''
	}

	SkeletonBow: {
		DisplayName: スケルトロンの弓
		Tooltip:
			'''
			左クリックを押し続けてチャージするとダメージと同時発射数が増加
			右クリックで通常の攻撃を行い、スケルトンアローを発射する
			スケルトンアローが当たると、敵を追尾する頭蓋骨を召喚することがある
			'''
	}
}

