			Tooltip: ""
			Label: 無し
		}

		Tooltip: ""
	}

	RadiantCharmNerfSize: {
		None: {
			Tooltip: ""
			Label: 無し
		}

		Medium: {
			Tooltip: ""
			Label: 中
		}

		Large: {
			Tooltip: ""
			Label: 大
		}

		Tooltip: ""
	}

	World: {
		MiscHeader: Misc
		ItemTweaksHeader: Item Tweaks
		GameplayTweaksHeader: Gameplay Tweaks

		debugMode: {
			Tooltip: 開発者で無い限り、有効にしないでください。
			Label: デバッグモード
		}

		lightsWrathDebuffImmunity: {
			Tooltip:
				'''
				光の憤怒は、ナースが治癒できるデバフを無効化します。この効果は、他Modとの競合を引き起こす可能性があります。
				起きた場合は、"低減"または"無し"に設定してください。
				通常：アイテムの使用により受けるデバフ以外の全てのデバフを無効化します。
				低減：外的要因によるデバフを無効化します。(発射体等)
				無し：なんのデバフも無効化しません。
				'''
			Label: 光の憤怒のデバフ無効化の設定
		}

		radiantCharmNerf: {
			Tooltip:
				'''
				燦爛のお守りの武器強化を調整し、他Modとの互換性を向上します。
				無し：ゼニス以降
				中：ムーンロード以降よりちょっと強いぐらい
				大：ムーンロード以降
				'''
			Label: 燦爛のお守りの武器強化の弱体化
		}

		attackDifficulty: {
			Tooltip:
				'''
				ボスの難易度は通常ワールド難易度によって変動しますが、ここで強制的に特定の難易度に変更させることができます。
				ワールド難易度：ボスの難易度はワールド難易度に従います。
				簡単：エキスパート以下の難易度。束の間の光槍は使われず、融解光の命中精度は低下します。
				困難：マスターの難易度。全くの慈悲のない難易度。
				'''
			Label: ボス難易度
		}

		nighttimeTerraprisma: {
			Tooltip: プレイヤーが夜間にノーヒットでエンプレスオブライトを撃破した時、テラプリズマがドロップするようになります。
			Label: テラプリズマの夜間ドロップ
		}

		phasePractice: {
			Tooltip:
				'''
				指定した形態から戦闘が行われ、それが終わると戦闘は終了します。
				-1：通常通り戦闘が行われ、全ての報酬を獲得できます。
				0：開幕（可能な場合。不可能な場合、第一形態が行われます。）
				1：第一形態。
				2：第二形態。
				3：第三形態。(可能な場合、不可能な場合、第二形態が行われます。)
				'''
			Label: 練習モード
		}

		alwaysUseHardAttacks: {
			Tooltip:
				'''
				夜間に日中の攻撃を使用するようになります。
				夜間では、ダメージが大幅に減少し、"破滅"デバフは付与されません。
				この設定が有効な場合、主要な報酬は無効化され、副次的な報酬も減少します。
				'''
			Label: 夜間モード
		}

		DisplayName: ワールド設定
	}

	Client: {
		VisualTweaksHeader: Visual Tweaks

		lightsWrathBeamVolume: {
			Tooltip: 光の憤怒から発射されるビームの音量を調整します。
			Label: 光の憤怒のビームの音量
		}

		skyBrightness: {
			Tooltip: 空が暗くなる演出の度合いを調整します。
			Label: 空の暗さ
		}

		forceFiltersEnabled: {
			Tooltip:
				'''
				光表現の設定がレトロ、またはトリッピーな場合でもフィルターを強制的に有効化するようにします。
				特定のエフェクトが表示されないのを防ぎます。
				他Modが同じような変更をしている場合、この設定を無効にしてください。
				'''
			Label: フィルターの強制適用
		}

		screenShakeIntensity: {
			Tooltip: 画面の揺れ効果の強度を調整します。
			Label: 画面の揺れ効果の強度
		}

		reducedFlashing: {
			Tooltip: 一部の激しい点滅を無効化します。
			Label: 点滅の低減
		}

		glowQuality: {
			Tooltip:
				'''
				特定の光効果の品質の調整。パフォーマンスの向上がわずかに見込めます。
				
				ハイクオリティ：複数の光が重なった際の見栄えが少しだけ向上します。
				通常：デフォルト。
				無効：完全に無効化します。
				'''
			Label: 光演出の品質
		}

		blueFix: {
			Tooltip: 何らかの理由で、tModLoaderは昼間のエンプレスオブライトを青色に表示します。この設定はそれを修正します。
			Label: 青いエンプレスオブライトの修正
		}

		nighttimeGlow: {
			Tooltip: 夜間のボスの発射体にも光演出を適用させます。
			Label: 夜間の光演出
		}

		DisplayName: クライアント設定
	}
}

