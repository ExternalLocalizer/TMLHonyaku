			SignalTowerProgressText: 信号塔設置進行度：{0}/{1}
		}

		Oceanfragments: {
			DisplayName: 海の残片
			Tooltip: 
					'''
					「不思議な小物
					　オールドデュークが興味を示すかもしれない...」
					'''
		}

		OceanRaiders: {
			WorkingText: 動作中...
			NoWaterText: 動作には水の上に設置する必要がある
			NoEnergyText: パワーが不足している
			DisplayName: 海喰らい
			Tooltip:
				'''
				パワーを消費して水域から資源を抽出する
				右クリックで内部ストレージを開くことができる
				'''
		}

		OldDuchest: {
			StorageText: 大型収納チェスト
			DisplayName: オールドデュークのコンテナ
			Tooltip:
				'''
				巨大な容量を持つ収納チェスト
				「オールドデュークの昔のコンテナだ。近くにいると何か放り込むかもしれない...」
				'''
		}

		MermanRod: {
			Text1: マーマンの止まり木はすでにワールドに設置されている。
			DisplayName: マーマンの止まり木
			Tooltip:
				'''
				近くで釣りをするとフィッシングパワーが20向上する
				オールドデュークがここにキャンプを設営する
				'''
		}

		Mewtwo: {
			DisplayName: スーパードリームチップ
			Tooltip: 使用するとハックタイムのチュートリアルを開始する
		}

		GaolCellKey: {
			DisplayName: 深層の牢獄房の鍵
			Tooltip:
				'''
				その場に深層の牢獄房を出現させ、祭壇に休眠状態の頭蓋骨を配置する（テスト用アイテム）
				祭壇に近づくと目覚め、戦闘中は両方の出入口が淡い桃色のエネルギー柵で封鎖される
				深層牢獄の亡霊を倒すと牢獄房は完全に消滅する
				逃げた亡霊は数秒後に再び休眠状態になる
				「鍵を一度回せば、壁は自らの形を思い出す」
				'''
			BuiltHint: 牢獄房が出現した。祭壇の休眠中の頭蓋骨は、あなたが近づくのを待っている。
		}

		RustedGaolIrons: {
			DisplayName: 錆びた牢獄の鉄枷
			Tooltip:
				'''
				防御力が3増加し、ノックバックを無効化する
				ダメージを受けると一時的に移動速度が増加する
				「枷の内側に刻まれた房番号は、すり減って消えている」
				'''
		}

		UndrownedShackleCharm: {
			DisplayName: 沈没者の腕輪
			Tooltip:
				'''
				水中で速度が低下しなくなり、泳ぐ能力を得る
				水中での呼吸時間を大幅に延長する
				「錨は沈んだが、男は息を続けた」
				'''
		}

		GaolAnchorWeapon: {
			DisplayName: 牢獄の錨
			Tooltip:
				'''
				巨大な錨を投げる、壁に突き刺さっている間、鎖が攻撃判定を持つ線になる
				「処刑道具に引退はない」
				'''
		}

		SumpPearl: {
			DisplayName: 沈んだ真珠
			Tooltip:
				'''
				囚人の骨に染み込んだ牢獄の水から凝固した艶消しの真珠
				アンデッド市場で取引されている
				'''
		}

		FloodGalleryKey: {
			DisplayName: 浸水した回廊の鍵
			Tooltip:
				'''
				その場に浸水した回廊を出現させ、錨に繋がれた囚人を配置する（テスト用アイテム）
				「壁の水位目盛りは、彼の心拍記録だ」
				'''
			Placed: 浸水した回廊が出現した。彼を目覚めさせるには、左側の弁の台座に立ち、その場を動かずに待て。
		}

		ProofSealCharm: {
			DisplayName: 検査印の護符
			Tooltip:
				'''
				罠の投射物によるダメージを25%減少させ、15%の確率で不発にする
				「刻印された製品は、どんな機構も妨げず通過する」
				'''
			Misfire: MISS!
		}

		OverseerLogger: {
			DisplayName: 監督官の記録帳
			Tooltip:
				'''
				危険察知能力を得る
				周囲の罠や装置が見えるようになる
				「すべてのダーツトラップの稼働情報を管理している」
				'''
		}

		FloodGalleryKey: {
			DisplayName: 浸水した回廊の鍵
			Tooltip:
				'''
				その場に浸水した回廊を出現させ、錨に繋がれた囚人を配置する（テスト用アイテム）
				「壁の水位目盛りは、彼の心拍記録だ」
				'''
			Placed: 浸水した回廊が出現した。彼を目覚めさせるには、左側の弁の台座に立ち、その場を動かずに待て。
		}

		ProofingHallKey: {
			DisplayName: 検査場の鍵
			Tooltip:
				'''
				その場に検査場を出現させ、埃まみれの装置を吊り下げる（テスト用アイテム）
				「検査の鐘はまだ鳴り響く」
				'''
			Placed: 検査場がその場に出現した。検査を開始するには、左側の受付台に立ち、交代の鐘が鳴り終わるまで動かずに待て。
		}
	}

	Stones: {
		GraniteTome: {
			DisplayName: 花崗岩の魔導書
			Tooltip:
				'''
				詠唱によって3つの力を溜め、緩やかに敵を追尾する花崗岩のエネルギーを3発放つ
				エネルギーは命中時に砕け、敵を追尾する結晶の欠片になる
				'''
		}

		GraniteFlower: {
			DisplayName: 花崗岩の花
			Tooltip:
				'''
				着弾地点で花開き、一定時間残り続けるエネルギーの花を咲かせる結晶の種を投げる
				花は3回脈動し、最も近い敵へ結晶の花弁を撒き散らす
				枯れる際にすべての花弁を砕き、周囲へ結晶の欠片を放つ
				'''
		}

		GraniteThrowingKnife: {
			DisplayName: 花崗岩の投げナイフ
			Tooltip:
				'''
				鋭い青い軌跡を残す貫通ナイフを投げる
				敵に命中すると、近くの別の敵へ小さな連鎖雷撃が発生する
				最後の命中時または地形に当たった時、結晶の欠片へ砕け散る
				'''
		}

		GraniteWalkingBoots: {
			DisplayName: 花崗岩のブーツ
			Tooltip:
				'''
				走行速度と加速力を大幅に増加させる
				最高速度に達すると靴底に電撃が走り、足元に火花を散らしながら青い残像を引いて走る
				'''
		}

		MarbleClub: {
			DisplayName: 大理石の棍棒
			Tooltip:
				'''
				動きは遅いが、強烈な吹き飛ばしを伴う叩き下ろし攻撃を行う
				命中した敵は必ず一時的に石化し、石に縛られたように動きが鈍る
				地面を叩くと衝撃波と舞い上がる砂塵を放つ
				空中で叩きつけた場合は弱い衝撃のみ発生する
				'''
		}

		MarbleHuntingKnife: {
			DisplayName: 大理石の狩猟用ナイフ
			Tooltip:
				'''
				素早い連続斬りを行う
				3回目の攻撃は範囲が広く、前方へ踏み込みながら大理石の欠片を撒き散らす
				'''
		}

		MarbleDisc: {
			DisplayName: 大理石の円盤
			Tooltip:
				'''
				回転する円盤を投げ、敵や壁の間を跳ね返る
				別の敵へ跳ね返るたびに円盤が強化され、ダメージが10%増加する（最大30%）
				跳ね返る回数を使い切ると手元へ戻り、最大2枚まで同時に飛ばせる
				'''
		}

		MarblePebble: {
			DisplayName: 大理石の小石
			Tooltip:
				'''
				無限に使用できる
				地面で1回跳ね返り、最大ライフが高い敵に対して大幅に高いダメージを与える
				巨大な敵に命中すると黄金の光と衝撃を放つ
				'''
		}

		MarbleShield: {
			DisplayName: 大理石の守護盾
			Tooltip:
				'''
				近接攻撃のノックバックを少し増加させる
				周囲を回転する3枚の大理石片が石の盾となり、攻撃を1回防ぐが、防御後に砕け散る
				[KEY]で防御姿勢を取り、ジャストガードに成功すると攻撃を無効化し、周囲の弾を砕いて石の刃として跳ね返す
				ジャストガード成功後、5秒間近接ダメージが10%増加する
				'''
		}

		MarbleBalloon: {
			DisplayName: 大理石の風船
			Tooltip:
				'''
				空中で下キーを押すと急降下し、着地時に衝撃波を放つ
				落下ダメージを無効化する
				'''
		}

		MarbleinaBottle: {
			DisplayName: 大理石入りの瓶
			Tooltip: 重い二段ジャンプを付与する
		}

		MarbleCloudBalloon: {
			DisplayName: 大理石の雲入りの風船
			Tooltip:
				'''
				重い二段ジャンプを付与する
				空中で下キーを押すと急降下し、着地時に衝撃波を放つ
				落下ダメージを無効化する
				'''
		}
	}
}

