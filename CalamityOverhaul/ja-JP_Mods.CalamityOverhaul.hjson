			Tooltip:
				'''
				小さな砂の竜巻を放ち、重力に従って地面へ落下させる
				地面に着くと、壁や段差で方向を変えながら地表を往復する
				命中した敵を繰り返し空中へ打ち上げる
				'''
		}

		SandVortexOfTheDecayedSea: {
			DisplayName: 腐海の砂渦
			Tooltip:
				'''
				カーソル位置に巨大な腐海の渦を呼び出す
				渦は周囲の敵を執拗に引き寄せて切り裂き、敵の投射物すらも分解する
				定期的に追尾する腐海のオーブを外側へ放つ
				もう一度発射すると既存の渦の持続時間を更新し、自然に崩壊するとオーブの輪となって炸裂する
				「腐りゆく深淵の轟音が、砂となって渦巻いた」
				'''
		}

		FocusingGrimoire: {
			DisplayName: 集中の魔導書
			Tooltip:
				'''
				左クリックで敵を追尾する熱輪を放ち、命中した敵をマークする
				右クリックで死の光線を高速連射し、マークされた敵には追加ダメージを与え、必ずクリティカルになる
				「6冊分を合わせるよりも優れている」
				'''
		}

		CommandersStaff: {
			DisplayName: 指揮官の杖
			Tooltip:
				'''
				敵を貫通する熱分解ビームを放つ
				「機械たちから奪ってみたが、もしかしたらディーゼルの代わりに超能力を使えるかもしれない」
				'''
		}

		Eyetooth: {
			DisplayName: 眼牙
			Tooltip:
				'''
				クトゥルフの目から引きちぎった牙を敵へ投げつける
				敵に噛みつくと、牙がその頭上へ跳ね上がって狙いを定め、急降下して2度目の噛みつきを行う
				急降下攻撃は150%のダメージを与え、牙による傷からは血が流れ続ける
				'''
		}

		CommandersStaffEX: {
			DisplayName: 指揮官の杖EX
			Tooltip:
				'''
				広がる熱ビームを複数発射する
				「金属切断に最適」
				'''
		}

		TomeofFungalDecay: {
			DisplayName: 腐れキノコの魔導書
			Tooltip: 胞子を炸裂させる
		}

		Pandemonium: {
			DisplayName: パンデモニウム
			Tooltip:
				'''
				左クリック長押しで超越魔法をチャージし、離すと放つ
				右クリックでカーソル位置に煉獄のルーンを発動する
				持っている間、画面左下に2つのスキルボタンが表示される
				クリックすると硫黄の裁き、またはすべての悪魔の終焉を放つ
				'''
			SkillLeftName: 煉獄の裁き
			SkillLeftDesc: カーソル周辺に煉獄の炎柱を次々と降らせる
			SkillRightName: すべての悪魔の終焉
			SkillRightDesc: 自身を中心に巨大な魔法陣を展開し、その中にいる敵を雷と炎で打ちのめす
		}

		Elysium: {
			DisplayName: エリュシオン
			Tooltip:
				'''
				左クリック長押しで蛇の儀式を行う
				離すと聖なる光の波を放ち、触れた弱い敵を聖なる蛇へ変えて味方として敵を追わせる
				右クリックで近くの町の住人を聖別し、弟子として自分のもとへ呼び寄せる
				弟子はそれぞれ異なる役職に就きながら自分の周囲を回り、聖なる加護を与える
				ボスからダメージを受けると弟子が1人犠牲になり、殉教の力を1つ残す
				殉教の力が11あり、ヨハネが役職に就いていると、スキルボタンから啓示を解き放てる
				啓示が降りると、右クリックで代わりに四騎士を召喚する
				その後、スキルボタンが天の隕石と最後の封印の審判に変わる
				12の席がすべて埋まると加護は頂点に達するが、死が近づくとユダの刃が待っている
				持っている間にShiftを長押しするとホイールが開き、スロットをドラッグして役職を入れ替えられる
				持っている間、画面左下に2つのスキルボタンが表示される
				'''
			SkillLeftName: 神聖なる雷
			SkillLeftDesc: カーソルに最も近い敵へ聖なる雷を落とす
			SkillRightName: 最後の封印の審判
			SkillRightDesc: 第五、第六、第七の封印を順番に破り、最後にすべての敵を裁いて啓示を終わらせる
			SkillRightLockedDesc: 啓示が降りた後でのみ封印を破れる
			SkillOpenName: 啓示を解き放つ
			SkillOpenDesc: ヨハネは殉教によって昇り、王国の領域が降りてくる
			SkillMeteorName: 天の隕石
			SkillMeteorDesc: 天から天体をカーソル位置へ落とす
			NoConvertTargetText: 近くに聖別できる住人がいない
			SeatsFullText: 12の席がすべて埋まっている
			JudasDeathReasonText: "{0}はユダに銀貨30枚で売り渡されました。"
			DiscipleName_0: ペテロ
			DiscipleName_1: アンデレ
			DiscipleName_2: ヤコブ
			DiscipleName_3: ヨハネ
			DiscipleName_4: フィリポ
			DiscipleName_5: バルトロマイ
			DiscipleName_6: トマス
			DiscipleName_7: マタイ
			DiscipleName_8: 小ヤコブ
			DiscipleName_9: タダイ
			DiscipleName_10: 熱心党のシモン
			DiscipleName_11: ユダ
		}

		AriaofTheCosmos: {
			DisplayName: アリア・オブ・ザ・コスモス
			Tooltip:
				'''
				左クリック長押しで星々の輝きを凝縮したエネルギーをチャージし、離すと壊滅的なダメージを与える
				右クリックで小型ブラックホールを放ち、形成されると大量のガンマ線を放射する
				持っている間、画面左下に2つのスキルボタンが表示される
				クリックすると星輪の守護者を召喚するか、超高エネルギーを発生させる
				'''
			SkillLeftName: 星輪の守護者
			SkillLeftDesc: 周囲を回転する星輪を召喚し、その節から近くの敵へ星屑を連射する
			SkillRightName: 超高エネルギー
			SkillRightDesc: 短時間チャージした後、カーソル方向へ9本のエネルギーを扇状に放つ
		}

		WheezingWyrm: {
			DisplayName: 喘鳴する竜
			Tooltip:
				'''
				押し続けると竜の炎を吐き出す
				頭部は古びており、炎を出す前に何度か咳払いをする必要がある
				吐き続けるほど喉が熱くなり、鈍い赤色から焼け付く青色へ変化する
				明るい炎ほど高温になり、青い炎は最大ダメージを与え地獄の炎を発生させる
				「死んだわけではない、ただ老いた喫煙者が喉を整えているだけだ」
				'''
		}

		Everdeep: {
			DisplayName: 永遠の深淵
			Tooltip:
				'''
				高圧の深淵の水の輪を放つ
				輪は敵を貫通し、少し進んだ後に弧を描いて戻り、再び攻撃する
				命中するたびに深淵の共鳴が蓄積し、書物の周囲を漂う水滴の数で確認できる
				共鳴が最大になると、標的の足元から巨大な渦潮が噴き上がる
				「深海はお前のために道を開けるのではない。通り過ぎた後に閉ざされるのだ」
				'''
		}

		BloomTome: {
			DisplayName: 開花の魔導書
			Tooltip:
				'''
				蕾の魔法を放つ
				魔法は敵または地面に命中すると花弁の輪へ開花する
				4回目の詠唱は完全に開花し、より多くの花弁を放ちながら2本の針を上方向へ発射する
				「どのページを開いても、そのページは花開く」
				'''
		}
	}

	Melee: {
		DivineSourceBlade: {
			DisplayName: 神源の刃
			Tooltip:
				'''
				4連撃コンボ：反時計回りの斬撃、時計回りの斬撃、
				その後に広範囲の楕円斬りと、同じ軌道をなぞる逆斬りを繰り出す
				すべての斬撃は刃の軌道に沿って敵を追尾する光弾を放ち、逆斬りでは巨大な蒼い三日月状の斬撃を放つ
				敵にダメージを与えるとチャージが蓄積する
				右クリックで最大まで溜めたチャージを消費し、7秒間刃を強化する
				強化中はダメージが大幅に上昇し、光弾が最大3体を貫通する巨大な黄金の槍へ変化する
				「生命は決して途絶えない」
				'''
		}

		CursedflameBloodfist: {
			DisplayName: 呪炎の血拳
			Tooltip:
				'''
				近接と魔法の両方として扱われ、それぞれのボーナスを受ける
				左クリック長押しで高速の連続パンチを繰り出し、その間も走り続けられる
				パンチ1発ごとに周囲へ非常に低いノックバックの範囲ダメージを与える
				さらにパンチ1発ごとにカーソル方向へ飛翔する炎の拳を連続して放つ
				命中した対象を呪炎で燃やす
				連続攻撃中はマナを消費し、マナが尽きると停止する
				「この腕が誰のものだったとしても、炎がそれを焼き尽くしてしまった」
				'''
		}

		Arbiter: {
			DisplayName: 審判者
			ManifestInteractHint: "[Right Click] 斧を引き抜く"
			ManifestInventoryFullHint: インベントリがいっぱいです。空きスロットを確保してください。
			Tooltip:
				'''
				左クリック長押しで力を溜め、審判の斧を掲げる
				離すと斧を振り下ろし、地面に沿って進む炎の衝撃波を左右へ放つ
				長く溜めるほど炎の射程と威力が増加する
				「炎を通じて、審判は下される」
				'''
		}

		Cloudwalking: {
			DisplayName: 雲渡り
			Tooltip:
				'''
				左クリック長押しで大斧を掲げて力を溜める
				離すと斧を前方へ投げ、通った軌跡に雲を残す
				斧は自動的に手元へ戻る
				'''
		}

		DawnshatterAzure: {
			DisplayName: 暁砕の蒼
			Tooltip:
				'''
				左クリック長押しで五連撃を繰り出し、最後の回転斬りで灼熱の光輪を展開する
				右クリックでチャージし、カーソル方向へ突進する
				「炎に魂を浄化させ、敵からすべてを奪い尽くせ」
				'''
		}

		Flawless: {
			DisplayName: 完全無欠の槍
			Tooltip:
				'''
				4連撃コンボ：薙ぎ払い、突き、逆薙ぎ、最後に突進斬りを繰り出し、攻撃するたびに威力が増す
				突き攻撃では細身の刃へ切り替わり、攻撃範囲が広がる
				命中時に氷晶を撒き散らす
				「彼は7回刃先を変えた。標的に残った穴は1つだけ」
				'''
		}

		StormGoddessSpear: {
			DisplayName: 嵐の女神の槍
			Tooltip:
				'''
				敵に跳ね返る強烈な雷撃を放つ槍
				持っている間、嵐の女神の残留思念を呼び出し、戦闘を支援させる
				[legend]
				'''
			Legend:
				'''
				アリナはかつて、テラで最も優れた戦士の一人だった。
				雷の刃を携え、闇を切り裂くその姿は、誰もが畏敬の念を抱くほどだった。
				彼女の信仰は揺るぎなく、絶対のものだった。
				だが、その信仰は神々の無慈悲な沈黙から彼女を救うことはできなかった。

				最高神が裁きを下した時、彼女の仲間も、家族も、誓いも、築き上げた栄光も、すべて灰へと変わった。

				彼女は目の当たりにした。
				正義と呼ばれたものが、すべてを踏みにじり、塵へ変える姿を。
				秩序とは、最も残酷な破壊を覆い隠すための仮面に過ぎなかった。

				彼女はもはや光を求めなかった。
				代わりに、深淵の中で己を鍛え続けた。
				古き禁断の力は彼女の魂を喰らい、人の領域を遥かに超えた力を授けた。
				その鎧は深淵の底で鍛え直された残骸となり、その瞳には、消えゆく雷と闇が絡み合った炎が宿った。

				彼女はもはやテラの守護者ではない。

				彼女こそが嵐そのもの...
				止めることのできぬ復讐の化身だった。
				彼女の怒りは荒れ狂う嵐となって戦場を覆い、その雷鳴は王座を砕き、神殿を引き裂いた。

				彼女は正義のために戦ったのではない。テラのためでも、神々のためでもない。

				彼女が求めたものはただ一つ。

				復讐。そして滅亡。

				自らを正しいと信じる者たちに、真の恐怖とは何かを理解させるために。
				'''
		}

		DragonsScaleGreatsword: {
			DisplayName: 龍藻の大剣
			Tooltip:
				'''
				3連撃を繰り出す
				3段目では強力な竜の一撃を放つ
				斬撃から螺旋状の海藻のエネルギーを放ち、命中時に毒性の雲へ変化する
				真の近接攻撃が大量の毒雲を生成する
				右クリックで緑色の竜の魂を召喚し、カーソルへ向かって敵を追尾しながら進み、軌道上に毒雲を撒き散らす
				'''
		}

		CosmicCalamity: {
			DisplayName: 銀河の災厄
			Tooltip: 攻撃時に三日月型の衝撃波を発生させる
		}

		SpearOfLonginus: {
			DisplayName: ロンギヌスの槍
			Tooltip:
				'''
				持っている間、足元に聖なる十字架が現れ、徐々に神聖な力が蓄積される
				ゲージが満タンになるたびに槍が1チャージを獲得し、最大6段階まで聖なる力を蓄えられる
				持っている間、最も近い敵に運命の十字架を刻む
				印を刻まれた敵へチャージ済みの投擲を命中させると、巡礼者の怒りを解き放つ
				[legend]
				'''
			Legend:
				'''
				砕け散りし神よ、どうか我が罪を贖う機会を与え給え。

				戦争は幾世紀にも渡り続いた。
				私は偉大なる文明より逃れた追放者として、宇宙の果てにある荒廃した惑星で朽ちゆく時を過ごしている。

				数千光年彼方では、巨大なる戦争機械が星々を砕き、銀河を戦火に染めている。
				その破壊は瞬く間に星々の輝きを奪い去り、後には永遠の闇と静寂だけが残される。

				この戦争は数え切れぬ時を越えて続いてきた。
				そして今、我が属する偉大なる文明は滅亡の淵へ追いやられている。

				私は宇宙の罪人に、
				そして、この至高なる存在へ刃を向ける、歴史上最も不敬なる冒涜者となろう。

				肉体は朽ち果て、骨は過ぎ去りし時代の刻印のように老いていく。
				やがて私は、自らが生み出した脆弱なる機械の一つへ成り果てるだろう。

				その運命が訪れる前に、どうか神々よ、我が罪を赦し給え。
				この至高なる存在への冒涜を、どうか赦し給え。

				たとえ我が魂が奈落へ沈み、永劫の苦痛に囚われるとしても。
				我は文明のため、この幾世紀にも及ぶ戦争の勝利のために、この神なる存在の砕け散った力を手にしなければならない。

				その神秘なる力を導くため、我は砕け散った神の肉体へ冷たき機械の力を宿すほかなかった。

				これは避けられぬ冒涜である。
				文明を存続させるため。
				この戦争に勝利するため。

				我はこの至高なる存在に仕える最も敬虔なる信徒に、
				そして同時に、歴史上最も不敬なる冒涜者となろう。
				'''
		}

		NeutronGlaive: {
			DisplayName: ブラックゾーンクリーバー
			Tooltip:
				'''
				振るうと強力な斬撃波を放ち、敵に命中すると爆発を引き起こす
				右クリックで刃をチャージし、最大まで溜めて離すとカーソル位置に巨大な爆発を発生させる
				最大チャージ前に離すと、エネルギーが漏れ出してしまう
				'''
		}

		NeutronScythe: {
			DisplayName: 惑星の使者
			Tooltip:
				'''
				高速回転する中性子の鎌を放ち、周囲の敵へガンマ線を放射しながら、軌道上に爆発を残す
				右クリックでブラックホールバーストを発動し、13本の鎌を全方位へ放つ
				'''
		}

		RebelBlade: {
			DisplayName: 反逆の刃
			Tooltip:
				'''
				近接攻撃は敵の周りに大量の悪魔の光を生成する
				右クリックで刃を操作し、カーソル方向へ飛ばして斬りつけることができる
				'''
		}

		WeaverGrievances: {
			DisplayName: ウィーバーの遺恨
			RitualInteractHint: "[Right-click]刀を引き抜く"
			RitualInventoryFullHint: インベントリがいっぱいです。空きスロットを確保してください。
			Tooltip:
				'''
				大量の悪霊の爪を解き放ち、地底世界やダンジョンでは特殊な効果を発揮する
				3連撃コンボを繰り出し、3段目では広範囲の旋風斬りを放つ
				右クリックでカーソル方向へ転がり、怨霊の輪となって突進する
				突進中に敵へ接触すると無敵時間を得る
				敵の近くをすり抜けるように回避すると、ジャスト回避として扱われる
				[legend]
				'''
			Legend:
				'''
				永劫の地下牢は大地を横断するほど広がり、その壁には古代の戦士たちの碑文と絶叫が刻まれている。
				一つ一つの石は残留する悪意に満ちており、滅びゆく時の果てへ縛り付ける呪われた鎖のようだった。

				かつて、この戦士たちは王に仕える刃であり、数多の世界で戦を繰り広げていた。
				彼らの剣は無数の戦場を照らし、その血は偉大なる帝国の礎となった。
				彼らの忠誠は星々のように永遠であり、その信念は鉄のように揺るがなかった。
				しかし戦争が終わり、魔王の旗が王の足元で引き裂かれた時。
				平和が訪れた瞬間、王は彼らを深淵へ送ることを命じた。

				「我らは裏切っていない。だが、王が我らを裏切ったのだ」

				亡き者たちの悲痛な叫びは虚空を引き裂き、永遠の静寂を貫いた。
				彼らの高潔なる魂は塵へ還ることなく、虚無の裂け目へ囚われ、永遠の闇を見届ける存在へと堕とされた。
				絶え間ない嘆きは静かな告発へと変わり、その声は星々の果てへ届いた。
				王は彼らの揺るがぬ忠誠と燃え上がる憤怒を恐れ、魔王の魔術師たちの囁きに従ったと言われている。

				そして彼らを歴史の影へ葬り去ることを選んだ。
				だが、悪意は潮のように地下牢の現実を歪めた。
				彼らの苦痛は時空の境界を揺るがし、復讐の予言を紡ぎ出した。

				「魔王は帰還する。虚空は引き裂かれ、我らの怒りがすべてを喰らう」

				再びテラが滅亡の瀬戸際に立たされた時。
				安らかに眠れぬ死者たちは闇から蘇る。
				彼らの刃はもはや帝国の栄光のためではなく、裏切り者へ裁きを下すために振るわれる。
				栄光も忠誠も、とうに失われた。
				残されたのは、すべてを焼き尽くす復讐の炎だけである。
				'''
		}

		SandDagger: {
			DisplayName: 砂の短剣
			Tooltip:
				'''
				一直線に投げ、重力によってわずかに落下する
				命中すると突き刺さり、砂へ刺さった場合は力を蓄積してから地面を突き破り、衝撃波と砂の棘を大量に放つ
				'''
		}

		WastelandFang: {
			DisplayName: 荒野の牙
			Tooltip:
				'''
				ブロックに跳ね返り、戻ってくる時に加速する
				口を開いて複数の砂のオーブを吐き出す
				'''
		}

		SeasonalKunai: {
			DisplayName: 四季のクナイ
			Tooltip:
				'''
				4本のクナイを扇状に投げる
				各クナイは深く貫通し、飛行するほど巨大化する
				命中または消滅時、すべての刃が3本のクナイへ分裂し、周囲へ広がる
				昼は暁光、夜は夜陰の力を宿す
				「四季を映し出す」
				'''
		}

		WraithKunai: {
			DisplayName: 怨霊のクナイ
			Tooltip:
				'''
				3本の紅いクナイを扇状に投げる
				各クナイは短時間滞空した後、最も近い敵へ高速で飛んでいく
				突進攻撃は紅い火花を発生させ、最終的に魂を焼き尽くす衝撃波へ変化する
				昼は炎上、夜は魂の焼却を敵へ付与する
				'''
		}

		CommandersChainsaw: {
			DisplayName: 指揮官のチェーンソー
			Tooltip:
				'''
				命中時に火花を発生させる
				「もっとディーゼルを注げ」
				'''
		}

		GeminisTribute: {
			DisplayName: 双子の賛歌
			Tooltip:
				'''
				高速回転するレティナイザーの鎌とスパズマティズムの鎌を交互に投げる
				右クリックで2本の鎌を交差する軌道で放ち、命中時に融合した双子の目を形成して周囲へ2色の弾幕を発生させる
				「支配的な人格は一つしか存在できない...そして勝ったのはマグマフレイム・アイだ」
				'''
		}

		DestroyersBlade: {
			DisplayName: デストロイヤーブレード
			Tooltip:
				'''
				熱エネルギーの弾幕を放つ
				「デストロイヤーの強大なエネルギーコアを内包している」
				'''
		}

		Observer: {
			DisplayName: オブザーバー
			Tooltip: '''「まだお前を見ている」'''
		}

		Shatterfang: {
			DisplayName: 砕牙
			Tooltip:
				'''
				3連撃のあとに刀身を大きく削る強烈な薙ぎ払いを繰り出す
				刀身を削り切ると刀は完全に砕け、大きな折れた牙の破片を勢いよく放つ
				通常攻撃では時折、重力に縛られた小さな牙の破片を飛ばす
				刀身が半分になった剣は振る速度が上昇するが、ダメージが低下し、破片も放たなくなる
				攻撃を続けると刀身は徐々に不安定になり、最後には静かに崩れ落ちる
				右クリックで時間をかけて刀身を修復でき、納刀中もゆっくり修復される
				完全に修復すると効果音が発生する
				「噛み砕く大口から折れた牙
				　それでもなお噛みつくことを望んでいる」
				'''
		}

		CommandersClaw: {
			DisplayName: 指揮官の爪
			Tooltip:
				'''
				常に刃を前方へ向ける装飾された槍を投げる
				命中時に金属の火花と衝撃波を発生させる
				複数の槍を同時に飛ばすことができ、壁に当たると地形へ突き刺さり、敵に命中するとその場へ縫い留める
				'''
		}

		CommandersChainsawEX: {
			DisplayName: 指揮官のチェーンソーEX
			Tooltip: '''「進む道のすべてを切り裂く」'''
		}

		DestroyersBladeEX: {
			DisplayName: デストロイヤーブレード EX
			Tooltip:
				'''
				強烈な斬撃から黒紅色の斬撃波、エネルギービーム、影の弾丸を放つ
				一時的に刃を納めると追跡プロトコルが起動し、移動速度が上昇する
				追跡中は右クリックでデストロイヤーの顎となり、獲物へ噛みつくが、対象がいない場合はカーソル方向へ突進する
				噛みつきに成功すると大ダメージを与え、殲滅プロトコルを起動する
				すべての弾丸が敵を追尾するようになり、フィニッシャーではデストロイヤーの頭部を放つ
				「破壊することは、創造することよりも容易だ」
				'''
		}

		EnergySword: {
			DisplayName: エネルギーソード
			Tooltip:
				'''
				電力を消費してレーザーを発射する
				複数の敵を貫通する
				「電気代はあまり高くない」
				'''
		}

		SporeboundRoller: {
			DisplayName: 胞子ヨーヨー
			Tooltip:
				'''
				敵に命中すると、小さな浮遊キノコを生成する
				「いつまでも転がっていたいらしい」
				'''
		}

		SporeburstPouch: {
			DisplayName: 胞子爆袋
			Tooltip:
				'''
				投げると着弾地点で胞子を爆発させる揮発性の袋
				ステルス攻撃ではより大きな胞子爆発と追尾する胞子霊群を放つ
				'''
		}

		Heartcarver: {
			DisplayName: 心喰らいの刃
			Tooltip:
				'''
				周囲に3本の儀式の短剣を生み出し、回転させる
				チャージ完了後、標的へと飛んでいく
				右クリックで近距離の突きを放つ
				'''
			CarveTip:
				'''
				持っている間、刀身が心臓の鼓動に合わせて脈打つ
				2回の鼓動の間に攻撃を当てると「心臓刻み」になる
				コンボの最後を「心臓刻み」で決めると、心臓を丸ごと抉り出す
				'''
		}

		OniMachete: {
			DisplayName: 鬼の鉈
			Tooltip:
				'''
				構えると六本の鬼の手が現れ、共に戦う
				真・近接攻撃時に鬼火を放つ
				'''
			SuppressTip:
				'''
				振るって攻撃を当てるたびに煉獄の抑制が強まり、6本の鬼の手が攻撃するたびに炎上させる
				炎が消えると鬼の手が暴れ始め、攻撃が激しくなり、稀に戻ってきてプレイヤーの首を絞める
				'''
		}

		AncientStormGoddessSpear: {
			DisplayName: 古代の嵐の女神の槍
			Tooltip:
				'''
				敵に跳ね返る強烈な雷撃を放つ槍
				「過去の遺物だが、まだ使えるようだ」
				[legend]
				'''
			Legend:
				'''
				アリナはかつて、テラで最も優れた戦士の一人だった。
				雷の刃を携え、闇を切り裂くその姿は、誰もが畏敬の念を抱くほどだった。
				彼女の信仰は揺るぎなく、絶対のものだった。
				だが、その信仰は神々の無慈悲な沈黙から彼女を救うことはできなかった。

				最高神が裁きを下した時、彼女の仲間も、家族も、誓いも、築き上げた栄光も、すべて灰へと変わった。

				彼女は目の当たりにした。
				正義と呼ばれたものが、すべてを踏みにじり、塵へ変える姿を。
				秩序とは、最も残酷な破壊を覆い隠すための仮面に過ぎなかった。

				彼女はもはや光を求めなかった。
				代わりに、深淵の中で己を鍛え続けた。
				古き禁断の力は彼女の魂を喰らい、人の領域を遥かに超えた力を授けた。
				その鎧は深淵の底で鍛え直された残骸となり、その瞳には、消えゆく雷と闇が絡み合った炎が宿った。

				彼女はもはやテラの守護者ではない。

				彼女こそが嵐そのもの...
				止めることのできぬ復讐の化身だった。
				彼女の怒りは荒れ狂う嵐となって戦場を覆い、その雷鳴は王座を砕き、神殿を引き裂いた。

				彼女は正義のために戦ったのではない。テラのためでも、神々のためでもない。

				彼女が求めたものはただ一つ。

				復讐。そして滅亡。

				自らを正しいと信じる者たちに、真の恐怖とは何かを理解させるために。
				'''
		}

		Abyssrend: {
			DisplayName: 深淵裂き
			Tooltip:
				'''
				左クリックで先端突きと横薙ぎを交互に繰り出し、攻撃するたびに敵を追尾する海流の刃を放つ
				右クリックで深淵の引き潮を発生させ、前方の敵をハサミへ引き寄せて地面へ叩きつけ、爆発を起こす
				叩きつけや爆発を受けた敵は深海の圧力に沈み、大幅に動きが鈍る
				「深海が何かを砕く音を、こいつは覚えている」
				'''
		}

		TideReaper: {
			DisplayName: 潮断ちの鎌
			Tooltip:
				'''
				回転する深淵の鎌を投げる
				投擲中は、周囲の敵を追尾する潮の三日月状の斬撃を放つ
				右クリックで渦潮の錨を投げると、鎌が前方に固定され、渦潮を発生させる
				渦潮は敵を中心へ引き寄せ、鎌が戻るまで三日月状の斬撃をより高速で放つ
				「潮が引いた後、浜に残るのは骨だけだ」
				'''
		}

		BudPiercer: {
			DisplayName: バッドピアサー
			Tooltip:
				'''
				しばらく直進した後、下降する
				敵に命中すると蕾を植え付け、やがて花弁の輪へと開花する
				同じ敵に複数の短剣を命中させることで、蕾の効果を蓄積できる
				地面に突き刺さるとその場で開花し、3本の針を上方向へ放つ
				「蛇の鱗の下では、全てが花開くことを望んでいる」
				'''
		}

		Budcrown: {
			DisplayName: 蕾の王冠
			Tooltip:
				'''
				攻撃キーを長押しすると頭部を周囲で回転させ、離すとカーソル方向へ投げる
				頭部は敵に命中すると針を撒き散らす
				3回目の命中時、完全開花して強いノックバックを伴う花弁の輪を放つ
				「最も重い蕾ほど、最も大きく咲き誇る」
				'''
		}
	}

	Ranged: {
		AnnihilatingUniverse: {
			DisplayName: 宇宙の殲滅者
			Tooltip:
				'''
				敵に命中した地点に輝く星を残す
				右クリックで神喰らいの力を解放し、敵を破壊する
				'''
		}

		BarrenBow: {
			DisplayName: 荒涼の弓
			Tooltip: 放たれた矢は敵に命中すると荒涼のエネルギーを放出する
		}

		AvalancheM60: {
			DisplayName: アヴァランチM60
			Tooltip:
				'''
				雪玉を弾薬として使用する
				雪玉を連続発射し、弾薬が減るほど火力が上昇する
				20発ごとにオーバードライブが発動し、小さな雪崩を引き起こす
				「デンジ！雪合戦だ！」
				'''
		}

		CrystalDimming: {
			DisplayName: クリスタルディミング
			Tooltip:
				'''
				雪玉を弾薬として使用する
				着弾地点から氷筍を地面に突き出させる結晶を放つ
				既存の結晶の近くで発生させると、氷筍がより高く成長する
				右クリックで氷筍を地形に沿って発生させる
				「大地はすべての霜を覚えている」
				'''
		}

		DarkFrostSolstice: {
			DisplayName: ダークフロストキャノン
			Tooltip:
				'''
				雪玉を弾薬として使用する
				雹と極寒の炎を放つ
				20発ごとにオーバードライブが発動し、マウスカーソル地点に冬の神威を呼び起こす
				'''
		}

		SnowQuay: {
			DisplayName: スノーヴァイパーM16
			Tooltip:
				'''
				雪玉を弾薬として使用する
				左クリック長押しで敵へ雪を放つ
				吹雪が内部機構に蓄積される
				十分に圧力をかけてから左クリックを離すと、圧縮された雪を発射する
				「冬の楽しみは雪かきから始まる」
				'''
		}

		NeutronBow: {
			DisplayName: ロシュの弦
			Tooltip:
				'''
				標的に命中時にガンマ線を生成する重力の矢を放つ
				右クリックで3段階のチャージを行い、最大まで溜めると強力な重力の矢を3本放つ
				'''
			Lang1: 重力を捕らえている...
			Lang2: 重力を屈服させている...
			Lang3: Finished!!
		}

		NeutronGun: {
			DisplayName: ステラーハンター
			Tooltip:
				'''
				重力弾を放ち、命中地点にワープポイントを生成する
				右クリックで狙撃モードに切り替え、より強力な重力弾を放つ
				命中時にガンマ線を発生させる
				射撃するたびに銃がチャージされ、最大まで溜まると次の射撃でカーソル地点に爆発を引き起こす
				「太陽を撃ち落とせ！」
				'''
		}

		MG42: {
			DisplayName: MG42
			Tooltip:
				'''
				連続射撃で銃身が過熱する
				マスケット弾を徹甲弾へ変換する
				'''
		}

		SnowQuayMK2: {
			DisplayName: スノークエイMK2
			Tooltip:
				'''
				雪玉を冷却・圧縮して高速氷柱へ変換する装置を搭載した軍用改修型
				雪玉を弾薬として使用する
				左クリックで3点バースト射撃を行い、最後の1発は結晶を撒き散らす大きな氷柱になる
				右クリックで近距離へ氷柱をばら撒き、過剰な圧力を放出する
				「第2世代スノーヴァイパーは予熱を必要としない」
				'''
		}

		Starship: {
			DisplayName: スターシップ
			Tooltip:
				'''
				連続射撃で熱が蓄積し、時間経過で発射速度が上昇する
				右クリックで弾薬を消費して彗星の弾を装填し、次の射撃で大ダメージを与え極限分解を付与する
				最大加熱時には護衛機2機が飛来し、追尾する星を発射し、さらに背後から惑星が定期的に放たれる
				トリガーを離すと防御力を無視する追尾する隕石14個と小銀河がカーソル地点へ降り注ぐ
				'''
		}

		DuneStalker: {
			DisplayName: 砂丘の追跡者
			Tooltip:
				'''
				弾薬を消費する代わりに、鎖で繋がれた鉤爪を発射する
				鉤爪は軌道上の敵を貫き、命中時または最大射程到達時に自動で戻ってくる
				'''
		}

		Snowblindness: {
			DisplayName: スノーブラインドネス
			Tooltip:
				'''
				雪玉と凍てつくビームを発射する
				敵に命中すると複数の特殊な冷凍ビームが放射状に広がる
				「吹雪の中で迷い、永遠の静寂、苦痛の地図、カーブでの追い越し、
				　ひび割れた鏡、乾いた血痕、赤い氷、泣き叫ぶビーバー、氷の中の影たち」
				'''
		}

		RaiderGun: {
			DisplayName: レイダー
			Tooltip:
				'''
				マスケット弾を高速弾へ変換する
				右クリックでローリングダッシュを行い、弾倉を再装填する
				ローリング後に発射する最初の弾はデストロイヤーグレネードへ変化する
				「屋内の人質救出に最適」
				'''
		}

		HyperionBarrage: {
			DisplayName: ハイペリオンオートタレット
			Tooltip:
				'''
				着弾時に爆発し敵を炎上させるミサイルを発射する
				4回目の射撃ごとに3発のミサイルを垂直発射し、照準地点へ砲撃する
				「すべてを最大限に活用しろ」
				'''
		}

		RaiderGunEX: {
			DisplayName: レイダー EX
			Tooltip:
				'''
				マスケット弾を高速弾へ変換する
				さらに追尾するデストロイヤーミサイルを大量発射する
				右クリックでローリングダッシュを行い、弾倉を再装填する
				ローリング後に発射する最初の弾はデストロイヤーグレネードへ変化する
				「絨毯爆撃」
				'''
		}

		Dicoria: {
			DisplayName: ディコリア
			Tooltip:
				'''
				2発の弾丸を同時発射し、チャージ可能
				最大チャージ時、熱線を放つ
				「斜視になりそうだ」
				'''
		}

		BloodshotBomb: {
			DisplayName: ブラッドショットボム
			Tooltip:
				'''
				手に持った瞬間に導火線へ火が付き、約2秒ごとに燃焼状態が変化する
				導火線が短いほど目は赤く染まり、爆発は激しくなり、肉片をより遠くへ吹き飛ばす
				左クリックでいつでも投げられ、接触すると爆発する
				肉に食い込んだ時のみ破片を撒き散らす
				持ち続けて導火線が燃え尽きると、手元で爆発する
				「あなたから離れることに耐えられない」
				'''
			SelfBoom: "{0}は見つめすぎました。"
		}

		LaserPistol: {
			DisplayName: レーザーポイント
			Tooltip:
				'''
				電力を消費してレーザーを発射する
				複数の敵を貫通する
				「使用率はあまり高くない」
				'''
		}

		HyperionBarrageEX: {
			DisplayName: ハイペリオンバラージ EX
			Tooltip:
				'''
				着弾時に6発の自動追尾クラスター爆弾へ分裂する大型巡航ミサイルを発射する
				「本来の用途を超えている」
				'''
		}

		SporeBubbleBlaster: {
			DisplayName: 胞子ブラスター
			Tooltip: 胞子を連続して噴射する
		}

		FungalRevolver: {
			DisplayName: キノコリボルバー
			Tooltip:
				'''
				マスケット弾をキノコ弾へ変換する
				「掃除したら余計にひどくなった」
				'''
		}

		Pallbearer: {
			DisplayName: 棺担ぎの弩
			Tooltip:
				'''
				左クリック長押しでチャージし、離すと「棺担ぎの矢」を放つ
				チャージが長いほど矢の威力が増す
				右クリックで弩を投げ、敵に命中すると次の射撃が大幅に強化される
				「別名：棺を運ぶ者」
				'''
		}

		UniversalFrost: {
			DisplayName: ユニバーサルフロスト
			Tooltip:
				'''
				雪玉を弾薬として使用する
				左クリックで霜の輝きを高速発射し、射撃するたびに氷霜のドームをチャージする
				最大までチャージすると、右クリックでカーソル地点の上空にオーロラを展開し、下にいる敵へ氷の槍が降り注ぐ
				「すべての創造が静まり返った時、空を流れ続けるのはオーロラだけ」
				'''
		}

		SneezingWyrm: {
			DisplayName: 嚔する竜
			Tooltip:
				'''
				灼熱の炎を高速で連射する
				連続射撃すると銃身が熱を帯び、弾道は橙色から青白く変化していく
				蓄えた息を吐くたび、竜は射線上へ蛇行しながら敵を追尾する竜炎を放つ
				煙が老いた鼻を刺激し、時折くしゃみをして横方向へ濃い煙を噴き出す
				「くしゃみをする側には立つな」
				'''
		}

		TiroFinale: {
			DisplayName: ティロ・フィナーレ
			Tooltip:
				'''
				遠距離ダメージと魔法ダメージの両方の強化効果を受ける
				射撃すると弾薬とマナを消費し、撃つたびに黄金の幻影のマスケット銃が自身の周囲を旋回する陣形へ加わる
				射撃を続けている間、幻影のマスケット銃は順番にカーソルへ狙いを定め、一発ずつ響かせた後、光となって消滅する
				右クリックで4丁以上の幻影のマスケット銃を凝縮し、巨大な砲身へ姿を変えてフィナーレを発動させる
				「礼儀を忘れず、最後の幕を壮大に飾れ」
				'''
		}

		Undertow: {
			DisplayName: 深海の引力
			Tooltip:
				'''
				どんな矢も深淵の棘へ変化させる
				命中時、その軌跡に水圧による気泡を発生させ、破裂時に追加爆発を起こす
				右クリック長押しでチャージし、最大まで引き絞って離すと3倍の威力を持つ深圧の棘を放つ
				強化された棘はすべてを貫通し、敵を軌道上へ引き寄せる
				停止すると爆発を起こす
				「海はお前を押し返すのではない。深淵へ引き込むのだ」
				'''
		}

		Thornstring: {
			DisplayName: 茨の弦
			Tooltip:
				'''
				あらゆる矢を棘の矢へ変化させる
				棘の矢は命中時、左右へ短い針を炸裂させる
				右クリック長押しで完全に引き絞り、2.5倍ダメージの貫通する棘矢を放つ
				重棘矢は命中時と着弾地点で花弁の輪を開花させる
				「弦は蔓、矢は棘、弓は枯れることを拒む花」
				'''
		}
	}

	Scenarios: {
		ScapegoatDoll: {
			DisplayName: 身代わり人形
			Tooltip:
				'''
				インベントリに入れている間、1度だけ死亡を肩代わりする
				身代わりになると人形が砕け、失われる
				'''
			ShatterText: 身代わり人形が粉々になった...
