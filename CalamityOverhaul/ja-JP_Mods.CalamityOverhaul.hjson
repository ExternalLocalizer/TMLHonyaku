# For Language Pack Creators:
# The keys here were previously in Items. Since EcTypeItem has been removed, all localization keys similar to "ItemNameEcType" have been moved here.
# The corresponding format is "ItemNameEcType" → "RItemName" or "ItemNameOverride".
# Apart from the class name change, the DisplayName and Tooltip remain the same as in the previous version.
# So if you need to migrate your language pack to the new version, simply copy and paste the entries here and update the class names accordingly.

Arcanes: {
	Items: {
		ArcaneTransformer: {
			DisplayName: 魔導変換器
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0}は深淵の再誕に呑み込まれました。"
		WarningCombatText: 深淵があなたを喰らっている...
		DeathNoticeText: あなたは深淵に呑まれた...
		MarkRemainText: 深淵の刻印がまだ残っている...
		RetainValueFormat: 再誕値: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: シナプス焼却
		Description: 対象の神経シナプスを過負荷状態にし、継続的な熱ダメージを与える
	}

	ShortCircuit: {
		DisplayName: 回路ショート
		Description: EMPを放出し、即時ダメージと短時間の麻痺を与える
	}

	Cyberpsychosis: {
		DisplayName: サイバーサイコシス
		Description: 対象を狂乱状態へ追い込み、周囲のあらゆるユニットを攻撃させる
	}

	SystemReset: {
		DisplayName: システムリセット
		Description: 対象のシステムを強制再起動させ、完全に行動不能にする
	}

	OpticOverload: {
		DisplayName: オプティクス再起動
		Description: 対象の視覚を遮断し、周囲を認識できなくする
	}

	MemoryWipe: {
		DisplayName: 記憶消去
		Description: 対象の敵対データを消去し、ヘイト状態をリセットする
	}

	Contagion: {
		DisplayName: コンテイジョン
		Description: 自己複製型マルウェアを埋め込み、周囲の対象へ感染を拡散させる
	}

	TileDetonate: {
		DisplayName: タイルデトネーション
		Description: 構造耐久性を破壊し、局所的な爆発を発生させる
	}

	TilePhase: {
		DisplayName: フェージングプロトコル
		Description: ブロックの物理特性を変化させ、一時的にすり抜け可能にする
	}

	TileMagPull: {
		DisplayName: マグネティックプル
		Description: 磁場を発生させ、周囲に落ちているアイテムを引き寄せる
	}

	MachineShortCircuit: {
		DisplayName: 機械ショート
		Description: 対象機械のエネルギーを吸い上げ、周囲へ電撃アークを放出する
	}

	TurretHijack: {
		DisplayName: タレットジャック
		Description: IFF識別モジュールを改竄し、タレットの敵味方識別を一時的に反転させる
	}

	FalseMemory: {
		DisplayName: 虚偽記憶
		Description: 偽の記憶を植え付け、追跡行動を一時中断させる、または殺害パターンを抑制する
	}

	SelfDismember: {
		DisplayName: 自己切断
		Description: 超常存在へ自己解体を強制する
	}

	SystemHalt: {
		DisplayName: 強制停止
		Description: 対象を短時間沈黙させ、あらゆる行動を停止させる
	}

	TurretCircuitOverload: {
		DisplayName: 回路ショート
		Description: タレットの電力回路へ逆電流を流し込み、長時間完全停止させる
	}

	TurretShortCircuit: {
		DisplayName: タレットショート
		Description: タレットのエネルギーを瞬時に放電させ、短時間機能停止させる
	}

	VirusBroadcast: {
		DisplayName: ウイルスブロードキャスト
		Description: 信号塔へワームコードを注入し、放送範囲内の全タレットを長時間ショートさせるサイバーEMP波を発信する
	}

	MeltdownProtocol: {
		DisplayName: メルトダウン・プロトコル
		Description: 対象の放熱器を閉鎖し、4秒後に過熱させて周囲の敵も巻き込む爆発を発生させる
	}

	ProjectileHijack: {
		DisplayName: バリスティックハイジャック
		Description: 飛来する投射物を乗っ取り、飛んできた方向へそのまま撃ち返す
	}

	ProjectileFreeze: {
		DisplayName: バリスティックフリーズ
		Description: 投射物を空中で5秒間停止させ、その後再び飛ばす
	}

	DataPurge: {
		DisplayName: データ消去
		Description: 飛来する投射物を消去し、周囲にある同じ種類の投射物もすべて消去する
	}

	BallisticOverclock: {
		DisplayName: バリスティックオーバークロック
		Description: 自分の投射物1発にダメージ、貫通力、飛翔時間を追加する
	}

	Electrolysis: {
		DisplayName: 電気分解
		Description: 液体に電流を流し込み、浸かっている敵に継続ダメージを与える
	}

	Cryostasis: {
		DisplayName: クリオスタシス
		Description: 液体の一部を凍らせて氷に変え、8秒間その上に立てるようにする
	}

	LiquidPurge: {
		DisplayName: 液体排出
		Description: 周囲の液体を排出する
	}

	ItemRecall: {
		DisplayName: リモートリコール
		Description: 落ちているアイテムを足元まで引き寄せる
	}

	Reappraise: {
		DisplayName: 再評価
		Description: 地面にある装備の接頭辞をランダムなものに変更する
	}

	ArmorParse: {
		DisplayName: アーマー解析
		Description: 対象の防御力を6秒間ゼロにする
	}

	Exorcise: {
		DisplayName: 強制削除
		Description: 対象に削除マークを付与し、5回目に攻撃を受けたとき強力な一撃を発生させる
	}

	DataLeech: {
		DisplayName: データリーチ
		Description: 効果中、この対象を攻撃するたびにRAMを回復するが、回復量には上限がある
	}

	SwarmLink: {
		DisplayName: スワームリンク
		Description: 対象に攻撃を当てると、周囲にいる最大5体の敵にも本来の30%のダメージを与える
	}

	MachineOverclock: {
		DisplayName: マシンオーバークロック
		Description: マシンに10秒間、一定量の電力を供給し続け、その後すべて使い切らせる
	}

	GridBlackout: {
		DisplayName: グリッドブラックアウト
		Description: 信号塔を使って広範囲にあるすべてのマシンへの電力を遮断する
	}

	PowerTransmute: {
		DisplayName: パワー変換
		Description: 所持中のアイテムに蓄えられた電力をRAMに変換し、その後すべて使い切る
	}

	NeuralOverclock: {
		DisplayName: ニューラルオーバークロック
		Description: 8秒間、より速く攻撃できるようになるが、その間RAMは回復せず、ライフが減少し続ける
	}

	WraithForceDrive: {
		DisplayName: レイス・フォースドライブ
		Description: 10秒間、レイスの行動にコストがかからなくなるが、その後浸食が進行し、レイスは休眠する
	}

	IndexPreread: {
		DisplayName: インデックス・プリリード
		Description: コンテナを開けずに中身をすべて確認し、最も価値の高いアイテムを特定する
	}

	LockBurn: {
		DisplayName: ロック・バーンスルー
		Description: 中にあるアイテム1個を焼却する代わりに、鍵なしでこのロックされたコンテナを開ける
	}

	DielSkip: {
		DisplayName: ディエルスキップ
		Description: 時間を早送りし、最も近い日の出または日没まで進める
	}

	StormInject: {
		DisplayName: ストームインジェクション
		Description: 雷雨を発生させるが、落雷は何らかのハック効果を受けている敵にのみ命中する
	}

	GravityInvert: {
		DisplayName: グラビティインバージョン
		Description: 周囲の重力を反転させ、敵と落ちているアイテムを上空へ落下させる
	}

	SegmentDelink: {
		DisplayName: セグメントデリンク
		Description: このセグメントが受けたダメージは記録されるだけで、効果終了時に60%がアンカーへ移される
	}

	LimbSeizure: {
		DisplayName: リムシージャー
		Description: 8秒間、この手足を自身のアンカーに攻撃させる
	}

	CommandLinkCut: {
		DisplayName: コマンドリンクカット
		Description: 仲間とのリンクを切断し、10秒間単独で戦わせる
	}

	MunitionSwap: {
		DisplayName: ミュニションスワップ
		Description: タレットに自分のインベントリ内の弾薬を使わせ、自分と同じダメージを与える
	}

	TurretMesh: {
		DisplayName: タレットメッシュ
		Description: 周囲のタレットをリンクし、カーソル地点へ一斉射撃させる（合計40発）
	}

	BeaconForge: {
		DisplayName: ビーコンフォージ
		Description: 塔から救難信号を偽装して発信し、広範囲の敵をおびき寄せる
	}

	PrivilegeEscalate: {
		DisplayName: 特権昇格
		Description: プロトコルのコストを減少させ、アップロードを高速化し、射程を無視するが、その間RAMは回復しない
	}

	ItemSalvage: {
		DisplayName: サルベージ
		Description: このドロップアイテムを分解し、素材の約60%に戻す
	}

	DataBrand: {
		DisplayName: データブランド
		Description: この装備の付加効果をコピーし、次の対象に付与する
		HudTag: ブランド: {0}
		DenyNoPrefix: コピーできる付加効果がこのアイテムにない
		DenyIncompatible: 記録した付加効果はこのアイテムには適用できない
	}

	EntityMasquerade: {
		DisplayName: マスカレード
		Description: 敵からこのドロップアイテムが自分に見えるようにし、30秒間、敵の攻撃を引き付ける
	}

	TileConscript: {
		DisplayName: アーマーコンスクライブ
		Description: 周囲のブロックを8枚のアーマープレートに変換して周囲に浮遊させ、時間切れになると発射する
	}

	VeinResonance: {
		DisplayName: ヴェインレゾナンス
		Description: 壁越しに同種の鉱石を表示する。採掘するとドロップ量が2倍になるが、番人を呼び寄せる
	}

	StressInvert: {
		DisplayName: ストレス反転
		Description: 10秒間、この地形を破壊不能にするが、敵が勢いよく衝突するとダメージを受ける
	}

	PressureSurge: {
		DisplayName: プレッシャーサージ
		Description: この液体を加圧し、浸かったものを上空へ吹き飛ばす
	}

	MirrorSurface: {
		DisplayName: ミラーサーフェス
		Description: 水面を鏡面化し、そこを通過した敵の射撃をコピーしてこちら側へ飛ばす
	}

	DelayFuse: {
		DisplayName: ディレイヒューズ
		Description: この投射物を消滅させず、その場に30秒間浮遊する地雷に変える
	}

	ProjectileTithe: {
		DisplayName: プロジェクタイルタイス
		Description: 周囲の敵の攻撃を吸収し、吸収した量に応じた威力で爆発する
	}

	ProjectileSample: {
		DisplayName: プロジェクタイルサンプル
		Description: この投射物のデータを取得し、20秒間、自分の12発ごとの射撃がその投射物を再現する
	}

	CompensationProtocol: {
		DisplayName: コンペンセーションプロトコル
		Description: 対象のライフを10%前借りするが、8秒以内に倒せなければ、その負債を自分が負う
	}

	PayloadRewrite: {
		DisplayName: ペイロードリライト
		Description: 10秒間、対象が発射する投射物を自分のものに書き換え、自分と同じダメージを与える
	}

	PhaseDesync: {
		DisplayName: フェーズデシンク
		Description: 対象の本体と当たり判定を分離し、どちらも攻撃を当てにくくする
	}

	LiveCellTap: {
		DisplayName: ライブセル・タップ
		Description: 対象をその場に拘束して無敵状態にし、そのライフを自分のRAMへ変換する
	}

	FirmwareRollback: {
		DisplayName: ファームウェアロールバック
		Description: 対象を以前のフェーズへ戻し、その後5秒間バーサーク状態にする
	}

	ShellRequisition: {
		DisplayName: シェルレクイジション
		Description: マーク中に倒された対象を15秒間復活させ、自分の味方として戦わせる
	}

	PositionCast: {
		DisplayName: ポジションキャスト
		Description: 15秒間、対象の位置をチーム全員が壁越しに確認できるようにする
	}

	GaugePollution: {
		DisplayName: ゲージポリューション
		Description: 相手のインターフェースを汚染し、8秒間ライフと弾薬の表示を乱す
	}

	LinkTraceback: {
		DisplayName: リンクトレースバック
		Description: 自分に向けられたすべてのアップロードを切断し、送信元にダメージを与えてマークする
	}

	ForceUninstall: {
		DisplayName: 強制アンインストール
		Description: 自分に付与された敵対プロトコルを1つ解除する。解除後30秒間は再使用できない
	}

	MemoryScorch: {
		DisplayName: メモリースコーチ
		Description: 着弾時に相手のRAMを3消費させ、その後10秒間RAM回復量を0にする
		SealTag: RAM封鎖
	}

	BuffSiphon: {
		DisplayName: バフサイフォン
		Description: 相手に付与されている中で残り時間が最も長いバフを奪い、自分に最大30秒間付与する
	}

	CombatSiphon: {
		DisplayName: コンバットサイフォン
		Description: 10秒間、相手に与えたダメージをRAMに変換する
	}

	BallisticTurncoat: {
		DisplayName: バリスティックターンコート
		Description: 相手が次に撃つ3発の弾を飛翔中に反転させ、撃った本人を追尾させるが、射撃しなければ効果は発動しない
		HijackCounter: 乗っ取り {0}/{1}
		DeathReason: "{0}の射撃が{1}によって反転し、本人へ返されました。"
	}

	MeltdownBrand: {
		DisplayName: メルトダウンブランド
		Description: 4秒後に爆発する見える時限ヒューズを仕掛け、80ダメージを与えるが、アンインストールすると解除できる
		FuseTag: メルトダウン {0}秒
		DeathReason: "{0}は{1}が仕掛けたメルトダウン・ブランドによって吹き飛びました。"
	}

	MapBlackout: {
		DisplayName: マップブラックアウト
		Description: 15秒間、相手のマップをノイズで覆い、ピンやチームマーカーも見えなくする
	}

	ChannelScramble: {
		DisplayName: チャンネルスクランブル
		Description: 20秒間、相手のチャットを乱し、画面から味方のネームプレートを消す
	}

	StealthStrip: {
		DisplayName: ステルスストリップ
		Description: 10秒間、相手の透明化とステルスをすべて解除し、その輪郭を全員に光らせる
	}

	CooldownInject: {
		DisplayName: クールダウンインジェクト
		Description: 6秒間、相手のアイテム使用速度を35%低下させ、進行中のポーションのクールダウンを5秒延長する
	}

	CyberwareOffline: {
		DisplayName: サイバーウェアオフライン
		Description: 8秒間、相手のサイバーウェアをすべて無効化する
	}
}

