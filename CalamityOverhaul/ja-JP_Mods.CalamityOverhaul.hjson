		Description: クリティカル率が5%上昇し、夜間はさらに3%上昇する
	}

	EaterOfWorldsBlessing: {
		DisplayName: 腐蝕の輪
		Description: 攻撃時に対象へ侵蝕を付与し、5秒間、防御力を10減少させる
	}

	BrainOfCthulhuBlessing: {
