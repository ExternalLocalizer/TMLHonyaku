Configs: {
	CWRServerConfig: {
		DisplayName: コンテンツ設定
		Headers.CWRWorldGen: ワールド生成設定

		GenWindGrivenGenerator: {
			Label: 風力発電機を生成
			Tooltip: 世界中に風力発電機の構造物を配置します
		}

		GenWGGCollector: {
			Label: スカベンジャー前哨基地を生成
			Tooltip: 敵対的なスカベンジャー構造物を世界中にランダム生成します。この設定はレジェンダリー難易度のワールドでのみ有効です。
		}

		GenJunkmanBase: {
			Label: ジャンクマンの拠点を生成
			Tooltip: 荒野または地下にスカベンジャーの要塞拠点を生成します
		}

		GenRocketHut: {
			Label: ロケット小屋を生成
			Tooltip: ロケット部品や技術的な遺物が入った謎の小屋を生成します
		}

		GenSylvanOutpost: {
			Label: シルヴァの前哨基地を生成
			Tooltip: 森の奥深くに木造のエルフまたは森の守護者の前哨基地を生成します
		}

		GenSHPCCradle: {
			Label: SHPC島を生成
			Tooltip: スポーン地点の上空に、SHPCが封印された墜落船の浮島を生成します。無効にした場合、この武器はCalamityの研究所でのみ入手できます。
		}

		ConfigChangePrefix: ユーザー
		ConfigChangeSuffix: サーバー設定を変更しました
	}

	CWRClientConfig: {
		DisplayName: クライアント設定

		Headers: {
			CWRWeapon: 武器設定
			CWRDisplay: Display Configs
		}

		ScreenVibration: {
			Label: 武器による画面振動
			Tooltip: 有効にすると、一部の攻撃中に画面が振動し、攻撃がより強烈に感じられるようになります
		}

		DomainConciseDisplay: {
			Label: ドメイン簡易表示
			Tooltip: 
				'''
				デフォルトでは無効です。有効にすると、サイバースペース／海域系ドメインの視覚効果のみが軽減されます。
				鬼切の領域には影響せず、切断、ハックタイムなどの武器やサイバーウェアの視覚効果にも影響しません。
				'''
		}

		HideOtherDomains: {
			Label: 他プレイヤーのドメインを非表示
			Tooltip: 
				'''
				デフォルトで有効です。他プレイヤーのドメイン演出（鬼切の領域、鬼笠の血の湖、幽雨、幽夢）を非表示にします。
				ただし、湖の上や水中、相手の夢の中では表示されます。見た目のみの変更で、効果や自分のドメインには影響しません。
				'''
		}

		LensEasing: {
			Label: レンズイージング
			Tooltip: 有効にすると、長距離を高速移動する際にレンズの動きが緩やかになり、移動が速すぎるように感じるのを防ぎます
		}

		AmbienceDensity: {
			Label: 環境エフェクト密度
			Tooltip: 装飾的な環境エフェクトの密度のみを調整します。攻撃予兆や危険物の表示が減ることはありません
		}

		RarityTextEffects: {
			Label: レアリティ名のエフェクト
			Tooltip: このModのレアリティのアイテム名にアニメーション効果を付与します。無効にすると、アイテム名は単色で表示されます。
		}
	}
}

Cyberwares: {
	SandevistansItem: {
		DisplayName: サンデヴィスタン Mk.5
		Tooltip: 
			'''
			時間の流れを70%遅くする（5秒間）
			クールダウン：15秒
			'''
	}

	Sandevistan: {
		SkillName: サンデヴィスタン
		SkillDesc:
			'''
			知覚時間を大幅に低下させ、スローモーションのように移動や行動が可能になる
			使用中は予備ゲージを消費し、空になると自動解除され、その後自然回復する
			ラジアルメニューで再選択すると手動で解除可能
			'''
	}

	MimicPerchedAuxBrain: {
		DisplayName: ミミック搭載補助脳
		Tooltip:
			'''
			宿主を4体の幻影に分裂させ、本体の周囲を漂わせる
			攻撃を受けると、幻影の中に隠れた本体が混乱を引き起こし無敵状態になり
			攻撃によるダメージを受けない
			その間、幻影は攻撃者へ突撃して爆発し
			敵の素の攻撃力に応じたダメージを与える
			'''
	}

	CstmVisualEye: {
		DisplayName: CSTMオプティビジュアル義眼
		Tooltip:
			'''
			ハックタイムを頭蓋内ニューラルネットワークへ直接同期するサイバー視覚インプラント

			最大RAMを4増加
			画面左下に独立したRAMゲージを表示

			'''
	}

	PrimePlasama: {
		DisplayName: プライムプラズマ皮下装甲
		Tooltip:
			'''
			全身の皮膚下に織り込まれた電気活性ゲル層
			防御力25とダメージ軽減6%を永続的に付与
			ノックバック耐性を大幅に増加させる
			'''
	}

	OmniElectricFoot: {
		DisplayName: オムニエレクトリックフット
		Tooltip:
			'''
			電磁反動と高密度推進ゲルを組み合わせた高出力の移動用サイバー義足

			空中二段ジャンプを付与し、地面を離れた後でも再び飛び上がれる
			サイバーウェアメニューでチャージジャンプを選択してチャージし、離して発射する
			最大チャージ時は通常ジャンプの2倍以上の高さまで到達可能
			'''
		SkillHint: "{0}でチャージジャンプを選択してチャージ"
		SkillName: チャージジャンプ
		SkillDesc:
			'''
			電磁推進による高出力跳躍
			地面に立っている必要があり、スライス上での滞空時間がチャージ時間になる
			キーを離すと発動し、最大チャージ時は通常ジャンプの2.5倍の高さまで跳躍できる
			'''
	}

	PlowSteelClampArm: {
		DisplayName: 鋼鉄製鋤用固定アーム
		Tooltip:
			'''
			磁気回収機能と高剛性クランプを備えた工業用サイバーアーム

			採掘とブロック設置の範囲を大幅に拡大する
			アイテムとコインの磁気回収を永続的に有効化
			サイバーウェアスキル: 手のひらから高熱単分子ワイヤーを放出する
			タップで短いワイヤー、長押しで長いワイヤーを展開、経路上の敵を継続的に焼き尽くす
			'''
		SkillHint: "[c/8AC4E8:{1}] サイバーウェアメニューを開いて切替 · [c/F5C56A:{0}] ワイヤーを発射（タップ=短 / 長押し=長）"
		SkillName: 単分子ワイヤー
		SkillDesc:
			'''
			手のひらから高熱単分子ワイヤーを放出、経路上の敵を継続的に焼き尽くす
			[c/8AC4E8:タップ] —— カーソル方向へ約12ブロックの2秒間持続する短いワイヤーを設置する 固定点は必要なし
			[c/F5C56A:長押し] —— 最大チャージ後、カーソル付近の固体ブロックへ5秒間固定し、固定点がない場合は短いワイヤーになる
			ダメージはプレイヤーの汎用ダメージ倍率により変化する
			'''
	}

	SelfHealingSkelent: {
		DisplayName: 自己修復型内骨格
		Tooltip:
			'''
			生体骨格をナノ結晶格子へ置換する高性能バイオサイバーインプラント

			ライフ自然回復を毎秒2増進し、最大ライフを40増加する
			戦闘状態ではない状態が4秒続くとナノ修復状態へ移行し、自然回復を大幅に増進させる
			金属製内骨格により落下ダメージを完全無効化する
			'''
	}

	SelfHackCrystal: {
		DisplayName: セルフハッククリスタル
		Tooltip:
			'''
			オペレーティングシステムスロットに装着する高性能ネットワークサイバー装置
			ハッキングインターフェースを宿主自身へ逆流させる

			RAM回復速度を継続的に増加させる
			サイバーウェアスキル: RAMを消費して即座にすべてのデバフを解除する
			さらに短時間の無敵を得て、致命的な状況から脱出する隙を作る
			'''
		SkillHint: "{0}からセルフハックを発動してRAMでデバフを解除"
		SkillName: セルフハック
		SkillDesc:
			'''
			緊急解除のためハッキングインターフェースを自身へ逆流させる
			RAMを3消費してすべてのデバフを即座に解除し、約1.5秒間無敵を付与する
			クールダウン12秒、RAM不足またはクールダウン中は自動的に灰色表示される
			'''
	}

	SCCA32CRP: {
		DisplayName: SCCA-32 CRP
		Tooltip:
			'''
			高度な神経筋副処理装置
			脅威予測と筋繊維反射を脳を完全に経由せず処理することができる

			クリティカル率8%と移動速度8%を継続的に付与する
			攻撃を受けた時18%の確率で反射回避を発動し、その攻撃を完全無効化する
			回避成功時、3秒間クリティカル率と移動速度が増加する反射強化状態になる

			'''
	}
}

