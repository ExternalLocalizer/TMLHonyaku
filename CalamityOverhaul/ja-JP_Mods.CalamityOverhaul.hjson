GodSmithMagicConduit: {
	GsLastPrism.Desc:
		'''
		Reforged: heat is focus; six splayed beams converge into one white-hot lance, and at white heat the impact refracts prism shards
		Capping the gauge never breaks the beam, it only surges mana upkeep
		Right click while channeling to shatter the lance into a prismatic fan, spending all heat
		'''
	GsLastPrismHeldProj.DisplayName: Last Prism Lance
	GsLastPrismBurstProj.DisplayName: Prismatic Shatter
	GsLastPrismShardProj.DisplayName: Prism Shard
	GsMagicalHarp.Desc:
		'''
		Reforged: unbroken play builds crescendo; at fortissimo the notes swell, race and rain music
		Right click to resolve all crescendo into a ringing chord shockwave; rapid re-hits echo for bonus damage
		'''
	GsBubbleGun.Desc:
		'''
		Reforged: nonstop spray builds bubble pressure; at a boil the bubbles swell and burst into twin beads on impact
		Cap the gauge and the barrel jams shut in a gush of foam
		Right click to vent everything as a fan of seven great bubbles that pop in a rolling chain
		'''
	GsLaserMachinegun.Desc:
		'''
		Reforged: heat is spin; the barrel drags cold and roars at white heat, where every sixth shot rides a piercing crimson lance
		Holding the gauge at the redline only surges mana upkeep
		Right click to vent the whole cylinder as a sweeping thirty-round fan
		'''
	GsRazorbladeTyphoon.Desc:
		'''
		Reforged: each cast banks storm charge; blades born at white heat never get lost, they wheel back to your side and hunt again
		Right click to open the Eye of the Typhoon at your cursor: every blade in the air is drawn into the vortex, and the eye bursts as it closes
		'''
	GsMagnetSphere.Desc:
		'''
		Reforged: while you hold the staff a feed-tether links you to your sphere, and magnetic flux climbs as long as the link holds
		At full flux the sphere overcharges, lashing heavy arcs at anything close
		Right click to detonate a magnet storm around the sphere that drags lesser foes toward its heart
		'''
	GsShadowbeamStaff.Desc:
		'''
		Reforged: hold to sustain a shadow beam that ricochets off the walls; white heat adds one more bounce and thickens the beam
		Right click to vent everything as chained shadow bursts along every bend of the beam
		'''
	GsChargedBlasterCannon.Desc:
		'''
		Reforged: hold to channel; cold plasma spits bolts, white heat pulses focused arc lances
		Charging never stops: cap the gauge and the cannon itself fires the Annihilator, a massive plasma sphere that licks arcs at everything nearby
		Right click to cash out early as a lesser charge shot
		'''
	GsLaserMachinegunLanceProj.DisplayName: Crimson Lance
	GsShadowbeamStaffHeldProj.DisplayName: Shadow Polyline Beam
	GsChargedBlasterCannonHeldProj.DisplayName: Annihilation Charge
	GsChargedBlasterCannonOrbProj.DisplayName: Annihilator
	GsMagicalHarpNovaProj.DisplayName: Chord Shockwave
	GsHeatRay.Desc:
		'''
		Reforged: hold to sustain a scorching ray; white heat widens the beam and molten stacks detonate on the fifth
		Right click to vent all heat as a corona flash lance
		'''
	GsMedusaHead.Desc:
		'''
		Reforged: hold to unleash a petrifying gaze cone; stone-mark stacks briefly petrify, white heat narrows the gaze into a focused glare
		Right click to vent all heat as an eight-way stone glare
		'''

	GsSoulDrain: {
		Desc:
			'''
			Reforged: a leech conduit that tethers up to three foes and drains them together; white heat grants true life recovery
			Right click to detonate the stored blood at your cursor; overload backfires for 10 life
			'''
		BloodPriceDeath: "{0} was drained by their own leech conduit"
	}
}

GodSmithMagicMorph: {
	GsSpiritFlame.Desc:
		'''
		Reforged: spirit flames trail pale soulfire; half of their hits split off a hunting wisp
		Hold right click to charge; release to lay a five-flame ring at your cursor that pounces on intruders
		'''
	GsSpiritFlameRingProj.DisplayName: Spirit Flame Ring
	GsSpiritFlameWispProj.DisplayName: Hunting Wisp
	GsPoisonStaff.Desc:
		'''
		Reforged: fangs trail venom mist and split into thin fangs on their second bite
		Hold right click to charge the Serpent Kiss: a swift coiling viper that poisons everything on its path
		'''
	GsVenomStaff.Desc:
		'''
		Reforged: fangs trail venom mist and split a heavy fang on their second bite
		Hold right click to charge the Serpent Kiss: a massive pit viper whose corpse melts into a lingering acid pool
		'''
	GsShadowFlameHexDoll.Desc:
		'''
		Reforged: shadowflame tendrils pin a hex brand into whatever they touch; branded foes take more from this doll
		Hold right click to charge the Grand Hex: a sigil at your cursor that lashes tendrils at intruders
		'''
	GsLeafBlower.Desc:
		'''
		Reforged: leaf blades spin with a razor-green wake
		Hold right click to charge Storm Mode: for six seconds every leaf flies faster, cuts deeper and spirals harder
		'''
	GsMorphFangSerpentProj.DisplayName: Serpent Kiss
	GsMorphFangAcidPoolProj.DisplayName: Acid Pool
	GsShadowFlameHexSigilProj.DisplayName: Grand Hex Sigil
	GsClingerStaff.Desc:
		'''
		Reforged: hold right click briefly to lay a 260px cursed vine wall along your aim, at any angle.
		Overcharge it and both ends sprout vertical skirt walls
		'''
	GsCrimsonRod.Desc:
		'''
		Reforged: the blood cloud becomes a sacrificial rain field.
		Raindrops stack Blood Erosion, three stacks burst; allies inside slowly mend.
		Right click migrates the field to your cursor for a sliver of mana
		'''
	GsCrystalSerpent.Desc:
		'''
		Reforged: burst shards bounce once more.
		Hold right click to charge; release a great crystal python that slithers in a sine wave and bursts into a richer shard shower
		'''
	GsCrystalStorm.Desc:
		'''
		Reforged: hold right click to charge a refraction vortex at the cursor.
		Your crystal shards passing through it refract, gaining speed and one extra pierce
		'''
	GsFlamelash.Desc:
		'''
		Reforged: guided flight steers 25% faster.
		Hold right click to charge; release a serpent of flame whose coils trail your guidance and set foes ablaze
		'''
	GsMagicMissile.Desc:
		'''
		Reforged: guided flight steers 25% faster.
		Hold right click to charge; release a triple volley that escorts your cursor in formation
		'''
	GsMeteorStaff.Desc:
		'''
		Reforged: meteors leave a scorching crater where they land.
		Hold right click to charge; release to call a five-meteor barrage across the cursor
		'''
	GsNimbusRod.Desc:
		'''
		Reforged: with both clouds afield, a rain corridor bridges them, soaking and slowing foes inside.
		Right click toggles warm rain or thunderstorm; the storm calls down bolts along the corridor
		'''
	GsRainbowGun.Desc:
		'''
		Reforged: while the rainbow stands, your projectiles inside the band above the arc deal 8% more damage, and the arc sheds homing prism pulses.
		Right click recalls the rainbow and refunds half its mana
		'''
	GsRainbowRod.Desc:
		'''
		Reforged: guided bolts burst into prismatic shards on hit.
		Hold right click to charge; release to raise a rainbow bridge that hurts foes crossing it and hastens allies standing on it
		'''
	GsSkyFracture.Desc:
		'''
		Reforged: blades tear a flash of fracture as they launch.
		Hold right click to charge; release to open three rifts around the cursor that loose converging blades
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc: Reforged: snowflakes born from on-beat lashes grow larger and pierce one more foe; 4 frost scars seal the mark, and the next on-beat hit blooms it into a frost burst that inflicts Frostbite
	GsDarkHarvest.Desc: Reforged: dark energy leaps spread to nearby foes for each reap scar on the victim; 4 scars seal the mark, and the next on-beat hit reaps its soul, flash-scything every scarred enemy on the field
	GsDurendal.Desc: Reforged: after three on-beat lashes, every further on-beat swing looses a golden sword-wave from the whip tip; 5 scars seal the mark, and the next on-beat hit calls down a holy verdict blade
	GsFirecracker.Desc: Reforged: keeps the classic minion-detonated blast; on-beat lashes load fuses into the target, and at 3 fuses the next blast chains into 3 extra staggered explosions
	GsKaleidoscope.Desc: Reforged: the tightest beat window, and a missed swing resets all tempo; each scar lights one prism color, and at five colors the next on-beat hit unfolds a kaleidoscope of five prismatic slashes, exposing the victim to guaranteed-crit chances for 5 seconds
	GsLeatherWhip.Desc: Reforged: chain swings on the beat to build tempo and lash speed; 3 lash scars seal the mark, and the next on-beat hit cracks it for 200% damage, then your minions maul the target for 2 seconds
	GsMorningStar.Desc: Reforged: every on-beat swing slams a quake at the whip tip; 3 scars seal the mark, and the next on-beat hit calls a falling star mace down on the target's head
	GsSnapthorn.Desc: Reforged: on-beat lashes grow thorn scars on the prey; 4 scars seal the mark, and the next on-beat hit bursts it into a thorn explosion plus 4 homing venom barbs
	GsSpinalTap.Desc: Reforged: an on-beat sweep that tags 3 foes cracks a bone echo into everything it missed; 4 scars seal the mark, and the next on-beat hit erupts a bone spire from below
}

GodSmithAcc.GodSmithSharkToothNecklace.EffectDesc:
	'''
	+4% damage
	Strikes tear the target's hide, granting Rend: +1 armor penetration per stack, up to 8 stacks, lasts 3s
	'''

GodSmithEndow: {
	GodSmithExecutionEndow: {
		EndowName: Executioner's Line
		EndowDesc: Striking a foe below {0}% life looses an executioner's slash dealing {1}% of that hit
	}

	GodSmithOverkillEndow: {
		EndowName: Overkill Cascade
		EndowDesc: Kills send a crimson bolt to a nearby foe, carrying {0}% of the overkill plus {1}% of the hit
	}

	GodSmithCritMarkEndow: {
		EndowName: Critical Sigil
		EndowDesc: Hits engrave a sigil; at {0} stacks it detonates as a guaranteed critical dealing {1}% of that hit
	}

	GodSmithEchoSlashEndow: {
		EndowName: Blade Echo
		EndowDesc: Hits echo outward as a blade-wind ring dealing {0}% of that hit to other nearby foes
	}

	GodSmithShockwaveEndow: {
		EndowName: Concussive Wave
		EndowDesc: Every 1.5s, a hit slams out a shockwave knocking nearby foes away and dealing {0}% of that hit
	}

	GodSmithComboEndow: {
