Industrials: {
	WGGWildernessTP.WindGrivenDiscovery1: 風力で動くこれらの機械に魅了され、自分でもいくつか作ってみようと思い始めた...
	WGGMK2WildernessTP.WindGrivenDiscovery2: この巨大な機械に圧倒され、自分でも建造してみるべきだと感じた...

	Flow: {
		ThermalBattery: {
			DisplayName: 熱電池
			Tooltip: 一定量の電力を蓄えることができる
		}

		FluidPipeline: {
			DisplayName: 液体パイプ
			Tooltip:
				'''
				水、溶岩、ハチミツ、シマーを運ぶことができる
				1本のパイプで運べる液体は1種類のみで、別の液体に切り替えるには中身を空にする必要がある
				右クリックで素早く撤去できる
				'''
		}

		FluidTank: {
			DisplayName: 液体タンク
			Tooltip:
				'''
				液体を最大32ブロック分貯蔵でき、ウィンドウに貯蔵量が表示される
				液体パイプを通してポンプや機械に接続できる
				タンクを破壊すると中身が排出される
				'''
		}

		LargeFluidTank: {
			DisplayName: 大型液体タンク
			Tooltip:
				'''
				液体を最大128ブロック分貯蔵でき、ウィンドウに貯蔵量が表示される
				液体パイプを通してポンプや機械に接続できる
				タンクを破壊すると中身が排出される
				'''
		}

		FluidText: {
			WaterName: 水
			LavaName: 溶岩
			HoneyName: ハチミツ
			ShimmerName: シマー
			EmptyName: 空
			BarFormat: "{0} {1}/{2}"
		}

		CapacitorMatrix: {
			DisplayName: コンデンサーマトリクス
			Tooltip:
				'''
				最大40000の電力を蓄えられる大型蓄電装置
				熱電池をはるかに上回る充放電性能を持ち、大規模な電力網の要となる
				'''
		}

		UEPipeline: {
			DisplayName: 電力入力パイプライン
			Tooltip:
				'''
				電力伝達用のパイプライン
				右クリックでカーソル位置のパイプを素早く回収する
				発電機や電力源に接続し、バッテリーや機器に電力を供給する
				'''
		}

		LaserEnergyTrans: {
			DisplayName: レーザーエネルギー伝送装置
			Tooltip:
				'''
				遠隔で電力を伝送する
				設置後に右クリックでレーザー誘導を起動し、
				その後、他の発電施設を右クリックしてリンクする
				伝送距離が遠いほどエネルギー損失が大きくなる
				損失は最大で100%
				'''
		}

		CreativeUEPipeline: {
			DisplayName: エネルギー創造パイプライン
			Tooltip: ""
		}

		ItemPipeline: {
			DisplayName: アイテムパイプ
			Tooltip:
				'''
				アイテム輸送に使用する
				パイプを持っている時、右クリックで対象のパイプを素早く解体して回収する
				パイプを持っていない時、パイプ端を右クリックして出力モードと入力モードを切り替え
				出力モードのパイプは接続されたコンテナからアイテムを取り出し、入力モードのパイプに接続されたコンテナへ転送される
				'''
		}
	}

	Generators: {
		ThermalGenerator: {
			DisplayName: 熱発電機
			Tooltip:
				'''
				燃料を入れることで発電できる
				ブロックを右クリックで素早く燃料を挿入する
				Shift+右クリックで取り出し可能
				'''
		}

		MagmaThermalGenerator: {
			DisplayName: マグマ熱発電機
			Tooltip:
				'''
				溶岩に触れている間は少量の電力を発生し、タンクにマグマが入っている間は最大出力で発電することができる
				液体パイプから供給できるほか、溶岩入りバケツを持って右クリックすると直接注ぎ込める
				「地獄の工場における最初の主力電源」
				'''
		}

		WindGrivenGenerator: {
			DisplayName: 風力発電機
			Tooltip: 風を受けて移動しながら発電する
			UnderstandWindGriven: 風力発電の基礎知識が必要
			UnderstandWindGriven2: 小惑星上の古い風力装置を発掘することで製造法を知ることができる
		}

		WindGrivenGeneratorMK2: {
			DisplayName: 風力発電機MK2
			Tooltip: 風を受けて移動しながら発電する
			UnderstandWindGrivenMK2: 風力発電の深い理解が必要
			UnderstandWindGrivenMK2Remind: 小惑星の巨大な風力タービンを採掘して、構造原理を理解する必要がある
		}

		ThermalGeneratorMK2: {
			DisplayName: 熱発電機MK2
			Tooltip:
				'''
				燃料を入れることで発電できる
				ブロックを右クリックで素早く燃料を挿入、Shift+右クリックで取り出し可能
				'''
		}

		WGGMK2Wilderness: {
			DisplayName: 荒野の巨大風力タービン
			Tooltip: ""
		}

		WGGWilderness: {
			DisplayName: 荒野の風力タービン
			Tooltip: ""
		}

		SolarPanel: {
			DisplayName: ソーラーパネル
			Tooltip:
				'''
				昼間に発電し、正午に最大出力になる
				雨天時は発電量が大幅に減少し、日食中は完全に停止する
				上部を固形ブロックで覆われると発電できなくなる
				'''
		}

		SolarPanelMK2: {
			DisplayName: ソーラーパネル MK2
			Tooltip:
				'''
				昼間に発電し、正午に最大出力になる
				初期型の3倍の効率を持つ
				雨天時は発電量が大幅に減少し、日食中は完全に停止する
				上部を固形ブロックで覆われると発電できなくなる
				'''
		}

		Hydroelectric: {
			DisplayName: 水力発電機
			Tooltip:
				'''
				水に設置することで発電することができる
				「流体力学の応用のひとつ」
				'''
		}

		HydroelectricMK2: {
			DisplayName: 水力発電機 MK2
			Tooltip:
				'''
				水に設置することで発電することができる
				「流体力学の応用のひとつ」
				'''
		}

		BiomassGenerator: {
			DisplayName: バイオマス発電機
			Tooltip:
				'''
				種、ハーブ、キノコ、魚などの余った農産物を燃料にして安定した電力を生み出す
				発電量は風力発電機と熱発電機の中間で、農業機械と組み合わせれば循環運用できる
				バイオマスを手に持って右クリックすると燃料を投入し、何も持たずに右クリックすると操作パネルを開く
				'''
		}
	}

	Machines: {
		FluidPump: {
			DisplayName: 液体ポンプ
			Tooltip:
				'''
				電力が供給されている間、機械の下にある液体を吸い上げて内部タンクに貯めることができる
				液体1ブロックを吸い上げるごとに2UEを消費し、液体はパイプを通ってタンクや機械へ運ばれる
				'''
		}

		FluidInjector: {
			DisplayName: 液体注入器
			Tooltip:
				'''
				貯蔵した液体を消費して、機械の下の世界に液体を流し込むことができる
				液体1ブロックを配置するごとに2UEを消費する
				溶岩を流すときは足元に注意
				'''
		}

		BottlingMachine: {
			DisplayName: 瓶詰め機
			Tooltip:
				'''
				空の瓶やバケツを持って右クリックするとセットし、保存されている液体を詰めることができる
				液体入りの瓶やバケツを持って右クリックするとセットし、中身を空にして液体をパイプラインへ戻す
				瓶詰め中はパイプラインから液体を取り出し、作業していない時は保存した液体をパイプラインへ戻す
				1回の瓶詰めにつき5UEを消費する
				何も持たずに右クリックすると完成品を取り出し、Shift+右クリックですべて取り出す
				両方のスロットはアイテムパイプラインに接続でき、自動搬送に対応する
				'''
		}

		ShimmerTransmuter: {
			DisplayName: シマー変換装置
			Tooltip:
				'''
				アイテムを入れてシマーを消費すると変換でき、変換結果は出力スロットに送られる
				1回の変換につき10UEとシマー64ユニットを消費し、シマーの池からパイプを通して供給される
				アイテムの変換と分解に対応している、コインと生物を放出するアイテムは受け付けない
				入力スロットと出力スロットをアイテムパイプに接続して自動搬送できる
				'''
		}

		TeslaElectromagneticTower: {
			DisplayName: テスラ電磁タワー
			Tooltip:
				'''
				稼働には電力が必要
				設置後に右クリックで攻撃モードと防御モードを切り替え可能
				攻撃モードでは、周囲の敵に電撃を放つ
				防御モードでは、範囲内の敵に感電デバフを与える
				さらに、範囲内にチャージ可能なアイテムを持つプレイヤーがいる場合、
				遠隔で電力を供給する
				「エンジニアは近づくな」
				'''
		}

		FlameTurret: {
			TurretOnText: 火炎タレット起動
			TurretOffText: 火炎タレット停止
			NoEnergyText: 電力が足りない！
			FuelLoadText: ジェル ×{0}を装填
			FuelTakeText: ジェル ×{0}を回収
			DisplayName: 火炎放射タレット
			Tooltip:
				'''
				動作には電力が必要
				近づいてくる敵へ炎を連続して放ち、炎は敵の群れを貫通してヘルファイアを付与する
				ジェルを持って右クリックすると燃料を装填でき、燃えるジェルによって炎のダメージが増加する
				Shift＋右クリックでジェルを回収でき、アイテムパイプから燃料スロットへジェルを投入することもできる
				右クリックで制御パネルを開くことができ、そこで電源の切り替えやモジュールの取り付けを行える
				ワイヤー信号でもタレットのオン・オフを切り替えられる
				「焼けたスライムの匂いがする」
				'''
		}

		CryoTurret: {
			TurretOnText: 冷気タレット起動
			TurretOffText: 冷気タレット停止
			NoEnergyText: 電力が足りない！
			DisplayName: 冷気タレット
			Tooltip:
				'''
				動作には電力が必要
				射程内にいるすべての敵へ霜を撒き続け、冷気を浴びせて動きを遅くするが、ダメージは低い
				約2秒間霜を浴び続けた敵は短時間凍結する
				右クリックで制御パネルを開くことができ、そこで電源の切り替えやモジュールの取り付けを行える
				ワイヤー信号でもタレットのオン・オフを切り替えられる
				「落ち着け」
				'''
		}

		LaserTurret: {
			TurretOnText: レーザータレット起動
			TurretOffText: レーザータレット停止
			NoEnergyText: 電力が足りない！
			DisplayName: レーザータレット
			Tooltip:
				'''
				動作には電力が必要
				視線の通る敵へ高威力のレーザーを放つ
				射程は非常に長いが連射速度は遅い
				地形に遮られている敵はロックオンせず、ボスを優先して狙う
				右クリックで制御パネルを開くことができ、そこで電源の切り替えやモジュールの取り付けを行える
				ワイヤー信号でもタレットのオン・オフを切り替えられる
				「一撃一殺」
				'''
		}

		ShieldGenerator: {
			FieldOnText: シールドフィールド起動
			FieldOffText: シールドフィールド停止
			NoEnergyText: 電力が足りない！
			DisplayName: シールド発生装置
			Tooltip:
				'''
				動作には電力が必要
				電力が供給されている間、範囲内のプレイヤーにエネルギーシールドを付与する
				シールドはゆっくりとチャージされ、受けるダメージの一部を吸収し、範囲外に出ると消える
				守るプレイヤーが多いほど電力の消費が速くなる
				右クリックで制御パネルを開くことができ、そこで電源の切り替えやモジュールの取り付けを行える
				ワイヤー信号でもタレットのオン・オフを切り替えられる
				'''
		}

		HealStation: {
			FieldOnText: 回復オーラ起動
			FieldOffText: 回復オーラ停止
			NoEnergyText: 電力が足りない！
			DisplayName: 回復ステーション
			Tooltip:
				'''
				動作には電力が必要
				電力が供給されている間、範囲内のすべてのプレイヤーのライフを徐々に回復する
				右クリックで制御パネルを開くことができ、そこで電源の切り替えやモジュールの取り付けを行える
				ワイヤー信号でもタレットのオン・オフを切り替えられる
				「職場でのケガ？そんなもの聞いたことがない」
				'''
		}

		ElectricMinRocket: {
			EnergyShortage: 電力が足りない！
			DisplayName: 電動ミニロケット
			Tooltip:
				'''
				右クリックでロケットを使用するか、地面に設置してから右クリックで飛行を開始する
				空中では左右キーで飛行方向を調整できる
				下キー長押しでゆっくり下降する
				飛行中は徐々にエネルギーを消費する
				スペースキーを押すと飛行を中断する
				「ソ連製、頑丈で信頼性抜群
				　月まであと一歩だった」
				'''
		}

		TeleportStation: {
			NoEnergyText: 電力が足りない！
			TargetNoEnergyText: 移動先のステーションに待機電力がありません！
			UnnamedText: 無名のステーション（{0}, {1}）
			DisplayName: テレポートステーション
			Tooltip:
				'''
				世界中のすべてのステーションとテレポートネットワークを形成する
				右クリックでパネルを開き、移動先をクリックすると移動できる
				テレポートには距離に応じた電力を消費し、移動先にも少量の待機電力が必要
				ステーションには名前を付けられ、リストから簡単に見つけられる
				'''
		}

		ElectricSundial: {
			NoEnergyText: 電力が足りない！
			BusyText: すでに時間を早送りしています！
			SkipBroadcast: "{0}が電気日時計を起動したため、夜明けまで時間が早送りされる。"
			DisplayName: 電気日時計
			Tooltip:
				'''
				1000の電力を蓄えて右クリックすると、夜明けまで時間を早送りする
				独自の電力を使用するため、魔法の日時計の7日間のクールダウンを無視できる
				使用するとサーバー全体に通知される
				'''
		}

		WeatherController: {
			NoEnergyText: 電力が足りない！
			RainBroadcast: "{0}が天候制御装置を起動したため、雨雲が集まり始めた。"
			ClearBroadcast: "{0}が天候制御装置を起動したため、雨が止んだ。"
			DisplayName: 天候制御装置
			Tooltip:
				'''
				右クリックで500の電力を消費して雨を降らせ、雨が降っている間は雨を止ませることができる
				操れるのは雨だけで、風はコントロールできない
				使用するとサーバー全体に通知される
				'''
		}

		WireInterface: {
			ModeBridgeText: ブリッジのみ：ワイヤー信号で隣接する機械のON/OFFを切り替える
			ModeFullText: 満充電通知：隣接する機械が満充電になるとワイヤー信号を送る
			ModeEmptyText: 空状態通知：隣接する機械の電力が尽きるとワイヤー信号を送る
			MachineOffText: 待機中
			MachineOnText: 稼働中
			DisplayName: ワイヤーインターフェース
			Tooltip:
				'''
				機械式ワイヤーと電力網を双方向に接続するアダプター
				ワイヤー信号を受けると、接続された機械を稼働中と待機中に切り替える
				右クリックで通知モードを切り替え、隣接する機械が満充電または空になるとワイヤー信号を送る
				制御したい機械に接して設置し、ワイヤーを接続する
				'''
		}

		Sensor: {
			TitleText: マルチモードセンサー
			ConditionLabelText: 発動条件
			ModeOffText: オフ
