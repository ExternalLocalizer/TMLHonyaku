		Description: 周囲の時間が停止する
	}

	GravitationalCollapse: {
		DisplayName: 重力崩壊
		Description: 自身の重量によって奈落へ引きずり込まれる
	}

	MarbleRiposteBuff: {
		DisplayName: Marble Riposte
		Description: Melee damage increased by 10%
	}

	MarblePetrify: {
