DragHint: ドラッグして移動 · 端をドラッグしてサイズ変更 · 右クリックでロック
LockedHint: ロック中 · 右クリックでロック解除

Configs: {
	MinimapConfig: {
		DisplayName: ミニマップの位置とサイズ

		Enabled: {
			Label: 有効化
			Tooltip: 無効にすると、ミニマップがバニラの状態に戻ります
		}

		FreeAccessorySpace: {
			Label: ミニマップ表示空間の調整
			Tooltip:
				'''
				ミニマップが存在しない場合と同じように、アクセサリー、
				バフ、情報アイコンを配置するようにします

				バニラでは右上にミニマップ用の固定領域が常に確保されています
				ミニマップを元の位置で使用する場合は無効にしてください
				'''
		}

		LockPosition: {
			Label: 位置をロック
			Tooltip:
				'''
				ミニマップの位置とサイズを固定します

				ゲーム内でミニマップを右クリックすると、
				設定画面を開かずに切り替えられます
				'''
		}

		RequireAltToDrag: {
			Label: Altキーを押しながらドラッグ
			Tooltip:
				'''
				有効にすると、Altキーを押している間だけ
				ミニマップをドラッグできるようになります
				
				通常時はミニマップ上でのクリック操作が
				ゲーム側にそのまま反映されます
				'''
		}

		ShowHandles: {
			Label: ドラッグ用ハンドルを表示
			Tooltip: ミニマップにカーソルを合わせた際に、枠線とサイズ変更用のポイントを表示します
		}

		Scale: {
			Label: サイズ
			Tooltip: 1.00がバニラと同じサイズです。ミニマップの端をドラッグして変更できます
		}

		PosX: {
			Label: X座標
			Tooltip: -1に設定すると、バニラと同じ右上の基準位置を維持します
		}

		PosY: {
			Label: Y座標
			Tooltip: -1に設定すると、バニラと同じ右上の基準位置を維持します
		}
	}
}