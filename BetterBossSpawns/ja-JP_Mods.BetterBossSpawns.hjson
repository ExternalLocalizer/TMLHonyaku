Items: {
	ClothSkull: {
		DisplayName: 布製のドクロ
		Tooltip: 夜間に使用するとスケルトロンを召喚する
	}

	LavaproofVoodooDoll: {
		DisplayName: 溶岩耐性ガイドのブードゥー人形
		Tooltip:
			'''
			「君ってなかなかイカした奴だな」
			ガイドに危害を加えず、使用しても消費されない
			'''
	}

	FragrantBulb: {
		DisplayName: 芳香の球根
		Tooltip:
			'''
			強力なジャングルの生物を召喚する
			地下ジャングル以外では激怒する
			'''
	}

	AbandonedIdol: {
		DisplayName: 打ち捨てられた偶像
		Tooltip:
			'''
			古代のリザード族の守護者を召喚する
			地下ジャングル以外では激怒する
			'''
	}

	TruffleHorn: {
		DisplayName: トリュフの角笛
		Tooltip:
			'''
			海に潜む突然変異の恐るべき怪物を召喚する
			海以外では激怒する
			'''
	}

	LacewingInABottle: {
		DisplayName: 瓶詰めのクサカゲロウ
		Tooltip:
			'''
			復讐に燃える妖精の女神を召喚する
			昼間は激怒する
			プリズムクサカゲロウ入りの瓶と間違えないように！
			'''
	}

	SlimyBalloon: {
		Tooltip: スライムレインを発生させる
		DisplayName: ぬめぬめした風船
	}

	InterstellarBeacon: {
		Tooltip: 火星人の襲撃を発生させる
		DisplayName: 星間ビーコン
	}

	WyvernEgg: {
		DisplayName: ワイバーンの卵
		Tooltip: ワイバーンの母を召喚する
	}

	CelestialFragment: {
		DisplayName: 天界の破片
		Tooltip: ダンジョンの教団を率いる狂信的な指導者を召喚する
	}
}

Projectiles.SlimeBalloonProjectile.DisplayName: スライムの風船