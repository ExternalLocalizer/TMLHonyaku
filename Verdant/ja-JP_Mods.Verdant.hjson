ScreenText: {
	RightClick: 右クリックして続ける

Apotheosis: {
	EoWName: イーター
	BoCName: 脳

	Intro: {
		0: こんにちは、旅人。
		1: 新しい顔を見るのは久しぶりだ。
		2: 私のことはアポテオシスと呼んでくれ。
		3: 緑豊かな植物の中心で私たちを見つけてごらん、
		4: 君を助ける贈り物がいくつかあるかもしれない。
		5: さらばだ…
	}

		# Intro.5 "Farewell" line has a little extra space to fade out nicely, keep it there.
		# Try to keep the following lines around the same length, if possible
		
		Greeting: {
			0: 呼吸を忘れずに、
			1: 植物を元気に育て、
			2: あの巨大な目を倒したら私のところに戻ってくるんだ。
			3: また元気な姿で会えることを願っているよ。
		}

		Idle: {
			Normal: {
				0: あの跳ねる芽には特に自信があるんだ。
				1: 私たちは樹木を宿そうとしているが、うまくいったか？
				2: 私の羽ペンはどこだ…ん？
				3: 『私』も『私たち』も、結局同じことだ。
				4: これ以上言うことはない。
				5: 外に出て、花の香りを楽しんでごらん。
				6: さあ、早く行きなさい。
				7: この辺りでヘビを見かけなかったか？
				8: まだ花の香りを覚えている。
				9: カタツムリは過小評価されている生き物だ。
				10: この世界は君の庭だ、友よ。
				11: うろうろする必要はない。
				12: 私たちの草の上に金の山を置くがよい、驚きを得るために…
				13: 時には、夕日を思い出す…
				14: この世界で、君が祝福されることを願っている…
				15: 探索は魂を満たす。
				16: 水の流れに集中し、花々の輝きを感じるがよい…
				17: 持っているものを大切にするがよい、子よ。
				18: 共に成長してきたな、そうだろう？
				19: …私はいい庭師だろうか？
				20: また後で話そう。
				21: もっと花が欲しいか？ふむ…
				22: 火山について知っているか？
				23: テラリウムのように、私は観察する。素敵で、美しい。
				24: すべてと美しさを分かち合おう。
				25: ミツバチを間近で見るのが懐かしい。
				26: ここを歩いているのを見た。楽しんでいるのだろうか？
				27: 踊れるときは踊るがよい、子よ。花々と共に踊れ。
				28: もう少ししか言うことがないのが残念だ。
				29: 何もの君を止めてはならない。私たちも、私も止まってはいないのだから。
			}

			EvilBoss: {
				0: 恵みが君に訪れますように。
				1: "{0}はもはや存在しない。"
				2: 蔓延から解放された存在が…
				3: 失われた空が今は少し澄んでいる。
			}

			Thoughts: {
				0: "自然がもっとも素朴で純粋な場所で…"
				1: ふむ…どうするか…
				2: "害虫駆除か…"
				3: ああ、思い出よ…
				4: 研究、研究、研究…
				5: 葉が落ち、我々は働く…
				6: 物思いにふける私…
				7: 葉と蔓の間に…
				8: 調和の中での共鳴…
				9: …迷子に…
				10: 時々、ただ故郷が見たくなる。
				11: …次は何をする？
				12: もっと花が必要だな…
				13: 蜂たちは、なんて自由なんだ…
				14: 自分の中に慰めを見出して…
			}

			EoC: その偉大な目は驚異であったが、脅威でもあった。

			Skeletron: {
				0: あのスケルトンは…ややこしいやつだったな。
				1: 貧しい者の自由は得られた…
			}

			MiscBosses: {
				KingSlime: ああ、スライムの王が倒された、素晴らしい…
				QueenBee: 私たちのミツバチと素敵な時間を過ごしていることを願っている。
				Scarabeus: 砂漠の砂が今は穏やかに感じる。
				MJW: ああ、あの輝くクラゲの夜を覚えているよ…
				VinewrathBane: 花たちが今、とてもリラックスしているようだ。ありがとう。
				AncientAvian: 空は今、より穏やかになった。よくやった。
				StarplateRaider: あの輝くメカに興味があったが、残念ながら…
				SirNautilus: 魚は魅力的な人々だ...
				SunkenSea: 水草を揺らす波の音が聞こえてくる...
			}

			TearRain: {
				0: ああ、また雨の音が聞けるなんて。 
				1: 私は多くのことを嘆いている。あなたはどうだ？ 
				2: ……思いを巡らせることこそが、生きるということなのか……？ 
				3: 濡れないよう、気をつけて。 
				4: 心が安らぐといいのだが。 
				5: 私たちという存在について、なぜこれほど不確かさを感じるのだ？ 
				6: ああ。流れる水よ……
				7: 私の色を思い出させてくれる。 
				8: さあ、行きなさい。滑らないように。 
				9: ひと粒の涙、そしてまた一つの言葉……
			}
		}

		Downed: {
			EoC: {
				0: 目が討ち倒された。感謝する。
				1: この小物を受け取れ。
				2: "{0}を倒したらまた戻ってきてくれ。"
			}

			Evil: {
				0: "{0}を倒してくれて感謝する…"
				1: 次なる頼みはこれだ。ダンジョン付近の巨大な骸骨を倒してくれ。
				2: これは私の古い装備の一部だ…少し手を加えてある。
			}

			Skeletron: {
				0: ダンジョンの魂は…部分的に解放された。
				1: 君は受け取るにふさわしい。これを持っていってくれ。私たちのお気に入りだ。
				2: さて、地獄の深淵で壁を見つけてくれ。それを取り除いてほしい。
				3: でも、必要なだけ時間をかけてくれて構わない。
				4: 成長は一朝一夕ではない。
			}

			WoF: {
				0: 強力な精霊が解放された…
				1: 私たちがもっと自由になると、いくつかの変化が見えてくるだろう。
				2: もういくつか気づいているかもしれない。ともあれ、
				3: 感謝として、これを受け取ってほしい。私…私はもう必要ないから。
				4: …それと、ここにいる間に、
				5: もっと悪を倒してくれれば、報酬を与えることを知っておいてほしい。
				6: だから、時々様子を見に来てくれ、いいな？
			}

			AnyMech: {
				0: 機械のそのうち一つが打ち倒された。
				1: よくやった！私は何かを作っているところだ…
				2: それは…奇妙だが楽しい。君も楽しんでくれ。
			}

			Plantera: {
				0: 恐ろしい植物が死んだ。
				1: これによって多くのチャンスが生まれる。
				2: これは小さな恩恵だが、役に立てば嬉しい。
				3: これからは、自分で作ることもできるだろう。
				4: これも自由に受け取ってくれ、
				5: これがあれば、きっと役に立つだろう。
			}

			Golem: {
				0: 神殿の守護者が倒された。
				1: これはちょっとした…私の情熱を注いだプロジェクトだ。
				2: これがどれほど役立つかはわからないが、
				3: 楽しいものになると見込んでいる。
				4: 幸運を祈っているよ。
			}

			Cultist: {
				0: あのペテン師どもが倒れたか、ふむ。
				1: 奴らの行いは危険な愚行だった。
				2: 脅威は徐々に…少なくなってきているようだな。
				3: 我らの力の一片を、
				4: 君の加護に捧げよう。存分に楽しむがよい。
			}

			MoonLord: {
				0: どうやらこれが最後の戦いだろうな。
				1: 君が他に何を計画しているかは知らぬが、
				2: 我らに与えられるものはもうほとんど残っていない。
				3: とても楽しかった、
				4: 実に大変でもあったが、
				5: 少し休憩が必要なようだ。
				6: またいつの日か、新たなものに出会うかもしれないな。
			}
		}

		# The following lines are not visible in-game at any point and will be added in a future update.
		# Feel free to skip these until they're added.
		
		PestControlNotif: {
			0: 壁が打ち破られた今、
			1: 我々は自由に浄化を行える。 
			2: この世界の汚染には、もうお気づきだろう？ 
			3: 我々の間で……ある取り決めができるはずだ。 
			4: この汚染は、肉体に憑りついた亡霊のようなもの。 
			5: 我々は肉体を浄化し、その亡霊を退ける手助けができる。 
			6: 単に、その……偶像を我々に渡してくれればいい。 
			7: 備えを万全に。健闘を祈る。
		}

		PestControlWarning: {
			0: 本当に始めるつもりか？ 
			1: これは容易なことではないぞ。 
			2: 準備が必要なら、一旦立ち去るがいい。 
			3: 我々はここにいるぞ。
		}

		PestControl: {
			0: よろしい。 
			1: 準備は万全なのだろうな。 
			2: 害獣を駆除し、侵略を鎮め、
			3: 奴らを打ち倒すのだ。健闘を祈る。
		}

		# Lines after here are in-game.
		
		ItemInteractions: {
			WiltedFlower: {
				0: デイジー、私の好きな花だ。
				1: 残念ながら、長い間見ていないな、ふむ？
				2: ああ、何か気になることがあれば遠慮なく聞いてくれ。
				3: 我々は隠し事はしないのだから。
			}

			ApotheosisBook: {
				0: 私の古いノート。
				1: いつもそれに書いていたのを覚えている、
				2: 今でも、時々書きたくなるんだ。
				3: まあ、もう使えないけれど。
				4: それを見つめるだけでも奇妙なことだ、
				5: 最後にそれに書いた時を考えると…。
			}

			LushLeaf: {
				0: 私たちを囲む葉々、
				1: ある意味、美しい。
			}

			Lightbulb: {
				0: 私の最後の光、それは長い間助けになった。
				1: その光が君にも役立つことを願っている。
			}

			YellowBulb: {
				0: 私の好きな花、
				1: この土地に広げている。
				2: なんて心地よい…
			}

			Wisplant: {
				0: 私たちは本当に…これを実験し始めた。
				1: なぜかわからないが、楽しかった。
			}

			PuffMaterial: 正直に言うと、これを作れるかどうか試してみたかっただけなんだ。
			Halfsprout: 興味深い小さな芽だな、ふむ？
			MysteriaClump: ちょっと、ああ、広がるのは良いことだ。
			PinkPetal: レッドペタルには言わないで。これは私のお気に入り。
			RedPetal: ピンクペタルには言わないで。これは私のお気に入り。

			CrudePaintbrush: {
				0: ああ、私の古い絵筆だ。  
				1: 申し訳ないが、少し急いでいる、  
				2: でもこれが役立つ道具だと知っている。
			}

			Bouncebloom: {
				0: 私たちは…まだ物事を把握している最中だった。
				1: でも、楽しかった。
			}

			Cloudsprout: {
				0: 正直に言うと、なぜこれをしたのかわからない。
				1: 確かに美しいな、ふむ？
			}

			ThornBlock: …
			FlotieItem: 私たちはこの小さな子が大好きだ。
			FlotinyItem: 私たちはこの小さな子が大好きだ。
			LushWingletItem: 最初のうちの一つ…

			Propellerpad: {
				0: 私のお気に入りの一つだ。
				1: シンプルで、クリーンで、自然で、静か。
				2: これ以上何が求められるだろう？
			}

			Mudsquid: {
				0: おそらく私たちの誇るべき成果の一つだ。
				1: こんなものは見たことも、ましてや使ったこともない。
				2: これまでにあまり魔法を使ったことがないが…
			}

			SproutInAGlove: 時には、シンプルさが鍵となる。
			VineHook: この男はいつも人生を楽しんでいる。

			ExpertPlantGuide: {
				0: ああ、私の古い本だ。
				1: 数年前にこれを書いた…
				2: 時が経つのは早いな。
			}

			ApotheoticSoul: {
				0: …
				1: …あまり深く潜らないように、
				2: しかし、これは私たちの力の小さなサンプルだ。
				3: これは君が得たものだ、
				4: そしてここまで来るのはよくやった。
				5: これ以上は必要ないだろう、
				6: 私たちが君に与えたものを理解してくれることを願っている。
				7: 世界は君を大切に思っている、
				8: 君がそれを大切にしているように。
			}

			LushDagger: {
				0: 暴力は避けられないものだが、
				1: 私たちは君が私たちの植物でそれを避けてくれることを願っている。
			}

			BowlFruit: {
				0: ああ、これがボウルフルーツか。なんと美しいものだ。
				1: その味を教えてくれ。
			}

			Dropberry: {
				0: このベリー、実に綺麗だな。
				1: その味を思い出せたなら、どれほど幸せだうか。
			}

			FloralTea: 旅路において、役立つものだろう？

			Grapecherry: {
				0: 科学者たるもの、時として…
				1: 時として、過ちを犯すものだ。
			}

			Mystuber: 揚げようと揚げまいと、心臓に良きものだ。
			Walnut: 時には…シンプルが一番だ。
			Waterberry: 豊富にあるが…もしも…
			HoneyNuggets: 蜂は魔法そのものだ。大切にしてくれ。

			SmokeBulbItem: {
				0: 私たちにできること……それは、どこか不穏なものかもしれない。 
				1: でも、そこにはある種の「遊び心」も宿っていると思わないか？ 
			}

			TearBulbItem: {
				0: これのおかげで、人間らしくいられる気がする。
				1: この……涙を流すということが。 
			}

			SnailStatueItem: {
				0: ……
				1: ……あなたのことを、忘れたくない。 
				TooSoon: ……忘れたくない。まだ……そのときは来てほしくない。 
			}

			HardyVineBook: {
				0: あのツタ（についての、私の古いメモか。 
				1: 不思議なものだ。 
			}

			LeafBook.0: あんなふうに絵を描けたら、よかったのに。 

			LightbulbBook: {
				0: あの小さくて、優しい光たち。 
				1: あなたの滞在が……少しでも素敵なものになればいいのだが。 
			}

			RockBook: {
				0: あの頃抱いていた志を、今でも覚えている。
				1: 無謀な夢だったのかもしれない。 
				2: あるいは……ほんの少しの可能性として、
				3: それはあなたの未来にこそ、待っているものなのかもしれないね。
			}
		}
	}
}

SetBonuses: {
	Lush: 召喚ダメージが1増加
	Mysteria:
		'''
		ブロックや壁の設置速度が上昇し、設置範囲が広がる
		採掘速度が上昇
		敵の出現率が大幅に低下
		'''
	Verdant:
		'''
		召喚ダメージが4%増加
		ミニオンスロットを1つ追加
		落下速度が低下 - 下を押し続けると早く落下
		リスポーン時にライフが50回復
		'''

	Apotheotic: {
		Tree:
			'''
			果物の成長が大幅に早くなる
			果物の効果が強化
			ミニオンスロットを1つ追加
			防御力が10増加
			'''
		Bee:
			'''
			蜂のダメージが増加
			蜂が敵を倒すと、取得するとライフが10回復する蜂蜜のハートがドロップする
			ミニオンスロットを1つ追加
			召喚ダメージが5%増加
			'''
	}
}

