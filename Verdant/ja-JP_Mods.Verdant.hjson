Configs: {
	HeadLabel: Verdant クライアント設定
	EnableSteamEffectLabel: "[i:3365] 蒸気エフェクトを表示"
	EnableSteamEffectTooltip: 地下新緑にいる際、蒸気エフェクトを表示します
	EnableForeOrBackgroundObjectsLabel: "[i:933] 前景/背景オブジェクトを表示"
	EnableForeOrBackgroundObjectsTooltip: 装飾オブジェクトが地表の背景や前景にどこにでも表示されるようにします
	EnableCustomWaterfallsLabel: "[i:2169] カスタム滝を有効にする"
	EnableCustomWaterfallsTooltip: ブロックからしだれ柳のような滝を出現させることを可能にします
	CustomDialogueSystemLabel: "[i:320] カスタムダイアログシステム"
	CustomDialogueSystemTooltip: アポテオシスのカスタムダイアログシステムを使用できるようにします。オフにすると、ただのチャットが使用されます
	FancyBookUILabel: "[i:4065] ファンシーな本のUI"
	FancyBookUITooltip: 本のUIをユニークなものに変更します

	VerdantClientConfig: {
		DisplayName: "{$Mods.Verdant.Configs.HeadLabel}"

		EnableSteam: {
			Label: "{$Mods.Verdant.Configs.EnableSteamEffectLabel}"
			Tooltip: "{$Mods.Verdant.Configs.EnableSteamEffectTooltip}"
		}

		BackgroundObjects: {
			Label: "{$Mods.Verdant.Configs.EnableForeOrBackgroundObjectsLabel}"
			Tooltip: "{$Mods.Verdant.Configs.EnableForeOrBackgroundObjectsTooltip}"
		}

		Waterfalls: {
			Label: "{$Mods.Verdant.Configs.EnableCustomWaterfallsLabel}"
			Tooltip: "{$Mods.Verdant.Configs.EnableCustomWaterfallsTooltip}"
		}

		CustomDialogue: {
			Label: "{$Mods.Verdant.Configs.CustomDialogueSystemLabel}"
			Tooltip: "{$Mods.Verdant.Configs.CustomDialogueSystemTooltip}"
		}

		JungleSpawn: {
			Label: "[i:620] ジャングルのみに生成"
			Tooltip:
				'''
				新緑がジャングルにしか生成されないようにします。
				もしこれが問題であれば、ほとんどのModバイオームを上書きする可能性が低くなります
				'''
			}

		DialogueSpeed: {
			Label: "[i:4485] ダイアログ速度"
			Tooltip: 全ての画面テキストのダイアログ速度を上げたり下げたりできます
		}

		CenterSpawn: {
			Label: "[i:9] 中央に生成"
			Tooltip:
				'''
				新緑をワールドのスポーン地点の真下のみに強制的に生成させます
				砂漠や雪原などのバイオームと重なる可能性があります
				この設定は「ジャングルのみに生成」より優先されます
				'''
		}
	}
}


