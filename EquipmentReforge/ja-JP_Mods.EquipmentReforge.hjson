Configs: {
	EquipmentReforgeConfig: {
		DisplayName: 装備リフォージ設定

		AllowModdedPrefixes: {
			Label: 装備にModで追加された接頭辞が付く
			Tooltip:
				'''
				オンにするとペット、光源ペット、トロッコ、マウント、フックに、
				Modで追加される接頭辞が付くようになります
				オフにするとバニラの接頭辞のみが付くようになり、
				これらのスロットに装備されたアイテムからModの接頭辞の効果がなくなります
				セーブやロードを行っても既存の接頭辞は維持され、接頭辞を変更したい場合は、
				そのアイテムをリフォージしてください
				マルチプレイではホストのみがこの設定を変更できます
				'''
		}

		ReforgeCostMultiplier: {
			Label: 装備のリフォージ費用の倍率
			Tooltip:
				'''
				ゴブリンのよろず屋がペット、光源ペット、トロッコ、マウント、フックのリフォージ費用にかける倍率を変更します
				1に設定すると通常の費用になり、0に設定すると無料でリフォージできるようになります
				ショップの割引やNPCの幸福度による価格の変動も適用されます
				マルチプレイではホストのみがこの設定を変更できます
				'''
		}

		LegacyPricing: {
			Label: 旧バージョンのリフォージ費用を使用
			Tooltip:
				'''
				バージョン1.1.6以前の装備のリフォージ費用を使用します
				オフにすると、費用はその装備の価値以下にはならず、
				価値が1シルバー未満の装備は、同じスロットと同じレアリティの他の装備と同じ価格になります
				マウントやトロッコの追加費用は維持され、リフォージ費用の倍率はこの設定に関係なく適用されます
				'''
		}
	}
}
