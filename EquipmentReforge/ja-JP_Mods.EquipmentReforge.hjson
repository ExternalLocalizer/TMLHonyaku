Configs: {
	EquipmentReforgeConfig: {
		DisplayName: Equipment Reforge 設定

		AllowModdedPrefixes: {
			Label: 装備にMod追加の接頭辞が付く
			Tooltip:
				'''
				オンにするとペット、光源ペット、トロッコ、マウント、フックに、
				Modで追加される接頭辞が付くようになります
				オフにするとバニラの接頭辞のみが付くようになり、
				これらのスロットに装備されたアイテムからModの接頭辞の効果がなくなります
				セーブやロードを行っても既存の接頭辞は維持され、接頭辞を変更したい場合は、
				そのアイテムをリフォージしてください
				マルチプレイではホストのみがこの設定を変更できます
				'''
		}

		ReforgeCostMultiplier: {
			Label: 装備のリフォージ費用の倍率
			Tooltip:
				'''
				ゴブリンのよろず屋のペット、光源ペット、トロッコ、マウント、フックのリフォージ費用の倍率を変更します
				1に設定すると通常の費用になり、0に設定すると無料でリフォージできるようになります
				割引カードや幸福度による費用の変動も適用されます
				マルチプレイではホストのみがこの設定を変更できます
				'''
		}

		LegacyPricing: {
			Label: 旧バージョンのリフォージ費用を使用
			Tooltip:
				'''
				ver 1.1.6以前の装備のリフォージ費用を使用します
				オフだと費用はその装備の価値以下にはならず、
				価値が1シルバー未満の装備は、同じレアリティ、スロットの他の装備と同じ費用設定になります 
				マウントやトロッコの追加費用は維持され、コスト倍率は、どう設定していても適用されます
				'''
		}
	}
}
