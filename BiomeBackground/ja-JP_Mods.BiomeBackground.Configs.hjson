BackgroundMode: {
	Copy: {
		Label: ワールドのコピー
		Tooltip: 
			'''
			ワールド内の実際のブロック、木、植物をもとに、位置をずらして
			少し配置を変えた背景を生成します。
			Modで追加されたコンテンツにも対応しています。
			'''
	}

	Generated: {
		Label: 自動生成
		Tooltip: 
			'''
			ワールドをコピーせず、バニラの各バイオーム用
			テンプレートを使用して架空の風景を生成します
			'''
	}

	Tooltip: ""
}

LayerDistanceMode: {
	Normal: {
		Label: 近い
		Tooltip: 
			'''
			ブロックが大きく表示され、より速く流れます。
			最も細かく表示されますが、背景の動きに
			違和感を覚える場合があります。
			'''
	}

	Far: {
		Label: 遠い
		Tooltip: 
			'''
			デフォルトの設定です。ブロックが小さく、
			ゆっくりと動くため、落ち着いた見た目になります。
			'''
	}

	VeryFar: {
		Label: 非常に遠い
		Tooltip: 
			'''
			ブロックがさらに小さくなり、通常のTerrariaの背景と同程度の
			ゆっくりした動きになります。最も落ち着いた表示方法です。
			'''
	}

	Tooltip: ""
}

BackgroundConfig: {
	DisplayName: ワールドエコー

	Enabled: {
		Label: 有効化
		Tooltip: ワールドエコーの背景表示を切り替えます
	}

	GenerationMode: {
		Label: 生成モード
		Tooltip: 背景の風景を生成する方法を設定します
	}

	Randomness: {
		Label: ランダム性
		Tooltip:
			'''
			コピーモード限定の設定です。コピーした地形をどの程度変形・再配置するかを設定します。
			0 = ワールドの地形をそのまま横にずらしてコピーします。
			'''
	}

	UntouchedWorld: {
		Label: 未改変のワールド
		Tooltip:
			'''
			シングルプレイヤー限定の設定です。既存のワールドを初めて読み込んだ際に、ワールドエコーがシード値から
			ワールドを再生成し（導入しているすべてのModを含む）、その未改変の状態を背景として使用します。
			これにより、プレイヤーが建設した建物や掘ったトンネルが背景に表示されなくなります。
			処理には新しいワールドを生成するのと同程度の時間がかかりますが、実行されるのは一度だけです。
			再生成した結果が元のワールドと一致しない場合（異なるModバージョンで生成された場合など）は、
			自動的に通常の背景へ切り替わります。
			ワールドエコーの更新後は、その時点のワールドの状態から背景が再記録されます。
			未改変の背景に戻したい場合は、ワールド一覧で対象ワールドの横にある木のボタンをクリックしてください。
			元のワールドファイルが変更されることはありません。
			'''
	}

	UpdateInterval: {
		Label: 背景の更新間隔（分）
		Tooltip:
			'''
			ワールドに入ってから1分後、その後は設定したプレイ時間ごとに、ワールドエコーが背景と
			現在のワールドを比較し、不浄、真紅、聖域の侵食や、
			他のModによって追加された新しいバイオームなど、自然に発生した変化を反映します。
			採掘されたブロックや建築資材は無視されるため、トンネルや家が背景に反映されることはありません。
			新しいタイルはタイルのブラックリストにも表示されます。0 = 更新しません。
			すぐに更新を確認したい場合は、/worldecho update と入力してください。
			'''
	}

	SmoothCliffs: {
		Label: 崖を滑らかにする
		Tooltip: 
			'''
			背景にある急な垂直の壁を険しい斜面に変換し、
			不自然に切り取られたような見た目を防ぎます。
			'''
	}

	ShowOcean: {
		Label: 海と砂浜
		Tooltip:
			'''
			有効：海の近くでも他の場所と同様にワールドの地形から背景が生成され、
			実際の砂浜が表示されます。海岸線の先では地形が深く落ち込み、広い海が広がります。
			無効：従来の動作になります。海岸付近の背景には、内陸の地形を反転させたものが表示されます。
			'''
	}

	LayerCount: {
		Label: レイヤー数
		Tooltip: レイヤーを増やすと背景に奥行きが生まれますが、処理負荷が少し高くなります。
	}

	DrawTrees: {
		Label: 木を描画
		Tooltip: 背景に木、ヤシの木、サボテン、巨大キノコを表示します。
	}

	Creatures: {
		Label: 動物と敵
		Tooltip:
			'''
			手前の2つの背景レイヤーに、ウサギ、鳥、スライムがときどき現れ、
			夜になるとゾンビやデーモンアイも出現します。
			バイオームに応じた種類が現れ、実際の生物と同じように動きますが、あくまで背景の演出です。
			攻撃してくることはなく、こちらから攻撃を当てることもできません。
			'''
	}

	Opacity: {
		Label: 不透明度
		Tooltip: 背景レイヤーの見え方を調整します。1 = 完全に不透明になります。
	}

	DepthShadow: {
		Label: 地下の暗さ
		Tooltip: 
			'''
			地面や巨大樹の内部がどの程度暗くなるかを、
			最も近い空間からの距離に応じて設定します。
			0 = 暗くしません。1 = 通常のゲームと同じ暗さになります。
			'''
	}

	TreeDarkness: {
		Label: 巨大樹の暗さ
		Tooltip:
			'''
			巨大樹の内部が、地面と比較してどの程度暗くなるかを設定します。
			1 = 地面とまったく同じ暗さになります。
			非常に大きな木（Remnantsで追加される木など）は、1
			に設定すると暗いシルエットになる場合があります。
			葉を見やすくしたい場合は、この値を下げてください。
			'''
	}

	HeightScale: {
		Label: 丘の高さ
		Tooltip: 
			'''
			背景の丘や谷の起伏を調整します。
			1未満では平坦になり、1を超えると起伏が急になります。
			'''
	}

	VerticalOffset: {
		Label: 垂直方向のオフセット
		Tooltip: 
			'''
			すべてのレイヤーを上下に移動します。
			マイナスの値で上、プラスの値で下に移動します。
			単位：ピクセル
			'''
	}

	SwayingPlants: {
		Label: 植物の揺れ
		Tooltip:
			'''
			背景の樹冠、枝、草、花が、実際のワールドと同じように風で揺れるようになります。
			ゲーム本体の「風の環境演出」設定にも従います。
			'''
	}

	LayerDistance: {
		Label: レイヤーの距離
		Tooltip:
			'''
			背景レイヤーがどの程度遠くに見えるかを設定します。
			遠くするほどブロックが小さくなり、ゆっくりと流れるようになります。
			「近い」では最も細かく表示されます。
			背景の動きで画面酔いする場合は、「非常に遠い」を試してください。
			'''
	}

	HorizonFollow: {
		Label: 地形の高さに追従
		Tooltip:
			'''
			背景が周囲の地形の高さにどの程度追従するかを設定します。
			1 = 周囲の地形と常に高さが揃いますが、長い坂を登ると背景も一緒に移動します。
			0 = 通常のTerrariaの背景と同様に水平線が固定され、最も落ち着いた表示になります。
			背景の動きで画面酔いする場合は、この値を下げてください。
			「レイヤーの距離」を大きくすることもおすすめします。
			'''
	}

	FogStrength: {
		Label: 霧の濃さ
		Tooltip: 
			'''
			遠くのレイヤーが空に溶け込む度合いを設定します。
			0 = 霧なし、1 = デフォルト、2 = 非常に霧が濃くなります。
			'''
	}

	LayerSpacing: {
		Label: レイヤーの間隔
		Tooltip: 
			'''
			レイヤー間の高さの差を設定します。
			0 = すべて同じ高さ、1 = デフォルト
			それ以上では間隔が広がります。
			'''
	}

	SidewaysShift: {
		Label: 水平方向のずれ
		Tooltip:
			'''
			各レイヤーを手前のワールドに対してどの程度横にずらすかを設定します。
			0 = すべてのレイヤーが現在地の地形をそのままコピーします。
			1 = デフォルト、それ以上では地形の配置がより大きく変化します。
			'''
	}

	BiomeLandscapes: {
		Label: バイオームごとの地形
		Tooltip:
			'''
			コピーモード限定の設定です。コピーした地形に各バイオーム特有の地形を追加します。
			雪原には険しい山々、不浄には鋭い尾根、ジャングルには急な丘、
			砂漠にはなだらかな砂丘が形成されます。
			0 = 実際のワールドの地形のみを使用します（デフォルト）。
			'''
	}

	ForestElevation: {
		Label: 森林の標高
		Tooltip: 
			'''
			森林の背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	SnowElevation: {
		Label: 雪原の標高
		Tooltip: 
			'''
			雪原の背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			「バイオームごとの地形」と組み合わせると、高い山々を表現できます。
			'''
	}

	DesertElevation: {
		Label: 砂漠の標高
		Tooltip: 
			'''
			砂漠の背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	JungleElevation: {
		Label: ジャングルの標高
		Tooltip: 
			'''
			ジャングルの背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	CorruptionElevation: {
		Label: 不浄の標高
		Tooltip: 
			'''
			不浄の背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	CrimsonElevation: {
		Label: 真紅の標高
		Tooltip: 
			'''
			真紅の背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	HallowElevation: {
		Label: 聖域の標高
		Tooltip: 
			'''
			聖域の背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	MushroomElevation: {
		Label: キノコバイオームの標高
		Tooltip: 
			'''
			キノコバイオームの背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	BeachElevation: {
		Label: 砂浜の標高
		Tooltip: 
			'''
			砂浜付近の背景を上下に調整します。
			プラスの値で高く、マイナスの値で低くなります。
			単位：ブロック
			'''
	}

	SpawnLivingWoodLeft: {
		Label: 初期スポーン地点の左側
		Tooltip:
			'''
			初期スポーン地点の近くにある、リビングウッドや木の葉のブロック、
			リビングウッドや木の葉の壁で建てられた家は、背景では巨大樹のように見えてしまいます。
			これを防ぐため、初期スポーン地点の近くでは建築資材として扱い、背景から除外します。
			この設定では、初期スポーン地点から左に何ブロックまで適用するかを指定します。
			'''
	}

	SpawnLivingWoodRight: {
		Label: 初期スポーン地点の右側
		Tooltip: 初期スポーン地点から右に何ブロックまで、リビングウッドや木の葉を建築資材として扱うかを設定します。
	}

	SpawnLivingWoodUp: {
		Label: 上方向（地表からの高さ）
		Tooltip:
			'''
			初期スポーン地点付近にある、つながったリビングウッドや木の葉（ブロックと壁）が、
			地表からこの設定値以内の高さであれば、家として扱われ背景から除外されます。
			それより高いものは本物の巨大樹として扱われ、常に全体が残されます。
			木が途中で切断された状態になることはありません。
			'''
	}

	SpawnLivingWoodDown: {
		Label: 下方向（地表からの深さ）
		Tooltip:
			'''
			初期スポーン地点付近にあるリビングウッドや木の葉を、地表から何ブロックの深さまで
			通常の地面に置き換えるかを設定します（地下室などを想定しています）。
			それより深い部分は残され、巨大樹の根も維持されます。
			「上方向」と「下方向」の両方を0にすると、この項目全体が無効になります。
			'''
	}

	ShowSurfaceLine: {
		Label: 地表ラインを表示
		Tooltip: 
			'''
			現在のワールドに対して地表の追跡処理を実行し、その結果を表示します。
			赤 = 追跡した経路、黄 = 各列の最高地点、緑 = 開始地点です。
			'''
	}

	Headers: {
		Motion: 動き
		Biomes: バイオーム
		Spawn: 初期スポーン地点付近のリビングウッド
		Debug: デバッグ
	}
}
