	Flamethrower: {
		Name: 火炎放射器
		Description: 炎のセントリーを召喚し、扇状の範囲内にいる敵へ継続的にダメージを与えます
	}

	MoltenSentinel: {
		Name: 溶岩の番兵
		Description: 炎のセントリーを召喚し、周囲の敵へ継続的にダメージを与えます
	}

	VolatileConstruct: {
		Name: 爆発性構造体
		Description: 炎のセントリーを召喚し、{0}秒後に爆発させます。残りライフに応じて追加ダメージを与えます
	}

	AntlionSwarm: {
		Name: 飛翔アントリオン
		Description: 虫の最大数が半分になりますが、虫が飛行するようになり、与えるダメージが増加します
	}

	LocustBrood: {
		Name: イナゴの大群
		Description: 2倍の数の虫が卵として一度に出現し、しばらくすると孵化します
	}

	GlacialAntlions: {
		Name: 氷河のアントリオン
		Description: アントリオンが100%冷気ダメージを与えるようになります
	}

	Inferno: {
		Name: インフェルノ
		Description: ファイアボールが100%の確率で敵を炎上させます
	}

	FrostfireMeteor: {
		Name: 霜炎の隕石
		Description: ファイアボールがチャネリング式の隕石に置き換わり、[mechanic/shift=0;2:冷気]と[mechanic/shift=1;2:炎]の両方のダメージを与えます
	}

	ShadowflamePyre: {
		Name: シャドウフレイムの火葬壇
		Description: ファイアボールが弧を描いて飛ぶようになり、シャドウフレイムの火葬壇を残します。火葬壇は[mechanic/shift=0;2:混沌]と[mechanic/shift=1;2:炎]のダメージを与え、永続するシャドウフレイムを付与します
	}
}

