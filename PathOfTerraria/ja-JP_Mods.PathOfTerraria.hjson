Quests: {
	Popups: {
		Line1: クエストブックを開けば、進行中のクエストの進み具合や手順を確認可能
		Line2: クエストブックは、インベントリ内で常にマップの隣にある
		Line3: "{0} キーでもブックを開ける。"
		NoKey: （キー未設定 ‐ デフォルトは L）
		NewQuest: 新たなクエスト:
	}

	Bring: {
		Collect: 収集
		GiveItTo: "{0} へ渡す"
	}

	Skip: スキップ？
	Sure: 本当にいい？
	TalkTo: "{0} に話しかける"
	GiveThem: " 以下を渡す："
	Exploration.Ice: 雪原バイオームの探索 ({0}%)
	Or: " or "

	Quest: {
		TestQuest: {
			Name: テストクエスト
			Description: クエスト機能の動作確認用。
		}

		TestQuestTwo: {
			Name: テスト2：エレクトリック・ブーガルー
			Description: より過酷なテストだ。
		}

		BlacksmithStartQuest: {
			Name: 新しい刃の鍛造
			Description: ""
			Kill.Zombies: ゾンビを({0}/{1})体倒す
		}

		KingSlimeQuest: {
			Name: キング討伐
			Description: ""
			EnterDomain: キングスライムエリアへ侵入する
			ThanksDialogue: まさか本当にやり遂げるとは思わなかった。私の失敗を越えたわけだな。私は私で次に備える。もう二度と越えさせはしないが...感謝する。
			Kill.KingSlime: キングスライムを討伐する
		}

		HunterStartQuest: {
			Name: 弓を引け
			Description: ""
			Kill.FloatingMisc: 浮遊モンスター（デーモンアイ／クリメラ／イーターオブソウル）を{0}体倒す
		}

		WitchStartQuest: {
			Name: 太古の魔法
			Description: ""
		}

		WizardStartQuest: {
			Name: 魔法の回帰
			Description: ""
			KillScout: 地上でゴブリン調査員を倒す
			KillSurveyor: レイヴンクレストの左側でゴブリン測量士を倒す
		}

		EoCQuest: {
			Name: 災厄の前触れ
			Description: ""
			Kill.EoC: クトゥルフの目を討伐する
		}

		EoWQuest: {
			Name: 深淵の囁き
			Description: ""
			MorvenRaven: モルヴェンをレイヴン像の元へ連れて行く
			SmashOrbs: シャドウオーブを3つ破壊する
			KillEoW: イーターオブワールドを討伐する
			ReturnToOverworld: 地上世界へ戻る
			MorvenDialogue: フワァ...おや。これはどうも、見知らぬ者よ。窮地を救ってくれたこと、感謝するぞい。実は、印を付けておいたデバウラーを追ってここまで降りてきたのじゃが...まあ、それはいい。頼みの道具が役立たずだったようでな、気づけばこの臭い石の中に閉じ込められたのじゃ。もうずっとここで酷い目に遭っておる。ワシを連れて、カラスの像まで送り届けてくれぬか？礼...？ああ、勿論渡す...つもりじゃ。
			EnterEvilBiome: 地下の不浄で科学者を探す
		}

		BoCQuest: {
			Name: 脈打つもの
			Description: ""
			SmashOrb: ロイドにクリムゾンハートを破壊してもらう
			EnterDomain: クトゥルフの脳エリアに侵入する
			KillBrain: クトゥルフの脳を討伐する
		}

		QueenBeeQuest: {
			Name: 王宮への旅路
			Description: ""
			KillQueen: 女王蜂を討伐する
			EnterDomain: 魔導書から召喚したホーネットを蜂蜜に沈める
		}

		DeerclopsQuest: {
			Name: 氷原の怪物
			Description: ""
			KillDeerclops: ディアクロップスを討伐する
			GetAntlersOrShards: 奇妙な角、または角の欠片
		}

		SkeletronQuest: {
			Name: 白骨の遺物
			Description: ""
			EnterDomain: スケルトロンエリアに侵入する
			KillSkeletron: スケルトロンを討伐する
		}

		WoFQuest: {
			Name: 解き放たれる災厄
			Description: ""
			WizardStart: ふむ...そうだな。はるか地下で大地が震えている。かつて封じられた“それ”のせいだ。昔、冒険者たちは邪悪を疑似的な器に封印した。しかし君が世界中の魔物を屠ったことで、その力が封印へと流れ込んだようだ。つまり――倒さねばならない。急いでスレイン、モルガナ、エラーラに話しかけるといい。武器を用意してくれる。これを持っていけ。健闘を祈る。モルガナにも感謝するといい...あまり詮索はしないでもらいたい。ここは忙しいんでな。
			ThrainHelp: ああ...やはり来たか。これを持て。いつかのために備えていた。アラリックも手を貸してくれてな。俺の戦いの記憶が宿っている。武運を。
			ElaraHelp: 無事を願うわ。あぁ、これも持っていきなさい。派手さはないけど、スレインも手を貸してくれたから質は確かよ。あとは...相対する敵は『目』が弱点って話もあるわね。
			MorganaHelp: おやぁ...ハッハッハ！！ついに時は来た！ほれほれ、魔導書のエサをたんまりと用意したぞぉ！エラーラは実に物知りで役に立ったよ。存分に利用しなさい！バッハッハ！！
			WizardContinue: 受け取ってくれ。爆発？するに決まっておろう、だが君なら大丈夫だ。地獄の灰に投げれば、封印の地への扉が開く。チャンスは一度きり。失敗は許されない。壁の死後も不明だ。だが、倒す必要がある。幸運を。追加注文は...まあ、値段次第だ。
			KillWall: ウォールオブフレッシュを討伐する
			WizardFinish: よく戻ってきてくれた。世界は様変わりしているが、大地の震えは収まった...先は長い。私も、色々と実験したいことがある。
		}

		FirstQuest: {
			Name: レイヴンクレストへ
			Description: ""
			ApproachEntrance: レイヴンクレストの入口へ向かう
			EnterRavencrest: レイヴンクレストに入る
		}

		QueenSlimeQuest: {
			Name: 女王を討て
			Description: ""
			Tiers: ティア1探索マップを{1}個クリアする（{0}/{1}）
			EnterDomain: クイーンスライムエリアへ侵入する
			Boss: クイーンスライムを討伐する
			IlluminantSlimes: イルミナントスライムを({0}/{1})体倒す
			TalkToGarrick: ガリックの元へ戻る
		}

		TwinsQuest: {
			Name: 双子の恐怖
			Description: ""
			Tiers: ティア2探索マップを{1}個クリアする（{0}/{1}）
			EnterDomain: ツインズエリアへ侵入する
			Boss1: レティネイザーを倒す
			Boss2: スパズマティズムを倒す
			Wraiths: レイスを({0}/{1})体倒す
			PossessedArmors: ポゼッションアーマーを({0}/{1})体倒す
			WanderingEyes: ワンダリングアイを({0}/{1})体倒す
			CollectFragments: ワンダリングアイ、ポゼッションアーマー、またはレイスから月光の欠片を5個集める。
		}

		TinkerIntroQuest: {
