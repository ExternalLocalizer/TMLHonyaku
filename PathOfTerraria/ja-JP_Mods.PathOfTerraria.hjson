Mechanics: {
	Shift: (Shiftキー長押しで関連メカニクスを表示)
	SmallShift: (shift)
	Mechanic: メカニクス
	Scroll: ({0} / {1}、マウスホイールで表示切替)

	Error: {
		Tag: (無効)
		Description: このメカニクスタグは無効です。
	}

	Self: {
		Tag: メカニクスタグ
		Description: 下線付きのタグにカーソルを合わせると、機能の詳細を確認できます！
	}

	ElementalDamage: {
		Tag: 属性ダメージ
		Description:
			'''
			属性ダメージは、他のダメージに固定値で追加したり、割合で変換したりできます。
			これにより追加ダメージを与えたり、他のメカニクスと相乗効果を得たり、デバフを付与したりできます。
			'''
	}

	Fire: {
		Tag: 炎属性ダメージ
		Description: 属性ダメージの一種で、クリティカルヒット時に「炎上」を付与します。「炎上」は、その攻撃のダメージに応じて威力が増加する継続ダメージ系デバフです。
	}

	Cold: {
		Tag: 冷気属性ダメージ
		Description: 属性ダメージの一種で、まれに「氷結」を付与します。氷結中は敵が完全に行動不能になり、その持続時間は与えたダメージに応じて変化します。
	}

	Lightning: {
		Tag: 雷属性ダメージ
		Description: 属性ダメージの一種で、「感電」を付与します。感電した対象は被ダメージが増加します。
	}

	Chaos: {
		Tag: 混沌ダメージ
		Description: 混沌ダメージは「毒」を付与します。毒は重ねがけ可能な継続ダメージ系デバフです。属性ダメージには含まれません。
	}

	Ravencrest: {
		Tag: レイヴンクレスト
		Description: 冒険者たちの主要な拠点となる町で、クエストの中心地でもあります。
	}

	Mapping: {
		Tag: マッピング
		Description: マップデバイスを使用すると、所持している任意のマップへ移動できます。主にボスのエリアへ向かうために使用します。
	}

	Blocking: {
		Tag: ブロック
		Description: 一部の装備品、主に盾には、一定確率で攻撃を「ブロック」する効果があります。
	}

	Affixes: {
		Tag: 接頭辞
		Description: 接頭辞はランダムに付与され、その対象にさまざまな強化効果を与えます。
	}

	MapAffixes: {
		Tag: マップ接頭辞
		Description: マップに変化を加え、難易度を大きく上昇させる接頭辞です。効果はエリアレベルに応じて強化されます。
	}

	ItemAffixes: {
		Tag: アイテム接頭辞
		Description:
			'''
			アイテムにランダムで付与される接頭辞です。
			付与される接頭辞は、アイテムのレベル、種類、レアリティによって決まります。
			'''
	}

	EnemyAffixes: {
		Tag: 敵接頭辞
		Description: 敵に適用される接頭辞です。NPCのレアリティに応じて、コモンは0個、マジックは2個、レアは4個付与されます。
	}

	AreaLevel: {
		Tag: エリアレベル
		Description: 現在いるエリアのレベルです。戦利品のレベル、出現する接頭辞、敵のステータス、アイテムやNPCのレアリティに影響します。
	}

	ItemRarity: {
		Tag: アイテムレアリティ
		Description:
			'''
			エリアレベルとマップ接頭辞に応じてランダムに決まるレアリティです。マジックには1～2個、レアには3～4個の接頭辞が付与されます。
			ユニークはこれらとは別枠で、ランダム性は低いものの、武器としてはより複雑な性能を持つことが多いです。
			'''
	}

	GrimoirePickups: {
		Tag: 魔導書素材
		Description: 魔導書を通じて召喚を行うために使用する素材です。拾った後は魔導書の保管庫内でのみ確認できます。
	}

	Questing: {
		Tag: クエスト
		Description: 世界各地を探索すると、クエストブックに記録して追跡できるクエストが見つかります。新たなボスやコンテンツ、さまざまな報酬につながります。
	}

	DamageOverTime: {
		Tag: 継続ダメージ
		Description: 「毒」や「炎上」のように、一定の間隔でダメージを与えるデバフです。
	}

	Nearby: {
		Tag: 近距離
		Description: 対象から150ピクセル以内の範囲です。「効果範囲の増加」などの影響は受けません。
	}

	Far: {
		Tag: 遠距離
		Description: 対象から150ピクセルより離れた範囲です。「効果範囲の増加」などの影響は受けません。
	}

	BehaviorSpeed: {
		Tag: 挙動速度
		Description: "[mechanic:ActionSpeed]と[mechanic:MovementSpeed]をまとめた速度です。エンティティがどれだけ速く移動するか、どれだけ頻繁に行動できるかの両方を表します。"
	}

	ActionSpeed: {
		Tag: 行動速度
		Description: エンティティが行動できる頻度です。
	}

	MovementSpeed: {
		Tag: 移動速度
		Description: エンティティが移動する速さです。
	}

	Siphon: {
		Tag: ライフ吸収
		Description: 与えたダメージに応じて体力を回復する効果です。
	}

	Intelligence: {
		Tag: 知力
		Description: 10ポイントにつき最大マナを5増加させる能力値です。
	}

	Strength: {
		Tag: 筋力
		Description: 10ポイントにつき最大体力を5増加させる能力値です。
	}

	Dexterity: {
		Tag: 敏捷
		Description: 10ポイントにつき、すべてのアイテムの使用速度を0.1%増加させる能力値です。
	}
}

