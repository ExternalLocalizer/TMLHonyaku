Configs: {
	DeveloperConfig: {
		DisplayName: 開発者設定 [i:509]

		DrawUIBorders: {
			Label: UIボーダー表示
			Tooltip: UIデバッグ用に各要素の枠線を表示します
		}

		SaveSubworlds: {
			Label: サブワールドを保存
			Tooltip: 
				'''
				サブワールドを保存するかどうか設定します
				サブワールドのテスト時に便利です
				'''
		}

		LogFilterRejections: {
			Label: アイテムフィルターの除外をログ出力
			Tooltip: 
				'''
				適用中のアイテムフィルターによって除外された各アイテムについて、
				フィルター・アイテム・失敗した条件を示すメッセージをチャットとMod.Loggerに出力します
				デバッグビルドでのみ有効です
				'''
		}
	}

	UIConfig: {
		DisplayName: UI設定
		Headers.UI: UI

		DisplayRichTooltipsInHotbar: {
			Label: ホットバーに詳細ツールチップを表示
			Tooltip: 
				'''
				ホットバーの各要素にカーソルを合わせた際、
				アイテムや要素の名前だけでなく、詳細なツールチップを表示します
				'''
		}

		PreventExpBarClicking: {
			Label: 経験値バーのクリック無効化
			Tooltip: レベルアップメニューをホットキーからのみ開くようにします
		}

		UseVirtualBag: {
			Label: 収納袋を使用
			Tooltip: ドメイン内で収納袋を使用できるようになり、インベントリ管理がしやすくなります
		}

		ShowLootBeams: {
			Label: ドロップアイテムに光柱を表示
			Tooltip: 戦利品フィルターでハイライト対象となったアイテムの上に光柱が表示されます
		}
	}

	GameplayConfig: {
		DisplayName: ゲームプレイ設定
		Headers.Gameplay: ゲームプレイ

		NearbyAuras: {
			Label: オーラ表示
			Tooltip: 
				'''
