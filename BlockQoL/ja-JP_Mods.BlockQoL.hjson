NewTooltips: {
	PotentLifeFruit: 最大ライフを恒久的に10増加させる
	PotentLifeCrystal: 最大ライフを恒久的に40増加させる
	ReforgeDiscount: リフォージが{0}%割引される
	BoosterUsed: このアイテムはすでに使用している！
	BoosterUsedWorld: このアイテムはすでにこのワールドで使用している！
	BoosterUsedHeart: ライフクリスタルはすでに最大数まで使用している！
	BoosterUsedMana: マナクリスタルはすでに最大数まで使用している！
	BoosterUsedFruit: ライフフルーツはすでに最大数まで使用している！
}

AwarenessMessages: {
	travellingMerchantIsBouttaLeaveWakeTheFUp: "{0}が出発の準備をしています！"
	rainStart: 頭上から雨が降り始めた！
	rainEnd: 空が晴れてきた…
	windStart: 強い風が吹き始めた…
	windEnd: 激しい風は静まりつつある…
	sandStart: 強い風が砂漠で砂嵐を引き起こしている！
	sandEnd: 砂漠の地表は再び穏やかになった…
	lanternStart: 美しいランタンが夜空を埋め尽くしている！
	lanternEnd: ランタンフェスティバルは終わりを迎えた…
	starStart: 流れ星が大空を舞っている！
	starEnd: 流星群が終わった…
	bloodEnd: ブラッドムーンが過ぎ去りました！
	eclipseEnd: 日食が終了した！
	HealRefresh: ライフ回復アイテムがリフレッシュ！
	LowHP: 危ない！
	VeryLowHP: ライフが少ない！
}

Configs: {
	ConfigClient: {
		DisplayName: クライアント設定

		Headers: {
			HeaderEtc: その他
			HeaderItemAccess: アイテムバフ
			HeaderNewItems: 新しいアイテム
			HeaderAwareness: 案内通知
		}

		noTooltipChanges: {
			Label: "[i:171] ツールチップの置き換えの防止"
			Tooltip:
				'''
				互換性の為に、このModによるツールチップの置き換えと変更を無効化します
				ツールチップと実機能に矛盾が生じる可能性がある為、必要な場合のみ有効にしてください
				既存のツールチップを置き換えず、新たにツールチップを付け足す機能には影響しません
				'''
		}

		potentLifeCrystal: {
			Label: "[i:29] 強力なライフクリスタル"
			Tooltip:
				'''
				ライフクリスタルを使用すると増加する最大ライフ値が2倍になります
				ライフクリスタルによる最大ライフ上限は400のままで、
				これは単純に上限に達するまでの時間を短縮するだけの機能です
				特に大規模なマルチプレイヤーサーバーで、
				全員のライフを最大にするにはライフクリスタルが足りない場合に最適です
				'''
		}

		potentLifeFruit: {
			Label: "[i:1291] 強力なライフフルーツ"
			Tooltip:
				'''
				ライフフルーツを使用すると増加する最大ライフ値が2倍になります
				ライフフルーツによる最大ライフ上限は500のままで、
				これは単純に上限に達するまでの時間を短縮するだけの機能です
				特に大規模なマルチプレイヤーサーバーで、
				全員のライフを最大にするにはライフクリスタルが足りない場合に最適です
				'''
		}

		passiveDiscount: {
			Label: "[i:854] 割引カードがインベントリでも機能する"
			Tooltip:
				'''
				インベントリや虚空の金庫内にあっても、
				情報系アクセサリーと同じく割引カードの効果が発揮されるようになります
				貪欲の指輪や、本Modのクラブ・ゴブリンカード(及びその強化版)のリフォージ価格の割引にも適用されます
				「パッシブアクセサリーが金庫内でも機能する」がオンだと、
				この設定の効果は全ての個人用ストレージにも拡張されます
				'''
		}

		goblinDiscount: {
			Label: "[i:BlockQoL/GoblinCard] クラブ・ゴブリンカードの割引%"
			Tooltip:
				'''
				クラブ・ゴブリンカードはゴブリンのよろず屋が、
				死んだ際に50%の確率でドロップする新しいアクセサリーです
				設定した%、リフォージの価格が割引されます
				 (例：30に設定するとリフォージ価格が30%割引されます)
				設定値を0にするとカードはドロップしますが、割引されなくなります
				'''
		}

		manaGlow: {
			Label: "[i:109] マナクリスタルが光る"
			Tooltip:
				'''
				マナクリスタルが青く光るようになり、発見が格段に容易になります
				この設定は光の強度/明るさを調整します。数値が高いほど光が強くなります
				0に設定すると光らなくなります
				マナクリスタルは通常、タイル状態では自然生成されないため、ゲームプレイに実質的な影響はありません 
				'''
		}

		heartGlow: {
			Label: "[i:29] ライフクリスタルが光る"
			Tooltip:
				'''
				ライフクリスタルがピンク色に光るようになり、発見が格段に容易になります
				この設定は輝きの強度/明るさを調整します。数値が高いほど光が強くなります
				0に設定すると光らなくなります
				ライフクリスタルの大岩にも影響することに注意してください
				'''
		}

		lifeGlow: {
			Label: "[i:1291] ライフフルーツが光る"
			Tooltip:
				'''
				ライフフルーツが黄色く光るようになり、発見が格段に容易になります
				この設定は光の強度/明るさを調整します
				数値が高いほど光が強くなります
				0に設定すると光らなくなります
				'''
		}

		boosterChecklist: {
			Label: "[i:5339] 永続効果アイテムの案内通知"
			Tooltip:
				'''
				永続的な強化アイテム(例：ライフフルーツや手作りパンなど)を最大数まで使用すると、
				追加のツールチップが表示され、使用済みであることが分かるようになります
				'''
		}

		weatherAwareness: {
			Label: "[i:4075] 天候の案内通知"
			Tooltip:
				'''
				雨・風の日・砂嵐のイベントがいつ始まるか、またはいつ終わるかを 、
				自分だけに知らせるステータスメッセージを追加します
				なお「風の強い日」のステータスメッセージは、風が十分に強いとき (昼間に限らず) なら、
				常に通知されます
				'''
		}

		needRadioForWeather: {
			Label: "[i:3037] 天気ラジオがないと天候案内が表示されない"
			Tooltip:
				'''
				天候案内のステータスメッセージが、
				天気ラジオかその上位アイテムを所持している場合に表示されるようにします
				天候案内メッセージが天気ラジオの存在価値を完全に失わないようにするため、推奨されます
				'''
		}

		calmNightAwareness: {
			Label: "[i:4702] ランタンナイト&流星群の案内通知"
			Tooltip:
				'''
				ランタンナイトと流星群イベントの開始と終了を 、
				自分だけに 通知するステータスメッセージを追加します
				 (ご存知ない方のために補足すると、流星群は流れ星が大量に降ってくる平和的なイベントです) 
				'''
		}

		darkMoonAwareness: {
			Label: "[i:2767] ブラッドムーン&日食の案内通知"
			Tooltip:
				'''
				ブラッドムーンと日食イベントが終了した際に 、
				自分だけに通知するステータスメッセージを追加します
				開始時のメッセージは既にバニラで実装されているため追加されません
				'''
		}

		lowHealthThresh: {
			Label: "[i:321] 低ライフ時の案内通知のしきい値"
			Tooltip:
				'''
				このModは、ライフが低い状態にある間およびライフが低下した際に視覚的な合図を表示します
				この設定は、ライフが低い状態と見なされるしきい値を決定します
				 ここで設定する数値は、低いと見なされるライフの割合です (例：20に設定した場合、ライフが20%未満の状態が低いと見なされます) 
				このしきい値を下回ると、プレイヤーの頭上にテキストポップアップと墓石エモートが表示され、効果音が鳴ります
				 閾値の半分まで低下した際にも再度通知が発生します (例：30に設定した場合、ライフが15%未満で効果が再発動) 
				低ライフ状態中は、プレイヤー本体とライフゲージの両方が赤く点滅します
				'''
		}

		healAwareness: {
			Label: "[i:188] 回復アイテムの案内通知"
			Tooltip:
				'''
				ポーション酔いが治るたびに視覚効果と効果音が発生され、
				再度回復アイテムが使用できるようになったことを教えてくれます
				発動時、プレイヤーは赤いダストを放出し、ライフポーションのエモートを表示
				さらに、プレイヤーの頭上にテキストポップアップが表示され、効果音が再生されます
				'''
		}

		bankPassives: {
			Label: "[i:346] パッシブアクセサリーが金庫内でも機能する"
			Tooltip:
				'''
				虚空の金庫だけでなく、全ての個人用ストレージから、
				全てのバニラの情報アクセサリーが効果を発揮するようになります
				個人用ストレージには貯金箱・金庫・ディフェンダーの炉・虚空の金庫が該当します
				また「割引カードがインベントリでも機能する」とも連動します
				'''
		}

		teamAutoJoin: {
			Label: "[i:1969] 自動的にチームに参加"
			Tooltip:
				'''
				ワールドに入る度に、ここで選択したチームに自動的に設定されます
				マルチプレイヤーで友達とチームを組むのを忘れがちな場合に便利です
				'''
		}

		tMerchWarning: {
			Label: "[i:5343] 旅商人の出発通知"
			Tooltip:
				'''
				旅商人が出発する直前に 、自分に通知するステータスメッセージを追加します
				メッセージは午後5:00に送信されます。これは旅商人が午後6:00に出発する1分前です
				旅商人の在庫確認を忘れがちな場合に重宝します
				'''
		}

		subtleHealthAwareness: {
			Label: "[i:28] ライフ関連の案内通知の字幕"
			Tooltip:
				'''
				回復アイテムと低ライフ警告の設定の字幕ポップアップを無効化し、
				後者のカラーパルス効果も無効化します
				また、これらの機能のその他の視覚効果と音響効果も一部削減します
				'''
		}

		shorterRespawn: {
			Label: "[i:BlockQoL/AscendentCross] 昇天の十字架のリスポーン時間"
			Tooltip:
				'''
				昇天の十字架は、シマーに金色の墓石 (どのバリエーションでもよい)、
				を投げ入れると入手できる新たな永続効果の消費アイテムです
				使用すると、プレイヤーのリスポーン時間がここで設定した値 (秒単位) に短縮されます
				参考までに、デフォルトのリスポーン時間は通常10秒、エキスパート以上では15秒です
				設定値がデフォルト (上記10/15秒) を超える場合、デフォルトの復活時間が適用されます
				ボス戦中は常にデフォルト時間が適用されます
				イベント中、時間短縮効果は減少します (詳細は「イベント中の復活効果」参照) 
				'''
		}

		healthyRespawn: {
			Label: "[i:BlockQoL/AscendentCross] 昇天の十字架のリスポーン時のライフ"
			Tooltip:
				'''
				昇天の十字架は、金色の墓石 (どのバリエーションでもよい) 、
				を投げ入れると入手できる新たな永続効果の消費アイテムです
				使用すると、プレイヤーはここで設定した数値に等しいライフの割合でリスポーンします
				 (例：80に設定した場合、最大ライフの80%) 
				参考までに、デフォルトではプレイヤーは最大ライフの50% (または固定値100ライフか高い方) でリスポーンします
				ここで設定した値よりデフォルトのリスポーン時のライフが高い場合、デフォルトの値が適用されます
				ボス戦中かイベント中は、効果が弱まります (詳細は「イベント中リスポーン効果」を参照) 
				'''
		}

		eventRespawnPotency: {
			Label: "[i:BlockQoL/AscendentCross] イベント中のリスポーン効果減少"
			Tooltip:
				'''
				ボス戦中かイベント中は、昇天の十字架の効果は減少します
				昇天の十字架の効果は、ここで設定した倍率で増加します
				例えば0.5に設定した場合、アセンデント・クロスの効果は通常の50%になります
				ボス戦中は、リスポーン時間の短縮効果は設定に関係なく無効化されます
				'''
		}

		guidelightGlow: {
			Label: "[i:BlockQoL/EternalGuidelight] 永遠のガイドライトの明るさ"
			Tooltip:
				'''
				永遠のガイドライトは、瓶詰めの星をシマーに投げ入れると入手できる新たな永続効果の消費アイテムです
				使用すると、プレイヤーは自由にオン/オフ可能な発光効果を得ます
				 (インベントリ左端のアイコンでオンオフを切り替える) 
				この効果の明るさはここで調整でき、デフォルトでは非常に控えめになっています
				0に設定すると光らなくなり、1に設定すると輝きのポーションと同じくらいになります
				'''
		}

		needGuidelightForHeartGlow: {
			Label: "[i:BlockQoL/EternalGuidelight] ﾗｲﾌ/ﾏﾅｸﾘｽﾀﾙ/ﾌﾙｰﾂの発光には永遠のガイドライトが必要"
			Tooltip:
				'''
				永遠のガイドライトは、瓶詰めの星をシマーに投げ入れると入手できる新たな永続効果の消費アイテムです
				これがオンだと、ライフ/マナクリスタル/フルーツは、
				プレイヤーがエターナルガイドライトを使用していないと光らなくなります
				'''
		}
	}

	ConfigServer: {
		DisplayName: サーバー設定

		Headers: {
			HeaderItemAccess: アイテムのアクセシビリティ
			HeaderNewItems: 新しいアイテム
			HeaderNPCs: NPC/敵の調整
			HeaderEtc: Header Etc Header
		}

		downgradeZapinator: {
			Label: "[i:4348] オレンジザッピネーターとヘルファイアのシマー変換"
			Tooltip:
				'''
				オレンジザッピネーターをグレーザッピネーターへ、ヘルファイアをカスケードへ変化できるようになります
				これによりハードモード以降でもグレーザッピネーターとカスケードが入手できるようになります 
				(通常はハードモード前限定) 
				'''
		}

		snowGlobeDrop: {
			Label: "[i:602] 季節外でもスノードームをドロップ"
			Tooltip:
				'''
				スノードーム (フロストレギオンの召喚アイテム) をハードモード中に、
				雪原か地下氷雪洞窟内で倒した敵からドロップするようにします
				この設定はスノードームのドロップ率を変更します
				ここで設定した数値はドロップ確率の分母となります (例：100 => 1/100) 
				吹雪中は追加ドロップ試行が発生し、ドロップ率が約2倍になります
				さらに、アイスミミックとアイスゴーレムはそれぞれ10倍・20倍の確率で追加ドロップ試行を行います
				ドロップを完全に無効化するには0に設定してください
				※このドロップはクリスマスイベントとは独立しており、
				プレゼントからスノードームが入手できる点は変わりません
				'''
		}

		sellSunCompass: {
			Label: "[i:BlockQoL/SunCompass] 太陽のコンパスの販売条件"
			Tooltip:
				'''
				太陽のコンパスはジャングル寺院の場所の発見を容易にする道具です
				この設定で設定した進行度に基づき、ウィッチドクターが販売するようになります
				'''
		}

		sellExtractinator: {
			Label: "[i:997] 取り出し機の販売"
			Tooltip:
				'''
				オンにすると爆破技師が取り出し機を販売するようになり、
				このアイテムを確実に入手できるようなります
				この設定で、爆破技師がどの進行度で販売するかを変更します
				'''
		}

		goldCreditRing: {
			Label: "[i:3035] 貪欲の指輪がゴールドクレジットカードの機能を継承"
			Tooltip:
				'''
				ゴールドクレジットカードは、割引カードとクラブ・ゴブリンカード(新規アクセサリー)を、
				合成した新しいアクセサリーです
				この設定により貪欲の指輪の作成には割引カードではなく、
				ゴールドクレジットカードを使用し、そのリフォージ割引効果を継承します
				Thorium Modで有効だと、貪欲なゴブレットもリフォージ割引を継承するようになります
				'''
		}

		safeLarva: {
			Label: "[i:1133] ハチの幼虫は採掘が必要"
			Tooltip:
				'''
				オンにすると、背景オブジェクトの幼虫(クイーンビーを召喚する)が武器で破壊されるのを防ぎます
				これにより幼虫は採掘されたときのみ破壊され、
				流れ弾が誤って女王蜂を召喚するのを防ぐことができます
				'''
		}

		cycloneDrop: {
			Label: "[i:BlockQoL/LivingCyclone] 生きている竜巻のドロップ"
			Tooltip:
				'''
				生きている竜巻は、一定時間、風速を大幅に増加させる新しい消費アイテムです
				風速が時速20マイル以上 (凧のドロップ条件と同じ) の状態で、全ての敵がドロップします
				ここに設定した数値はドロップ率の分母を表します (例：100 => 1/100) 
				代替として、飛行のソウル・羽根・雲ブロックを用いて生きている竜巻を作成できます
				0に設定するとドロップしなくなり、作成できなくなります
				注：風速が低い状態で使用すると、このアイテムの効果は最も顕著に現れます
				'''
		}

		nimbusDrop: {
			Label: "[i:BlockQoL/LostNimbus] 迷子の雨雲のドロップ"
			Tooltip:
				'''
				迷子の雨雲は、嵐を発生させる新しい消費アイテムです
				このアイテムは、雨が降っている間、地表 (地下ではない) にいる全ての敵がドロップします
				ここで設定する数値はドロップ率の分母を表します (例：100 => 1/100) 
				あるいは、空/宇宙での釣り中に、ごく稀に釣り上げられることもあります
				0に設定するとドロップしなくなり、ロストニンバスが釣り上げられなくなります
				'''
		}

		slabDrop: {
			Label: "[i:BlockQoL/SandstormSlab] サンドストームスラブのドロップ"
			Tooltip:
				'''
				サンドストームスラブは、砂嵐を発生させる新しい消費アイテムです
				砂嵐中の砂漠にいると、全ての敵がドロップします
				ここで設定した数値はドロップ率の分母を表しています (例：100 = 1/100) 
				上記のドロップに加え、ほとんどの地下砂漠の敵は、
				さらに半分の確率で常にサンドストームスラブをドロップする事があります
				また、サンドエレメンタルはサンドストームスラブのドロップ率が10倍です
				これを0に設定すると、地下砂漠の敵やサンドエレメンタルを含め、ドロップしなくなります
				注: このアイテムを使用する前に強風(30mph以上)が吹くのを待つことを強く推奨します！
				そうでないと砂嵐の時間が非常に短くなってしまいます
				'''
		}

		plantSummoner: {
			Label: "[i:BlockQoL/SusBulb] プランテラの召喚アイテム"
			Tooltip:
				'''
				怪しい球根はプランテラを手動で召喚する新しい消費アイテムです
				この設定はアイテムの入手可否を決定し、バラの花弁のドロップ可否を切り替えます
				バラの花弁は怪しげな球根の作成に使用する新たなアイテムで、
				プランテラの球根やプランテラ本体がドロップします
				プランテラとの再戦プロセスを効率化し、戦闘場所をより自由に選択できるようになります
				'''
		}

		noMobGriefing: {
			Label: "[i:169] アントリオンとスノーバラに荒らされなくなる"
			Tooltip:
				'''
				オンにするとアントリオンとスノーバラの投擲で砂と雪ブロックが設置されなくなります
				代わりに、発射物は消滅時にそれぞれのブロックをアイテムの状態でドロップします
				なお、これらの投擲が当たったブロックは、
				その傾斜が影響を受ける可能性があります(砂と雪が隣接状態を考慮して設置されるように)
				'''
		}

		bossZen: {
			Label: "[i:3117] ボス戦中の出現率低下"
			Tooltip:
				'''
				ボス戦中、敵の出現率と出現上限に設定された係数が乗算されます
				さらに、パンプキンムーンとフロストムーンの間は、ハーピーとワイバーンの出現が抑制されます
				ランダムな敵の出現によってパーティーが乱れ、ボス戦が不必要に複雑になるのを防ぎます
				'''
		}

		safeBoundNPCs: {
			Label: "[i:3352] 拘束されたNPCのDRの増加"
			Tooltip:
				'''
				オンにすると拘束されたNPC (およびゴルファーなどの救助可能な対象) が、
				被ダメージを軽減するようになります
				数値が高いほどDRが増加し、低いほど減少し、0に設定すると無効化されます
				全てのダメージ源に影響しますが、ダメージを0まで軽減することはできません
				拘束されたNPCが到達前に死亡するケースが多い場合に有用かもしれません
				'''
		}

		safeCritters: {
			Label: "[i:4767] 安全な生物"
			Tooltip:
				'''
				オンにすると小動物 (ウサギや金魚など) が、
				敵や投射物によるダメージを受けなくなります
				プレイヤーが小動物にダメージを与えることは防がず、
				生き物とのつきあい方か平和的共存への道は変わらず必要です
				なお、溶岩など他の危険源に対しては効果はありません
				'''
		}

		tougherNPCs: {
			Label: "[i:5336] タウンNPCのライフ増加"
			Tooltip:
				'''
				町のNPC・町のペット・旅商人・骸骨商人のライフを増加させます
				増加量はNPCの基本ライフ (デフォルトNPCは全て250) にここで設定した数値を乗じた値となります
				例：初期値250の場合、0.5に設定するとNPCのライフは375 (250×0.5＋125) に増加
				NPCのライフ回復量も同様の倍率で強化されます
				高難易度でNPCが脆すぎる場合に有効です。0に設定すると強化効果を無効化します
				既存のNPCのライフは更新されません。変更を適用するには、
				NPCを消滅 (倒す) させて再出現させる必要があります
				これはまた、このModを無効化してもNPCのHPが元のレベルに戻らないことを意味します！
				'''
		}

		safePets: {
			Label: "[i:4830] 安全なタウンペット"
			Tooltip:
				'''
				町のペット (犬・猫・ウサギ・タウンスライム) が、
				敵対的な敵や投射物でダメージを受けなくなります
				ペットは全く身を守れないため、この効果で安全を確保できます
				ただし、溶岩など他の危険源に対しては効果はありません
				'''
		}

		sellTeleportPotions: {
			Label: "[i:2997] 商人が帰還/ワームホールポーションを販売する"
			Tooltip:
				'''
				商人が帰還のポーションとワームホールポーションを販売するようになります
				ポーションはインベントリに所持している場合にのみ販売されます
				 (例：追加購入には帰還のポーションを所持している必要がある) 
				ポーションの購入価格は平均より高いことに注意してください
				'''
		}

		boundNpcWhitelist: {
			Label: "[i:3352] 拘束NPCホワイトリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「拘束されたNPCのDRの増加」設定において、
				拘束されたNPCとして扱われます
				手動でMod製エンティティを対応させるのに適しています
				'''
		}

		critterWhitelist: {
			Label: "[i:4767] 生物ホワイトリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「安全な生物」設定において、生物として扱われます
				手動でMod製エンティティを対応させるのに適しています
				'''
		}

		npcWhitelist: {
			Label: "[i:5336] タウンNPCホワイトリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「タウンNPCのライフ増加」設定能において、
				タウンNPCとして扱われます
				手動でMod製エンティティを対応させるのに適しています
				'''
		}

		petWhitelist: {
			Label: "[i:4830] タウンペットホワイトリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「安全なタウンペット」設定において、
				タウンペットとして扱われます
				手動でMod製エンティティを対応させるのに適しています
				'''
		}

		bossZenWhitelist: {
			Label: "[i:3117] ボス戦中の出現率ホワイトリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「ボス戦中の出現率低下」設定において、
				ボスとして扱われます
				手動でMod製エンティティを対応させるのに適しています
				'''
		}

		goblinCard: {
			Label: "[i:BlockQoL/GoblinCard] クラブ・ゴブリンカードの無効化"
			Tooltip:
				'''
				クラブ・ゴブリンカードはゴブリンのよろず屋がドロップする新アクセサリーで、
				リフォージの価格を割引します
				オンにすると、このアイテムがドロップしなくなり、入手できなくなります
				クライアント設定でクラブ・ゴブリンカードの割引率をカスタマイズすることも可能です
				'''
		}

		critterBlacklist: {
			Label: "[i:4767] 生物のブラックリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「安全な生物」設定において、
				決して生物として扱われなくなります
				これはホワイトリストとデフォルトのロジックを上書きします
				'''
		}

		boundNpcBlacklist: {
			Label: "[i:3352] 拘束NPCのブラックリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「拘束されたNPCのDRの増加」設定において、
				決してNPCとして扱われなくなります
				これはホワイトリストとデフォルトのロジックを上書きします
				'''
		}

		bossZenBlacklist: {
			Label: "[i:3117] ボス戦中の出現率ブラックリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「ボス戦中の出現率低下」設定において、
				決してボスとして扱われなくなります
				これはホワイトリストとデフォルトのロジックを上書きします
				'''
		}

		npcBlacklist: {
			Label: "[i:5336] タウンNPCのブラックリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「タウンNPCのライフ増加」設定において、
				決してタウンNPCとして扱われなくなります
				これはホワイトリストとデフォルトのロジックを上書きします
				'''
		}

		petBlacklist: {
			Label: "[i:4830] タウンペットブラックリスト"
			Tooltip:
				'''
				このリストに追加されたエンティティは「安全なタウンペット」設定において、
				決してタウンペットとして扱われなくなります
				これはホワイトリストとデフォルトのロジックを上書きします
				'''
		}

		lifeFruitSeeds: {
			Label: "[i:1291] 豊潤なライフフルーツ"
			Tooltip:
				'''
				成長の杖(もしくは斧)でのライフフルーツの収穫量が2倍になります
				例えば0.4に設定した場合、40%の確率でライフフルーツがドロップします
				0に設定すると、ライフフルーツボーナスは完全に無効化されます
				'''
		}

		persistentBuffs: {
			Label: "[i:3198] 持続するバフ効果"
			Tooltip:
				'''
				このリストに追加されたバフ効果は死亡後も持続します
				バランスの取れたプレイのため、無期限の持続時間を持つバフや、
				その発生源を入手すれば自由に適用できるバフに最適です
				デフォルトリストのステーション付与バフが良い例です。
				好みに応じてミニオンやペットのバフも望ましい場合があるでしょう
				'''
		}
	}
}

Projectiles.CompassBeam.DisplayName: コンパスのビーム

Items: {
	SunCompass: {
		DisplayName: 太陽のコンパス
		Tooltip:
			'''
			リザードの祭壇の方向を示す無害なビームを発する
			ジャングル寺院からリザードの祭壇を取り除くと、コンパスは機能しなくなる
			「名前とは裏腹に、天を目指すというよりは緑豊かな深部を指し示しているようだ」
			'''
	}

	GoldCredit: {
		DisplayName: ゴールドクレジットカード
		Tooltip:
			'''
			アイテムが20%割引される
			[placeholder]
			「朗報: 私は信用に値する！」
			'''
	}

	GoblinCard: {
		DisplayName: クラブ・ゴブリンカード
		Tooltip:
			'''
			[placeholder]
			「ただの小さなゴブリンさ」
			'''
	}

	SandstormSlab: {
		DisplayName: サンドストームスラブ
		Tooltip:
			'''
			砂嵐を起こす
			風速が特に速い時に使用するのが最適、そうでないと砂嵐は一瞬しか続かない
			「スラブを元に戻すべきだったんだよ」
			'''
	}

	LostNimbus: {
		DisplayName: 迷子の雨雲
		Tooltip: 雨が降り始める
	}

	LivingCyclone: {
		DisplayName: 生きている竜巻
		Tooltip:
			'''
			強風を引き起こす
			この効果は、風速が小さいときに使うと最も顕著になる
			「こりゃ…だいぶ…ウィムディ」
			'''
	}

	PlanteraPetal: {
		DisplayName: バラの花弁
		Tooltip: 「ジャングルに生えている奇妙な球根を思い起こさせる」
	}

	SusBulb: {
		DisplayName: 怪しい球根
		Tooltip: プランテラを召喚する
	}

	AscendentCross: {
		DisplayName: 昇天の十字架
		Tooltip:
			'''
			リスポーン時間を永続的に短縮し、リスポーン時のヘルスが永続的に増加する
			ボス戦中か侵攻イベント中は、これらの効果が減少する
			「死は敗北した」
			'''
		MunchiesTip: "[i:3230] 黄金の墓石をシマーに投げ込む"
	}

	LifeFruitSeed: {
		DisplayName: ライフフルーツの種
		Tooltip: 「マジカル！」
	}

	EternalGuidelight: {
		DisplayName: 永遠のガイドライト
		Tooltip:
			'''
			インベントリの左端に機能切り替えボタンを解除する
			オンにすると操作キャラクターが光るようになる
			'''
		MunchiesTip: "[i:1431] 瓶詰めの星をシマーに投げ入れる"
	}
}

BuilderToggles: {
	EternalGuidelightToggle: {
		OnText: ガイドライト: On
		OffText: ガイドライト: Off
	}
}