Configs: {
	UIConfig: {
		DisplayName: UI 設定

		horizontalPercentage: {
			Label: 水平スクリーン比率
			Tooltip: 0%は左、100%は右
		}

		verticalPercentage: {
			Label: 縦画面比率
			Tooltip: 0%は上、100%は下
		}

		horizontalPixelOffset: {
			Label: 位置設定(横方向)
			Tooltip: -なら右側へ、+なら左側へ移動します。UIが表示されていない場合は0に設定してみてください
		}

		verticalPixelOffset: {
			Label: 位置設定(縦方向)
			Tooltip: -なら上側へ、+なら下側へ移動します。UIが表示されていない場合は、0に設定してみてください
		}

		visible: {
			Label: UIの可視性の動作
			Tooltip:
				'''
				UIの可視性の動作を決定します
				常に表示： 常にUIを表示します
				ボス戦時のみ表示：ボス戦のときのみUIを表示します
				表示しない： UIを表示しません
				'''
		}

		condition: {
			Label: UIの表示タイミング
			Tooltip:
				'''
				UIの可視性の動作 と連動して、UIが表示されるタイミングを決定します
				空中で表示： 空中で表示します
				ジャンプを押したときに表示： 空中でジャンプを押すと表示します
				'''
		}

		drawInsignia: {
			Label: 飛翔記章を装備しても表示
			ToolTip:
				'''
				バニラでは、飛翔記章により無限の飛行時間を得るので、このUIを表示させるのはかなり冗長でしょう
				Modによって飛翔記章が無限の飛行時間を持たないように変更された場合は、このUIを使用してください
				'''
			Tooltip:
				'''
				バニラでは、飛翔記章により無限の飛行時間を得るので、このUIを表示させるのはかなり冗長でしょう
				Modによって飛翔記章が無限の飛行時間を持たないように変更された場合は、このUIを使用してください
				'''
		}

		drawDigits: {
			Label: 残り飛行時間
			Tooltip: 残り時間（秒）を書き込むかどうかを決定します。この設定は推奨されます
		}

		Headers: {
			Placement: 配置
			Visibility: 視認性
			Style: スタイル
		}

		style: {
			Label: UI スタイル
			Tooltip: ""
		}

		drawOnHoverMounts: {
			Label: ホバーマウント時に表示
			Tooltip:
				'''
				ホバーマウントには[i:2768]、[i:2769]、[i:4444]のようなものが含まれるが、[i:2502]も含まれます
				ホバーを使用しているマウントが必ずしも無限に飛行するとは限らないので、
				この設定をオンにすることによりホバーマウントにもUIバーを描画することを可能にします
				意図しない不具合を引き起こす可能性があります。バーを描画すべきModマウントに描画する最後の手段として使用しましょう
				'''
		}
	}

	UIDrawRule: {
		Tooltip: ""

		AlwaysDraw: {
			Label: 常に表示
		}

		DrawDuringBoss: {
			Label: ボス戦時のみ表示
		}

		NeverDraw: {
			Label: 表示しない
		}
	}

	UIDrawCondition: {
		DrawWhenJumpIsPressed: {
			Label: ジャンプを押したときに表示
		}

		DrawInAir: {
			Label: 空中で表示
		}

		Tooltip: ""
	}

	UIStyle: {
		Tooltip: ""

		Classic: {
			Label: クラシック
		}

		Fancy: {
			Label: ファンシー
		}
	}
}

