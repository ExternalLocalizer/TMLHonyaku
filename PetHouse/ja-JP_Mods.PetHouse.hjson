Configs: {
	PetHouseServerConfig: {
		DisplayName: ペットハウスのワールドルール
		Headers.TranslationNotice: 英語以外のテキストは機械翻訳（AI）されています

		PetsPerHouse: {
			Label: 1軒あたりのペット数
			Tooltip: 
				'''
				1つのペットハウスから出現できるペットの最大数（デフォルト：256）
				128を超える値を設定すると、特にマルチプレイでパフォーマンスが低下する可能性があります。
				'''
		}

		PetsAcrossWorld: {
			Label: 全ペットハウスのペット数
			Tooltip: 
				'''
				このワールド内で活動できるペットハウスのペットの最大数（デフォルト：128）
				128を超える値を設定すると、特にマルチプレイでパフォーマンスが低下する可能性があります。
				'''
		}

		ActivationDistanceTiles: {
			Label: 出現距離（タイル）
			Tooltip: 
				'''
				ペットが出現するには、プレイヤーがペットハウスから
				この距離以内にいる必要があります（デフォルト：120）
				'''
		}

		DespawnDistanceTiles: {
			Label: デスポーン距離（タイル）
			Tooltip: 
				'''
				この距離以内にプレイヤーがいない場合、ペットは去ります。
				出現距離より短い距離では機能しません（デフォルト：160）
				'''
		}

		MaximumWanderTiles: {
			Label: 最大行動範囲（タイル）
			Tooltip: 
				'''
				各ペットハウスの行動範囲スライダーの上限を設定します。
				この上限を引き下げても、保存済みのペットハウス設定は維持されます
				（デフォルト：160）
				'''
		}

		AllowIdleInteractions: {
			Label: 待機中の交流を許可
			Tooltip: 対応する決闘を含め、各ペットハウスの放置中（AFK）の交流を許可します。
		}

		AllowMokouKaguyaFights: {
			Label: 妹紅と輝夜の戦闘を許可
			Tooltip: 
				'''
				ペットハウスに住む妹紅と輝夜の戦闘を許可します。
				無効にすると、ほかの待機中の交流を無効にせずに、
				現在の決闘を中断し、新たな決闘を防止します。
				'''
		}

		NativeCompanionFamilies: {
			Label: TouhouPets本来のグループ行動
			Tooltip:
				'''
				ペットハウスに住む紅魔館の姉妹と従者、チルノと大妖精、妹紅と輝夜は、
				TouhouPets独自の隊列、ポーズ、決闘を使用して一緒に行動し、ときどき一時的に別行動を取ります。
				無効にすると、Pet Houseの古い独自のペア隊列を使用します。
				'''
		}

		NativeVanillaAI: {
			Label: バニラペットとミニオンの本来の動作
			Tooltip:
				'''
				ペットハウスに住むバニラのペットとミニオンは、Pet Houseの簡略化された動作ではなく、
				Terraria本来の移動とアニメーション（歩行、飛行、向き、ワームの胴体）を使用して家の周囲を動き回ります。
				ミニオンが攻撃することはありません。
				無効にすると、以前の簡略化された動作を使用します。
				'''
		}

		AllowModdedPets: {
			Label: 他Modのペットを許可
			Tooltip:
				'''
				他Modの見た目用ペットと光源ペット（ミニオンを除く）を、それぞれ本来の移動とアニメーションを使用してペットハウスに住まわせます。
				住んでいる間に繰り返し自分自身を消滅させるペットは、簡略化された動作に切り替えられ、
				その後も消滅を繰り返す場合は、そのセッション中は住まわせなくなります（client.logを参照）。
				TouhouPetsのペットは常に許可されます。
				'''
		}

		AllowTouhouChatter: {
			Label: TouhouPetsの会話を許可
			Tooltip: ペットハウスで発生するTouhouPetsの会話を切り替えます
		}

		MaximumChatterPercent: {
			Label: TouhouPetsの最大会話頻度（%）
			Tooltip: 各ペットハウスのTouhouPetsの会話設定に上限を設けます（デフォルト：200%）
		}

		AllowVanillaPetLighting: {
			Label: バニラの光源ペットの発光を許可
			Tooltip: 
				'''
				デフォルトは無効。
				ペットハウスに住むバニラの光源ペットが周囲を照らせるようにします。
				攻撃、バフ、収納へのアクセス、会話は有効になりません。
				'''
		}

		IntermittentVanillaLightPets: {
			Label: バニラの光源ペットの間欠動作
			Tooltip: 
				'''
				ペットハウスに住むバニラの光源ペットが、アニメーションと静止した
				休息フレームを交互に繰り返します。
				発光するのは「バニラの光源ペットの発光を許可」が有効な場合のみです。
				TouhouPetsの発光は引き続きTouhouPets自身によって制御されます。
				'''
		}

		LightActiveSeconds: {
			Label: 発光中の動作時間（秒）
			Tooltip: 
				'''
				ペットハウスに住むバニラの光源ペットが、
				各周期でアニメーションして発光する時間（デフォルト：3）
				'''
		}

		LightRestSeconds: {
			Label: 消灯中の休息時間（秒）
			Tooltip: 
				'''
				ペットハウスに住むバニラの光源ペットが、
				各周期で発光せずに休息する時間（デフォルト：8）
				'''
		}
	}
}

Items: {
	PetHouseItem: {
		DisplayName: ペットハウス
		Tooltip:
			'''
			「旅の仲間たちのための居心地のよい家」
			ペットと光源ペットの召喚アイテム、ミニオンの召喚杖を中に収納できる
			住んでいるペットは、ペットやミニオンのスロットを使用せずに周囲を歩き回る
			住んでいるミニオンは装飾用であり、攻撃は行わない
			40スロットの収納ページが2つあり、家のパネルで「ページ切り替え」を使用できる
			家を右クリックすると設定を確認できる
			'''
	}
}

UI: {
	StoragePage: 収納ページ {0}/{1}
	Title: ペットハウス
	Intro: 召喚アイテムを収納すると、ペットが家の周囲を自由に動き回ります。
	AfkOn: 放置中の交流：有効
	AfkOff: 放置中の交流：無効
	AfkHelp: 対応するペット同士が、待機中に特別な行動を取るようになります。
	WanderArea: 行動範囲：{0}タイル
	WanderHelp: ペットが家からどこまで離れて行動できるかを設定します。
	Chatter: 会話頻度：{0}%
	ChatterHelp: TouhouPetsの会話頻度を調整します。0%にすると会話しなくなります。
	PetCount: ペット：{0}/{1}（ワールド全体：{2}/{3}）
	Empty: 召喚アイテムを収納して、ペットを迎え入れましょう。
	Waiting: プレイヤーが近くにいると、まもなくペットが姿を現します。
	Capacity: 収容上限に達しています。収納スロットの先頭から優先されます。
	Active: 召喚アイテムを取り出すと、対応するペットが帰っていきます。
}

Tiles.PetHouseTile.MapEntry: ペットハウス
Projectiles.DecorativeChester.DisplayName: 観賞用チェスター