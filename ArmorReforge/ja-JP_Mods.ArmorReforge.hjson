Configs: {
	ArmorReforgeConfig: {
		DisplayName: 防具リフォージ設定

		AllowModdedPrefixes: {
			Label: 防具にMod追加の接頭辞が付く
			Tooltip:
				'''
				オンにすると防具にModで追加される接頭辞が付くようになります
				オフにするとバニラの接頭辞のみが付くようになり、
				防具からModの接頭辞の効果がなくなります
				セーブやロードを行っても既存の接頭辞は維持され、接頭辞を変更したい場合は、
				そのアイテムをリフォージしてください
				マルチプレイではホストのみがこの設定を変更できます
				'''
		}

		ReforgeCostMultiplier: {
			Label: 防具のリフォージ費用の倍率
			Tooltip:
				'''
				ゴブリンのよろず屋の防具と衣装用の防具のリフォージ費用の倍率を変更します
				1に設定すると通常の費用になり、0に設定すると無料でリフォージできるようになります
				ショップの割引やNPCの幸福度による価格の変動も適用されます
				マルチプレイではホストのみがこの設定を変更できます
				'''
		}

		LegacyPricing: {
			Label: 旧バージョンのリフォージ費用を使用
			Tooltip:
				'''
				バージョン1.4.3以前の防具のリフォージ費用を使用します
				オフだと費用はその防具の価値以下にはならず、
				価値が1シルバー未満の防具は、同じレアリティの他の防具と同じ価格になります
				リフォージ費用の倍率は、この設定のオン・オフにかかわらず適用されます
				'''
		}

	}
}
