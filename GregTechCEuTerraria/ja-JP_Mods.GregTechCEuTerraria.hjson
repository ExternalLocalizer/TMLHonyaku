Keybinds: {
	RecipeBrowserHowToObtain: {
		DisplayName: レシピブラウザ：入手レシピ
	}

	RecipeBrowserUsedAsIngredient: {
		DisplayName: レシピブラウザ：使用先レシピ
	}
}

ArmorSet: {
	Nano: 一定確率で攻撃を回避、移動速度+10%
	Quark: 被ダメージ12%軽減、防御力+6
}

NPCs: {
	CausticReactor: {
		DisplayName: コースティックリアクター
		Bestiary: 封印を破って浮遊する化学反応炉。試薬を幾何学模様の酸性噴霧として撒き散らす。追跡はせずその場に留まって腐食性の光で戦場を塗り潰し、わずかな安全地帯を見つけられるか試される。
	}

	FallenEBF: {
		DisplayName: フォールンEBF
		Bestiary: 過熱によってコイルから引き剥がされ、空を飛ぶようになった電気高炉。精錬そのものを攻撃手段とし、生成物を周囲へと浴びせかける。
	}

	ImplosionPress: {
		DisplayName: インプロージョンプレッサー
		Bestiary: マフラーから過剰圧力を放出し続ける暴走した爆縮圧縮機。空間そのものを内側へ引き寄せて隙間を潰して空気を爆縮させる。最終段階では戦場そのものからダイヤモンドを鍛造する。
	}

	SoulDistiller: {
		DisplayName: ソウルディスティラー
		Bestiary: 精製した魂を取り込みすぎた蒸留塔が、配管の蛇となって這い出した姿。倒しても別の部位で蒸留されるだけで、それぞれが戦い続ける。
	}

	SoulDistillerFraction: {
		DisplayName: ソウルディスティラー
	}

	VacuumFreezer: {
		DisplayName: バキュームフリーザー
		Bestiary: アンカーを失い空へ浮かび上がった密閉式冷凍チャンバー。自ら追いかけることはなく、敵を引き寄せて冷媒で周囲を霧に包み、急速冷凍された金属片を放出しながら冷気で追い詰める。
	}

	EBFChanNPC: {
		DisplayName: EBFちゃん
		Bestiary: 堕ちた器が打ち倒された後、穏やかな性格になった電気高炉の精霊。熱処理した素材を扱う小さな露店を営んでおり、いつ触れてもほんのり熱い。
		DeathMessage: "{0}のコイルを冷ましてしまった..."

		Census: {
			SpawnCondition: Census.SpawnConditions.Guide
		}

		Chat1: ちょっと待ってて、まだカンタルのインゴットを焼いてるところだから...
		Chat2: ケーシングには触らないで。熱いから。全部熱いの。
		Chat3: オーバークロックは計画的にね。無茶した設備がどうなるか、私はよく知ってるから。

		TownNPCMood: {
			Content: 今の暮らしには満足しているよ。
			NoHome: 家がないのは嫌だよ。
			FarFromHome: 家から遠すぎるよ。
			LoveSpace: 広々した場所は大好きだよ。
			DislikeCrowded: 人が多すぎるのはちょっと苦手かな。
			HateCrowded: 人が多すぎて嫌になるよ。
			LikeNPC_Princess: "{NPCName}のことは気に入ってるよ。"
			Princess_LovesNPC: "{NPCName}のことは大好きだよ。"
		}
	}

	SoulDistillerBody: {
		DisplayName: ソウルディスティラーの胴体
	}

	SoulDistillerTail: {
		DisplayName: ソウルディスティラーの尾
	}
}

