}

Configs: {
	GTConfig: {
		DisplayName: GregTech 設定

		EnableBossDrops: {
			Label: GregTechボスドロップを有効化
			Tooltip: 有効にすると、バニラボスがGregTechの関連アイテムをドロップします。
		}

		NetworkSyncPeriod: {
			Label: ネットワーク同期周期
			Tooltip: ""
		}

		SimulationSpeed: {
			Label: シミュレーション速度
			Tooltip: ""
		}

		OrderedAssemblyLineFluids: {
			Tooltip: ""
			Label: 組立ラインの液体順序固定
		}

		OrderedAssemblyLineItems: {
			Tooltip: ""
			Label: 組立ラインのアイテム順序固定
		}

		LdFluidPipeMinDistance: {
			Tooltip: ""
			Label: 長距離液体パイプの最小距離
		}

		LdItemPipeMinDistance: {
			Tooltip: ""
			Label: 長距離アイテムパイプの最小距離
		}

		EnableProfiler: {
			Tooltip: ""
			Label: プロファイラーを有効化
		}

		DebugMobs: {
			Tooltip:
				'''
				すべての投射物に当たり判定を表示し、生存中のカスタムボスごとに情報パネルを表示します
				（現在の攻撃、タイマー、フェーズ、HP%、背景生成カウントダウン、現在の投射物数、直近の攻撃履歴）
				表示のみの機能で、戦闘中に切り替えても安全です
				'''
			Label: Mobデバッグ表示
		}

		CleanMultiblocks: {
			Tooltip: ""
			Label: マルチブロックを初期化
		}

		EnableCleanroom: {
			Tooltip: ""
			Label: クリーンルームを有効化
		}
	}

	GTClientConfig: {
		ShowDiscordInvite: {
			Tooltip: ""
			Label: Discord招待リンクを表示
		}

		DisplayName: GregTech クライアント設定
	}
}

