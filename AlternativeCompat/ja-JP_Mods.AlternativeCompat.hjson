Contagion: {
	Tiles.MagicStorage.BacciliteStorageUnitTile.MapEntry: バクシライトのストレージユニット

	Items: {
		MagicStorage: {
			BacciliteCore.DisplayName: ストレージコア (バクシライト)

			BacciliteStorageUnitItem: {
				DisplayName: バクシライトのストレージユニット
				Tooltip:
					'''
					マジックストレージのシステムにアイテムを保管するための部品
					80アイテムを保管できる
					'''
			}

			BacciliteUpgrade: {
				DisplayName: バクシライトのストレージアップグレード
				Tooltip:
					'''
					ストレージユニットの容量を80に増やす
					ストレージユニットに<right>で容量を増やせる
					'''
			}
		}
	}
}

Depths: {
	BPCrystalSkinPotion:
		'''
		水銀を無効化し、被ダメージを軽減する
		さらに10%の確率で敵の弾を反射する
		'''
	BPBuffCrystalSkin:
		'''
		水銀を無効化し、被ダメージを軽減する
		さらに10%の確率で敵の弾を反射する
		'''
	Tiles.MagicStorage.ArqueriteStorageUnitTile.MapEntry: アルケライトのストレージユニット

	Items: {
		MagicStorage: {
			ArqueriteCore.DisplayName: ストレージコア (アルケライト)

			ArqueriteStorageUnitItem: {
				DisplayName: アルケライトのストレージユニット
				Tooltip:
					'''
					マジックストレージのシステムにアイテムを保管するための部品
					120アイテムを保管できる
					'''
			}

			ArqueriteUpgrade: {
				DisplayName: アルケライトのストレージアップグレード
				Tooltip:
					'''
					ストレージユニットの容量を120に増やす
					デモナイト/クリムタンのストレージユニットに<right>で容量を増やせる
					'''
				TooltipAvalon: デモナイト/クリムタン/バクシライトのストレージユニットに<right>で容量を増やせる
				TooltipGeneral: 邪悪なストレージユニットに<right>で容量を増やせる
			}
		}
	}
}

