Items: {
	WoodenDummy: {
		DisplayName: 木のダミー
		Tooltip:
			'''
			ノックバックに弱い木のダミーを召喚する
			ターゲット指定が必要
			右クリックで全ダミーを削除
			'''
	}

	StoneTarget: {
		DisplayName: 石のターゲット
		Tooltip:
			'''
			ダミーの防御を10上げる
			右クリックで全ダミーに取り付け
			'''
	}

	StoneDummy: {
		DisplayName: 石のダミー
		Tooltip:
			'''
			ノックバック耐性50%の石のダミーを召喚する
			ターゲット指定が必要
			右クリックで全ダミーを削除
			'''
	}

	IronTarget: {
		DisplayName: 鉄のターゲット
		Tooltip:
			'''
			ダミーの防御を50上げる
			右クリックで全ダミーに取り付け
			'''
	}

	IronDummy: {
		DisplayName: 鉄のダミー
		Tooltip:
			'''
			ノックバックを一切受けない鉄のダミーを召喚する
			ターゲット指定が必要
			右クリックで全ダミーを削除
			'''
	}

	WoodenTarget: {
		DisplayName: 木のターゲット
		Tooltip:
			'''
			ダミーの防御を0上げる（飾り用）
			右クリックで全ダミーに取り付け
			'''
	}

	DummyKiller: {
		DisplayName: ダミークリーナー
		Tooltip: 信号を受け取るか右クリックで召喚中の全ダミーを削除
	}

	DummySpawner: {
		DisplayName: ダミーサモナー
		Tooltip:
			'''
			信号を受け取るか右クリックでダミーを召喚する
			ダミーを入れると召喚ダミーを指定可能
			ターゲットを入れるとターゲットタイプを指定可能
			'''
	}
