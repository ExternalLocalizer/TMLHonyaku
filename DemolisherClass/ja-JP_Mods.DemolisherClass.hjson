Achievements: {
	FallingBombs: {
		FriendlyName: 落ちる爆弾
		Description: 飛行船を指揮する狂人、エクスプローシブ船長を倒す。
	}

	AnarchistCookbookObtained: {
		FriendlyName: マザー・アナーキーがかつて作っていたように
		Description: 精巧に作り上げられた混沌のハンドブックである爆発物の説明書を手に入れる。
	}

	NovaArmorObtained: {
		FriendlyName: 最高級の爆撃機
		Description: 爆発的なパワーとファッションの頂点、ノヴァの防具セットを手に入れる。
	}

	HeavyPlateArmorObtained: {
		FriendlyName: 錆びた記憶
		Description: ヘビープレートアーマーセットを入手…これは妙に見覚えがある。
	}

	CryHavoc: {
		FriendlyName: クライ・ハボック
		Description: 究極の大量破壊兵器、ロケットミニガンを手に入れる。
	}

	IAmBecomeDeath: {
		FriendlyName: 私は死になった
		Description: 核のリモコンを手に入れれば、あなたは世界を破壊する力を手にいれる…少なくとも少しは。
	}

	SurströmmingAchievement: {
		FriendlyName: なぜこれを食べるのか
		Description: シュールストレミングを食べる。なぜそんなことをするの？	
	}

	Shrubbery: {
		FriendlyName: 低木による死
		Description: クロッパーやブームベリーの茂みにやられる。
	}

	CEShopAchievement: {
		FriendlyName: 船長の目録
		Description: エクスプローシブ船長の幽霊が販売する全てのアイテムを購入する。	
	}

	ThinkFastChucklenuts: {
		FriendlyName: 早く考えろ、チャックルナッツ
		Description: 敵、友人、あるいは自分自身の愚かさからフラッシュバンの閃光を受ける。
	}

	ShellShocked: {
		FriendlyName: シェルショック
		Description: 群れを産み出し、爆発するサンゴで侵入者を攻撃する巨大なクラブ、マザーコーラルシェラーを倒す。
	}

	SulphurShatterer: {
		FriendlyName: サルファーシャタラー
		Description: 硫黄の塊であり、激しい噴火を起こすサルファーエレメンタルを倒す。
	}

	FoiledPlans: {
		FriendlyName: 失敗に終わった計画
		Description: CEの予備計画を倒す。これはエクスプローシブ船長が君を抹殺するために作り上げた最後の兵器だ。もしAIに制御されていなければ、彼は成功していたかもしれない。
	}

	CrabulaRaza: {
		FriendlyName: クラブラ・ラザ
		Description: 全てのタイプのシェラーを倒す。
	}
}

