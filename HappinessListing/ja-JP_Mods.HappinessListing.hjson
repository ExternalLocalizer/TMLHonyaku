Configs: {
	HappinessListingConfig: {
		DisplayName: クライアント設定

		Headers: {
			HappinessDialogueOptions: "[c/00FF00:幸福度のセリフの設定]"
			RegularDialogueOptions: "[c/00FF00:セリフの設定]"
			BestiaryOptions: "[c/00FF00:図鑑設定]"
		}

		BreakEntriesWithNewLine: {
			Label: "[i:LaserRuler] セリフを分割"
			Tooltip:
				'''
				各セリフが新しい行に表示されます
				オフにするとバニラの動作に戻ります
				デフォルトはオン
				'''
		}

		EntryIconType: {
			Label: "[hlhi:love] アイコンのタイプ"
			Tooltip:
				'''
				各セリフの前に文字かアイコンが表示されます
				オフにするとバニラの動作に戻ります
				デフォルトは幸福度のアイコン
				'''
		}

		MaxTextLines: {
			Label: "[i:ThePlan] セリフの最大行数"
			# 	TML145
			# 	'''
			#	Increases or decreases the number of lines the dialogue can be on.
			#	Anything line beyond the value set will be cut off.
			#	Vanilla defaults to 10.
			#
			#	Range: 1-50
			#	Change to 10 for vanilla behavior.
			#	Default by mod: 20
			#	'''
			Tooltip:
				'''
				セリフの行数を変更します
				設定した値を超える行は全て切り捨てられます
				バニラ版のデフォルト値は10

				範囲: 1-20
				10にするとバニラの動作に戻ります
				デフォルトは16
				'''
		}

		ColorCodeHappinessText: {
			Label: "[i:RedPaint] 幸福度のセリフに色を付ける"
			Tooltip:
				'''
				幸福度に関するセリフに色を付けます
				なしにするとバニラの動作に戻ります
				デフォルトはゲーム内の色
				'''
		}

		MaxNumberOfPeoplePrincessCanTalkAboutAtOnce: {
			Label: "[i:PrincessWeapon] プリンセスのセリフの最大数"
			Tooltip:
				'''
				プリンセスが一度にコメントできるタウンNPCの人数を変更します
				バニラでは、プリンセスは近くのランダムな3人のタウンNPCについてしか言いません
				幸福度をクリックするたびに

				範囲: 1-20
				3にするとバニラの動作に戻ります
				デフォルトは5
				'''
		}

		SimplifiedHappinessDialogue: {
			Label: "[i:NecromanticScroll] 幸福度のセリフを簡略化する"
			Tooltip:
				'''
				幸福度に関するセリフを全てシンプルなものに置き換えます
				例: 「私は{NPC}を愛しているよ。」 「私は{Biome}が嫌いだ。」 「私は混雑が嫌いだ。」
				オフにするとバニラの動作に戻ります
				デフォルトはオフ
				'''
		}

		ColorCodeRegularDialogue: {
			Label: "[i:BluePaint] 通常のセリフに色を付ける"
			Tooltip:
				'''
				通常のセリフに色を付けます
				なしにするとバニラの動作に戻ります
				デフォルトはなし
				'''
		}

		BestiaryFlavorTextEntry: {
			Label: "[i:DontHurtNatureBook] 図鑑に幸福度に関する説明を追加"
			Tooltip:
				'''
				タウンNPCの図鑑での説明に好み/嫌いに関する情報を追加します
				これらは情報に表示されていません
				基本的にタウンNPCはプリンセスが好き
				基本的にタウンNPCは不浄・真紅・ダンジョンが嫌い

				なしにするとバニラの動作に戻ります
				デフォルトは幸福度アイコン

				図鑑を再初期化するにはページを再読み込みする必要があります
				この設定はメインメニューから変更できます
				'''
		}
	}

	IconType: {
		Tooltip: ""

		None: {
			Label: なし
			Tooltip:
				'''
				{$Label}

				各セリフの前には、文字やアイコンは表示されません
				バニラの動作に戻すか、この機能を無効にするにはこの設定にしてください
				'''
		}

		Asterick: {
			Label: *
			Tooltip:
				'''
				{$Label}

				各セリフの前に*が付きます
				'''
		}

		Bullet: {
			Label: ・
			Tooltip:
				'''
				{$Label}

				各セリフの前に・が付きます
				'''
		}

		Emoticons: {
			Label: 絵文字
			Tooltip:
				'''
				{$Label}

				各セリフの前に絵文字が付き、それで好きか嫌いか判別できます
				  {$UI.HappinessWords.Love}    :D
				  {$UI.HappinessWords.Like}    :)
				  {$UI.HappinessWords.Dislike} :(
				  {$UI.HappinessWords.Hate}    :'(
				'''
		}

		HappinessIcon: {
			Label: 幸福度アイコン
			Tooltip:
				'''
				{$Label}

				各セリフの前にアイコンが付き、それで好きか嫌いか判別できます
				  {$UI.HappinessWords.Love}    [hlhi:love]
				  {$UI.HappinessWords.Like}    [hlhi:like]
				  {$UI.HappinessWords.Dislike} [hlhi:disl]
				  {$UI.HappinessWords.Hate}    [hlhi:hate]
				'''
		}

		RightArrow: {
			Label: →
			Tooltip:
				'''
				{$Label}

				各セリフの前に→が付きます
				'''
		}

		GreaterThan: {
