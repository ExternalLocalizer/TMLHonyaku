UI: {
	HappinessWords: {
		Love: 愛する
		Like: 好き
		Dislike: 嫌い
		Hate: 増悪
		None: なし
		RetreivalError: 好みを取得できませんでした
		PrincessLovesAll: "{$NPCName.Princess}は全てのタウンNPCを愛している"
	}
}

# Simple, generic happiness dialogue for the Princess.
TownNPCMood.HateLonely: 私は孤独が嫌いです。
