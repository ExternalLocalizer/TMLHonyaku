Configs: {
	ShareInfo: {
		minutes: {
			Tooltip: 指定した分数の間隔で自動的にマップデータを共有します
			Label: 自動共有間隔 (分)
		}

		allowed: {
			Tooltip: ""
			Label: 自動共有を有効化
		}

		Tooltip: ""
	}

	Config: {
		requestcooldown: {
			Tooltip: ユーザーがマップデータを再度リクエストできるまでに必要な時間
			Label: リクエストクールダウン (分)
		}

		sharecooldown: {
			Tooltip: ユーザーがマップデータを再度共有できるまでに必要な時間
			Label: 共有クールダウン (分)
		}

		liveshareA: {
			Tooltip: 新たに探索したエリアを自動的に共有します（問題が発生する場合は無効にしてください）
			Label: ライブマップ共有 (開発中)
		}

		seconds: {
			Tooltip: ""
			Label: 共有クールダウン (秒)
		}

		serverwaittime: {
			Tooltip: サーバーが次のプレイヤーにマップ情報を転送するまでに必要な時間です。プレイヤー数が多く、サーバーから切断されやすくなった場合、この値を増やしてください
			Label: プレイヤー間の共有遅延 (ミリ秒)
		}

		waittime: {
			Tooltip: マップデータ共有中に接続エラーや不正なエラーが発生する場合、この値を増やしてください
			Label: 全体マップ待機時間 (ミリ秒)
		}

		allowsending: {
			Tooltip: ""
			Label: プレイヤーが自由にマップデータを送信できるようにします
		}

		allowdownloads: {
			Tooltip: ""
			Label: プレイヤーが自由にマップデータをダウンロードできるようにします
		}

		shareInfo: {
			Tooltip: ""
			Label: マップデータの自動共有
		}

		DisplayName: 設定
	}

	ClientConfig: {
		hidenotif: {
			Tooltip: ""
			Label: 送信とリクエストの通知をチャットから非表示にします
		}

		DisplayName: クライアント設定
	}
}

Keybinds: {
	"Mark first position": {
		DisplayName: 最初の位置をマーク
	}

	"Mark second position": {
		DisplayName: 2番目の位置をマーク
	}

	"Clear marked positions": {
		DisplayName: マークした位置をクリア
	}

	"Request map data": {
		DisplayName: マップデータをリクエスト
	}

	"Send map data": {
		DisplayName: マップデータを送信
	}
}
