Configs: {
	Config: {
		DisplayName: 設定

		RecipesForVanillaItems: {
			Label: バニラのアイテムのレシピを追加
			Tooltip:
				'''
				オンにするとバニラのアイテムを素材として使う、
				バニラのアイテムのレシピを追加します
				'''
		}

		VanillaEnemiesDropVanillaItems: {
			Label: バニラの敵がバニラのアイテムをドロップする
			Tooltip:
				'''
				オンにするとバニラの敵がドロップする、
				バニラのアイテムの種類が増えます
				'''
		}

		VanillaCratesDropVanillaItems: {
			Label: バニラの箱にバニラのアイテムを追加
			Tooltip:
				'''
				オンにするとバニラの箱から入手できる、
				バニラのアイテムの種類が増えます
				'''
		}

		NewWorldGeneration: {
			Label: ワールドに追加の石像を生成する
			Tooltip:
				'''
				オンにするとワールドにこのModで追加される、
				石像が生成されるようになります
				'''
		}

		NewModifiers: {
			Label: 接頭辞を追加
			Tooltip: オンにすると接頭辞が追加されます
		}

		VanillaBuffChanges: {
			Label: バニラのバフを変更
			Tooltip:
				'''
				オンにするとバニラの流血と凍えを敵に与えることができるようになります
				これがオフだと、凍え関連のアイテムが機能しなくなりますが、
				ゲームの進行には支障をきたしません
				'''
		}

		MeleeSpeedModifiersAffectRangedAndMagic: {
			Label: 近接攻撃速度の接頭辞が遠距離と魔法にも有効
			Tooltip:
				'''
				オンにするとアクセサリに付く荒々しい・向こう見ずの・恐れ知らずの・乱暴者の接頭辞が、
				近接武器だけでなく、遠距離武器と魔法武器にも影響するようになります
				ツールチップには反映されません！
				'''
		}
	}
}

