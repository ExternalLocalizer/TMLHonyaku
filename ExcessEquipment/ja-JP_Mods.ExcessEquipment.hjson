		Tooltip: ""
		DisplayName: 御影石の胸当て
	}

	LuckySkates: {
		Tooltip:
			'''
			落下ダメージを無効化
			氷系ブロックで滑らなくなる
			薄氷の上に落ちても割れない
			'''
		DisplayName: 幸運のスケート靴
	}

	IcyObsidianHorseshoe: {
		Tooltip:
			'''
			落下ダメージを無効化
			燃えるブロックのダメージを無効化
			氷系ブロックで滑らなくなる
			薄氷の上に落ちても割れない
			'''
		DisplayName: 氷の黒曜石の蹄鉄
	}

	IceSkull: {
		Tooltip:
			'''
			燃えるブロックのダメージを無効化
			氷系ブロックで滑らなくなる
			薄氷の上に落ちても割れない
			'''
		DisplayName: 氷のドクロ
	}

	BandOfVitality: {
		Tooltip:
			'''
			ライフが徐々に自然回復する
			最大ライフが20増加
			'''
		DisplayName: 生命の腕輪
	}

	LavaRose: {
		Tooltip:
			'''
			溶岩のダメージを7秒間無効化
			溶岩のダメージを軽減
			'''
		DisplayName: 溶岩のバラ
	}

	LavaDivingGear: {
		Tooltip:
			'''
			液体内で無限にジャンプでき、息が長く続く
			とても弱い光を放ち、水と蜂蜜内だとより強い光を放つ
			溶岩のダメージを7秒間無効化
			溶岩のダメージを軽減
			燃えるブロックのダメージを無効化
			'''
		DisplayName: 溶岩の潜水具
	}

	GruesomeVambrace: {
		Tooltip:
			'''
			敵に狙われやすくなる
			触れた敵にヘルファイアを与える
			'''
		DisplayName: 恐ろしい腕当て
	}

	LodestoneHeart: {
		Tooltip:
			'''
			最大ライフが20増加
			ハートの取得範囲が広がる
			'''
		DisplayName: 磁石のハート
	}

	LifeMagnet: {
		Tooltip: ハートの取得範囲が広がる
		DisplayName: 生命の磁石
	}

	AgilityGear: {
		Tooltip:
			'''
			ダッシュが可能
			横方向入力2回で高速ステップ
			攻撃を回避することがある
			'''
		DisplayName: 迅速の装具
	}

	DefenderNecklace: {
		Tooltip:
			'''
			ミニオンスロットとセントリースロットを1つ追加
			ミニオンとセントリーのダメージが5%増加
			'''
		DisplayName: ディフェンダーのネックレス
	}

	BonusLoader: {
		DisplayName: 魔法のローダー
		Tooltip:
			'''
			遠距離攻撃速度が12%上昇
			20%の確率で弾薬を消費しない
			'''
	}

	DruidBracer: {
		DisplayName: 魔法使いの籠手
		Tooltip:
			'''
			魔法攻撃速度が12%上昇
			マナ消費量が8%減少
			マナがなくなるとマナポーションを自動的に使用する
			'''
	}

	BloodCharm: {
		DisplayName: 血のお守り
		Tooltip: 魔法攻撃で敵に流血を与える
	}

	BloodmageCuffs: {
		DisplayName: 血の魔法使いのカフス
		Tooltip:
			'''
			最大マナが20増加
			ダメージを受けると被ダメージに応じてマナが回復する
			魔法攻撃で敵に流血を与える
			'''
	}

	CheatDeathRay: {
		DisplayName: チートデスレイ
		Tooltip: ""
	}

	EndlessBaitBag: {
		DisplayName: 無限の餌袋
		Tooltip: ""
	}

	FrostwalkingBoots: {
		DisplayName: 氷歩きのブーツ
		Tooltip:
			'''
			水・蜂蜜・シマーの上を歩行できる
			氷系ブロックで滑らなくなる
			薄氷の上に落ちても割れない
			'''
	}

	MagicDivingGear: {
		DisplayName: 魔法の潜水具
		Tooltip:
			'''
			水・溶岩・蜂蜜・シマーの上を歩行できる
			液体内で無限にジャンプでき、息が長く続く
			とても弱い光を放ち、水と蜂蜜内だとより強い光を放つ
			溶岩のダメージを7秒間無効化
			溶岩のダメージを軽減
			燃えるブロックのダメージを無効化し、シマーに入ってもシマー中を受けない
			'''
	}

	TechnoBracer: {
		DisplayName: テクノブレイサー
		Tooltip:
			'''
			魔法攻撃速度が12%上昇
			マナ消費量が8%減少
			マナがなくなるとマナポーションを自動的に使用する
			マナスターの取得範囲が広がる
			'''
	}

	PowerLoader: {
		DisplayName: 極めて違法な銃のパーツ
		Tooltip:
			'''
			遠距離武器のノックバックが増加
			遠距離ダメージが12%増加し、遠距離攻撃速度が12%上昇
			20%の確率で弾薬を消費しない
			「あらゆる国で禁止されている」
			'''
	}
}

