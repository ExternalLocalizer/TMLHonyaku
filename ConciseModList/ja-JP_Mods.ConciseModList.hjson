Configs: {
	ConciseModConfig: {
		TranslationModIcon: {
			Tooltip: このModが他のModを翻訳することを示すアイコンが表示されます
			Label: 翻訳Modアイコン
		}

		ModReferenceIcon: {
			Tooltip: このModに依存関係があることを示すアイコンが表示されます
			Label: Mod参照アイコン
		}

		ObsidianSkull: {
			Tooltip: このModのプレビュービルドがないことを示すドクロが表示されます
			Label: 黒曜石のドクロ
		}

		UpdateDot: {
			Tooltip: ModがアップデートされたときにModアイコンに表示されるドットが表示されます
			Label: アップデート・ドット
		}

		ModpackIcon: {
			Tooltip: ModパックのMODであれば、ModアイコンにModパックのアイコンが表示されます
			Label: Modパックアイコン
		}

		SteamIcon: {
			Tooltip: SteamワークショップのModの場合、ModアイコンにSteamアイコンが表示されます
			Label: Steam アイコン
		}

		ConfigButton: {
			Tooltip: これがオフでも、Modアイコンを右クリックして設定を開くことができます
			Label: 設定ボタン
		}

		EnabledModsFirst: {
			Tooltip: ""
			Label: 有効なModをリストの上側に表示
		}

		DisplayName: 設定
	}
}

ExportEnabledMods:
	'''
	左クリックで有効なModのリストをテキストとしてエクスポート
	右クリックでSteamワークショップのリンクなしでエクスポート
	'''

Dependencies: "[c/CC88AA:ミドルクリック]で依存関係を有効にする"

Delete: "[c/CC88AA:右クリック]でModを削除する"

ModsMoreInfo: "[c/CC88AA:Ctrlキー]で詳細を見る"

ModsOpenConfig: "[c/CC88AA:右クリック]で設定を開く"

