			Tooltip: ""
		}
	}

	WearableBackpacksClientConfig: {
		DisplayName: Wearable Backpacks 設定

		Headers: {
			InventoryAppearance: インベントリの見た目
			Pickup: 拾得の動作
			Inventory: インベントリ
			BackpackPosition: バックパックの位置
		}

		BackpackColors: {
			Label: バックパックのカラー
			Tooltip: 装備可能なバックパックのパネルとスロットのカラー
		}

		DogBackpackColors: {
			Label: ドッグのバックパックのカラー
			Tooltip: ドッグのバックパックのパネルとスロットのカラー
		}

		ResetBagColorsButtons: {
			Label: " "
			Tooltip: バックパックのパネルとスロットのカラーを通常のインベントリのカラーにリセットする
		}

		BackpackUIScale: {
			Label: バックパックのUIのスケール
			Tooltip: バックパックとドッグのバックパックのウィンドウサイズ
		}

		PickupMode: {
			Label: 拾得モード
			Tooltip:
				'''
				あふれた分のみに設定するとインベントリが一杯のときのみバックパックに入れ、
				バックパックを優先だと常にバックパックに入れます
				自動的に入れないは拾ったアイテムをインベントリに入れます
				'''
		}

		SortBackpacksWithInventory: {
			Label: インベントリと同時にバックパックをソート
			Tooltip:
				'''
				オンにすると、インベントリをソートすると、
				バッグパックとドッグのバックパックもソートするようになります
				'''
		}

		LockDogBagDuringBosses: {
			Label: ボス戦中にドッグのバッグをロック
			Tooltip:
				'''
				オンにするとボス戦中、ドッグのバッグパックを右クリックしても、
				バッグパックが開かなくなります
				ドッグのバックパックを開くは機能します
				'''
		}

		LockDogBagNearbyBossesOnly: {
			Label: ボスが近くにいるときのみロック
			Tooltip:
				'''
				これとボス戦中にドッグのバッグをロックがオンだと、
				ボスが近くにいるときのみドッグの右クリックが無効になります
				これがオフだと他のプレイヤーが戦闘中でも、ボス戦中は常にロックされます
				'''
		}

		PlaceDogWindowBesideBackpack: {
			Label: ドッグのバックパックのウィンドウをバックパックの横に配置
			Tooltip:
				'''
				ドッグのバックパックのウィンドウを開くたびに、
				バックパックのウィンドウの横にスナップされます
				'''
		}

		ResetBackpackWindowPositions: {
			Label: バックパックの位置をリセット
			Tooltip:
				'''
				クリックするとバックパックとドッグのバックパックのウィンドウを、
				インベントリの右側に移動します
				'''
		}
	}

	BagColorSettings: {
		Panel: {
			Label: パネルの色
			Tooltip: バックパックウィンドウのカラー
		}

		Slots: {
			Label: スロットのカラー
			Tooltip: アイテムスロットのカラー
		}

		Tooltip: ""
	}

	BackpackPickupMode: {
		Tooltip: ""

		OverflowOnly: {
			Label: あふれた分のみ
			Tooltip: ""
		}

		BackpackFirst: {
			Label: バックパックを優先
			Tooltip: ""
		}

		Disabled: {
			Label: 無効
			Tooltip: ""
		}
	}
}

