Configs: {
	ReworkConfig: {
		DisplayName: リワーク設定

		plantera: {
			Label: "[i/s1:2109] プランテラリワーク"
			Tooltip:
				'''
				プランテラのリワークを有効にします。他のModと競合する場合はオフにしてください
				Eternity ModeおよびRevengeance Modeモードと互換性があり、これらがオンの場合はオフにする必要はありません
				（注：攻撃パターンは上書きではなく、組み合わせられます！）
				'''
		}

		golem: {
			Label: "[i/s1:2110] ゴーレムリワーク"
			Tooltip:
				'''
				ゴーレムのリワークを有効にします。他のModと競合する場合はオフにしてください
				Eternity ModeおよびRevengeance Modeモードと互換性があり、これらがオンの場合はオフにする必要はありません
				（注：攻撃パターンは上書きではなく、組み合わせられます！）
				'''
		}

		temple: {
			Label: "[i/s1:1292] ゴーレムチャンバー変更"
			Tooltip: ゴーレムチャンバーをバニラと少し異なる形で生成します
		}

		lihzahrd: {
			Label: "[i/s1:1154] リザードAIリワーク（リロード必須！）"
			Tooltip: リザードのAIリワークを有効にします
		}

		skipPlantDesperation: {
			Label: "[i/s1:2109] プランテラの絶望フェーズスキップ（撃破後）"
			Tooltip: プランテラを少なくとも1回撃破した場合、最終フェーズをスキップします
		}

		masterDropsAreNonExclusive: {
			Label: マスターモード限定武器をエキスパートでもドロップ
			Tooltip:
				'''
				マスターモード専用の武器がエキスパートモードでもドロップします
				マスターモードをプレイしたくない場合や、他のModでマスターモードのドロップに問題が生じる場合に推奨します
				（例：Eternity Modeがmasochist modeになる、infernumがマスターモードで使用できない）
				'''
		}

		laser: {
			Label: "[i/s1:1266][i/s1:1295][i/s1:1444][i/s1:2749] 旧レーザーVFX変更（リロード必須！）"
			Tooltip: 古いレーザー発射物の視覚効果を新しい見た目に変更します
		}

		bullet: {
			Label: "[i/s1:1179][i/s1:1350] クロロファイト弾およびナノバレットのリバランス"
			Tooltip:
				'''
				ナノバレットとクロロファイト弾の機能を入れ替え、強化します
				クロロファイト弾は壁で跳ね返り、ターゲットを貫通します
				ナノバレットはマウスカーソルに最も近いターゲットにホーミングし、必要に応じて地形を無視します
				'''
		}

		golemEye: {
			Label: "[i/s1:1248] ゴーレムの目リワーク"
			Tooltip: ゴーレムの目を装備すると、5回攻撃するごとに必ずクリティカルヒットになります
		}

		GL: {
			Label: "[i/s1:758] グレネードランチャーリワーク"
			Tooltip: グレネードランチャーに新しい攻撃アニメーションと手動起爆機能を追加します
		}

		RL: {
			Label: "[i/s1:759] ロケットランチャーリワーク"
			Tooltip: ロケットランチャーに新しい攻撃アニメーションとターゲットロックオン機能を追加します
		}

		nettleBurst: {
			Label: "[i/s1:788] ネトルバーストリワーク"
			Tooltip: ネトルバーストに、敵に付着して花を咲かせる種を発射する代替射撃を追加します。花が付いた敵を攻撃すると小さな爆発を起こします
		}

		possessedHatchet: {
			Label: "[i/s1:1122] 狂気の手斧リワーク"
			Tooltip: 狂気の手斧の追跡性能を強化し、新しいスライス効果を追加します
		}

		leafClaymore: {
			Label: "[i/s1:1226] クロロファイトの大剣リワーク"
			Tooltip: クロロファイトの大剣に新しい攻撃アニメーションと右クリックチャージ攻撃を追加します
		}

		leafSaber: {
			Label: "[i/s1:1227] クロロファイトセーバーリワーク"
			Tooltip: クロロファイトセーバーに新しい攻撃アニメーションと胞子生成方法の変更を追加します
		}

		leafPartisan: {
			Label: "[i/s1:1228] クロロファイトの貫通槍リワーク"
			Tooltip: クロロファイトの貫通槍に新しい攻撃アニメーションを追加します
		}

		stynger: {
			Label: "[i/s1:1258] スティンガーリワーク"
			Tooltip: スティンガーに新しい攻撃アニメーション、リロード風のギミック、代替射撃モードを追加します
		}

		heatRay: {
			Label: "[i/s1:1295] 熱線銃リワーク"
			Tooltip: 熱線銃がオーバーヒート可能になり、与ダメージが増加し、ターゲットを燃やします
		}

		deathSickle: {
			Label: "[i/s1:1327] 死神の鎌リワーク"
			Tooltip: 死神の鎌に新しい攻撃アニメーションを追加、3回目の攻撃で鎌を前方に投げます
		}

		pulseBow: {
			Label: "[i/s1:2223] パルスボウリワーク"
			Tooltip:
				'''
				パルスボルトの挙動をターゲットに向かって跳ねるように変更し、武器にチャージ機能を追加します
				シュルーマイト装備との相性が向上し、攻撃中でもステルスを蓄積できます
				ただし、弓自体は透明にならず、ユーザーはチャージの進行状況を確認できます
				'''
		}

		LMG: {
			Label: "[i/s1:2795] レーザーマシンガンリワーク"
			Tooltip: レーザーマシンガンは発射速度が上がりきるまで弾を発射しなくなりますが、ユーザーにシールドを付与します
		}

		chainsaw: {
			Label: "[i/s1:3098] ブッチャーのチェーンソーリワーク"
			Tooltip:
				'''
				ブッチャーのチェーンソーに回転数を上げる仕組みを追加し、1秒あたりのヒット数が大幅に増加します
				この武器はターゲットにヒットしている間、ユーザーを一時的に空中に留めます
				'''
		}

		shinyStone: {
			Label: "[i/s1:3337] 輝く石リワーク"
			Tooltip: 輝く石は失ったライフに基づいて一時的な防御力を付与し、Thoriumが有効な場合、光輝ステータスを増加します
		}

		maceWhip: {
			Label: "[i/s1:4679] モーニングスターリワーク"
			Tooltip: モーニングスターに新しい攻撃アニメーションを追加、2回目の攻撃は上方向に振り、3回目の攻撃はフレイル部分を回転させます
		}

		scytheWhip: {
			Label: "[i/s1:4680] ダークハーベストリワーク"
			Tooltip: ダークハーベストに新しい攻撃アニメーションを追加、2回目の攻撃は回転、3回目の攻撃は鎌を前方に投げて敵を切り裂きます
		}
	}
}
