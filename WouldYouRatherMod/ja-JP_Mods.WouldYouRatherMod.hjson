# This file will automatically update with entries for new content after a build and reload.


Effect: {
	IncreaseMaxHealth: 最大ライフが増加
	IncreasedMaxMana: 最大マナが増加
	RunFaster: 移動速度が15%上昇
	IncreasedPickupRange: アイテムの取得範囲が大きく広がる
	PermanentRandomBuff: ランダムなバフを永続で得る
	DoubleCoinDrops: 敵がドロップするコインが2倍になる
	WalkOnWater: 液体の上を歩行でき、水中で半魚人に変身する
	CheaperShops: 全タウンNPCの販売価格が50%安くなる
	Dash: ダッシュが可能になる
	NoFallDamageExplosion: 落下ダメージを受けず、着地時に周囲へダメージを与える
	SummonBeesOnHit: 敵を攻撃すると蜂を召喚する
	DoubleMiningSpeed: 採掘速度が2倍になる
	PermanentFoodBuffs: 食事バフが永続する
	ScreenUpsideDown: 画面が上下反転する
	RandomFarts: 時々おならをする
	PoopBomb: 時々爆弾を排出する
	RandomTeleport: ポーション酔い中、ランダムでテレポートする
	DropCoinsWalking: 移動中、コインをドロップする
	WaterKills: 液体に触れると即死する
	SpawnBats: 時々、周囲にコウモリが出現する
	DoubleKnockback: 被ダメージとノックバックが増加する
	DizzyJumps: ジャンプすると画面が揺れる
	SneezeDropWeapon: くしゃみで手に持っているアイテムを落とすことがある
	NoGrapple: フックを使用できなくなる
	SlowerAtNight: 夜間、移動速度が低下する
	DoubleManaCost: マナ消費量が2倍になる
	AllergicToFlowers: 花粉でくしゃみが止まらない！
	FallThroughUnsupportedBlocks: 支えのないブロックをすり抜けて落下する
	SinkWhenStill: 立ち止まっていると地面に沈む
	HideHealthUI: 体力・マナ・バフのUIが表示されなくなる
	CrumblingFloor: 一度だけ自分の下のブロックが破壊される！
	DamageOnEBlocks: 名前に「e」を含むブロックの上に立つとダメージを受ける
	DoubleFishingPower: フィッシング・パワーが2倍になる
	DoubleOreMined: 採掘した鉱石を2倍入手できる
	UnlimitedAmmo: 弾薬スロットの弾を消費しない
	PeriodicInvulnerability: 10秒ごとに1秒間無敵になる
	GameCloseOnDeath: 死亡するとゲームが終了する
	DirtEncasement: たまに土の中に閉じ込められる！
	MentalCurse: 時々よくわからない呪いにかかる！
	WaterBreathingOnly: 水と蜂蜜内でしか呼吸できなくなる
	DoubleFlightTime: 飛行時間が2倍になる
	AutoBuffPotion: ライフ回復アイテムを使用すると、所持しているバフポーションの効果が全て発動する（消費しない）
	IncreasedWeaponSpeed: 武器の使用速度が50%上昇
	DeathDenial: 10分ごとに一度だけ死を免れる
	DamageBoost: ダメージが50%増加
	LoseAllDefense: 防御力が4減少
	EveryBoulderBounces: 全ての大岩が跳ね返るようになる
	BoulderRain: 時々頭上から大岩が落ちてくる
	OldDungeonGuardian: 不死の古のダンジョンガーディアンがあなたを追ってくる
	ReducePotionSicknessCD: ライフ回復アイテムの再使用時間が5%短縮される
	IncreasePotionSicknessCD: ライフ回復アイテムの再使用時間が5%延長される
	IncreaseDefensePercent: 防御力が4増加
	DecreasePotionHealing: ライフ回復アイテムの回復量が5%減少する
	IncreasePotionHealing: ライフ回復アイテムの回復量が5%増加する
	DisableAccessory: アクセサリーの効果が無効になる
	StoneOnCritterKill: 小動物を倒した時、自分自身が石化する
	NightlyBossSpawn: 撃破済みのボスが毎晩ランダムで近くに出現する
	RandomItemReward: ランダムなアイテムを入手する
	ReduceNPCLife: 敵の最大ライフが減少する
	IncreaseNPCLife: 敵の最大ライフが増加する
	CloneOnKill: 敵を倒すとその敵のクローンが出現する
	DoubleRecipeCost: 作成に必要な素材数が2倍になる
	IncreasedItemScale: アイテムのサイズが大きくなる
}

UI: {
	WUR: 運命の選択
	BUT: されど...
	Confirm: 決定！
	Current:
		'''
		現在の選択
		ポジティブ: {0}
		ネガティブ: {1}
		'''
	ChaosCurrent:
		'''
		現在の選択
		{0}
		{1}
		'''
	ShowEffects: 現在発動中の選択を確認
}

Configs: {
	WouldYouRatherConfig: {
		ChoiceIntervalMinutes: {
			Tooltip: 選択肢が表示される間隔
			Label: 選択肢の出現間隔（分）
		}

		DisplayName: Would You Rather 設定

		GameMode: {
			Label: ゲームモード
			Tooltip:
				'''
				デフォルト = 一定間隔で選択肢が自動的に出現
				アドベンチャー = トレジャーバッグから特別なアイテムが落ち、そのアイテムで選択肢を発動します
				'''
		}

		ChaosMode: {
			Label: カオスモード
			Tooltip: 
				'''
				最大100の選択が同時に作用し、重なり合う混沌の時間を作り出します
				それぞれは定められた時間、または永遠に続きます
				'''
		}

		MaxStackedEffects: {
			Label: 同時選択数
			Tooltip: 一度に作用できる選択の上限数
		}

		ChaosEffectDuration: {
			Label: 選択の持続時間（分）
			Tooltip: 各選択の効果が続く時間（0で無限）
		}

		BlacklistedPositiveChoice: {
			Label: 除外ポジティブ効果
			Tooltip: ここで指定したポジティブ選択肢は出現しなくなります
		}

		BlacklistedNegativeChoice: {
			Label: 除外ネガティブ効果
			Tooltip: ここで指定したネガティブ選択肢は出現しなくなります
		}

		BaseRandomEffectChance: {
			Label: ランダム発生の基本確率
			Tooltip:
				'''
				ランダムに発動する選択肢の基本間隔（分）
				たとえば基本値が1の場合、毎ティックごとに1/3600の確率で効果が発動します
				'''
		}
	}

	ModeType: {
		Tooltip: ""
		Default.Label: デフォルト
		Adventure.Label: アドベンチャー
	}

	BlacklistedNegativeEffectEntry: {
		Tooltip: ""

		EffectIndex: {
			Label: 選択
			Tooltip: ""
		}
	}

	BlacklistedPositiveEffectEntry: {
		EffectIndex: {
			Tooltip: ""
			Label: 選択
		}

		Tooltip: ""
	}
}

Items: {
	FatefulToken: {
		DisplayName: 運命の印 
		Tooltip: これを使うことで、運命の問いが発生する
	}

	ChaoticRelic: {
		DisplayName: 混沌のオーブ
		Tooltip: ネガティブ効果を別のランダムなものに変化させる
	}

	PurgingRelic: {
		DisplayName: 消滅の遺物
		Tooltip: ランダムな選択を1つ削除する
	}
}

NPCs.OldDungeonGuardian.DisplayName: 古のダンジョンガーディアン

